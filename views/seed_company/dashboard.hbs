  const myChart = new Chart(ctx, {
      type: 'bar',
      data: {
          labels: ['Jan', 'Feb', 'Mar', 'May', 'Jun', 'July'],
          datasets: [{
               
              label: 'Monthly',
              data: [12, 19, 3, 5, 2, 3],
