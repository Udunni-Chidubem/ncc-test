{{#if isVerified }}
<div class="row">
  <div class="col-12">
    <div class="card shadow card_home card-width pl-0 mb-2 ">
      <div class="card-body">
        <div class="row">
          <div class="col-12">
            <h4>Welcome, {{ company.name_of_company }}</h4>
          </div>
          <div class="row">
            <div class="col-6 profile_sub">
              <p>Kindly set up your profile to continue using NIGSIMS</p>
            </div>
            <div class="col-6">
              <div class="  float-end">
                <a href="/seed-company/update-profile" class="btn button_update mb-1 shadow-lg">Update Profile</a>
              </div>
            </div>
          </div>


          {{/if}}

          {{#unless isVerified}}

          <div class="row">
            <div class="col-12">
              <div class="card shadow card_home card _seed pl-0 mb-2 ">
                <div class="card-body">
                  <div class="row row-cols-2 row-cols-lg-3 g-2 g-lg-2">
                    <div class="col-12 co_12">
                      <div class="p-3 border text-center border-0 border-end ">
                        <h5 class="c_d_s2 c__h">Total Sales</h5>

                        <h1 class="c_d_s2_sales s_1 "> {{ total }} </h1>
                        <a href="/seed-company/orders" class="c_d_s2_link">
                          <h5>See Details</h5>
                        </a>
                      </div>
                    </div>
                    <div class="col-12 co_12">
                      <div class="p-3 border text-center  border-0 border-end  ">
                        <h5 class="c_d_s2 c__h">Fulfilled Orders</h5>

                        <h1 class="c_d_s2_full "> {{fulfilled}} </h1>
                        <a href="/seed-company/orders" class="c_d_s2_link">
                          <h5>See Details</h5>
                        </a>
                      </div>
                    </div>
                    <div class="col-12 co_12">
                      <div class="p-3 border text-center border-0 border-end  ">
                        <h5 class="c_d_s2 c__h">Unfufilled Orders</h5>

                        <h1 class=" c_d_s2_unfull"> {{unfulfilled}} </h1>
                        <a href="/seed-company/orders" class="c_d_s2_link">
                          <h5>See Details</h5>
                        </a>
                      </div>
                    </div>
                  </div>

                </div>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-8 s_chart">
              <div class="card shadow card_home  card_seed pl-0 mb-2 ">
                <div class="card-body">
                  <div class="row graph">
                    <div class="col-12">
                      <canvas id="myChart" class="canvas_stuff" width="400" height="160"
                        style="background:#fff;"></canvas>
                    </div>

                  </div>
                </div>
              </div>
            </div>

            <div class="col-4 col__4">
              <div class="card shadow card_home card_seed card-wallet pl-0 mb-2 ">
                <div class="card-body">
                  <div class="row">
                    <div class="col-12">
                      <h4 class="mb-5  c_d_s2 float-start">Wallet</h4>
                      <a href="./wallet" class="float-end">View Wallet</a>
                    </div>
                    <div>
                      {{#balance}}
                      <div class="col-12 mb-4 text-center  c_d_s2_full profile_sub">
                        <p> &#8358; {{number this.amount}}</p>
                      </div>
                      <div class="dashboard_balance">
                        <p><i class="fa fa-circle" style="color: #47BA5D"> </i> &nbsp; Cleared Balance: &#8358;
                          {{number this.amount}}
                        </p>
                        <p><i class="fa fa-circle" style="color: #FB8200"> </i> &nbsp; Uncleared Balance: &#8358; 0
                        </p>
                      </div>
                      {{/balance}}


                      <p></p>
                      <div class="col-12">
                        <button type="button " class="btn btn-theme" style="width: 100% !important;"
                          onclick="window.location.href='./wallet'">Withdraw</button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>


          <div class="row">
            <div class="col-12">
              <div class="card shadow card_home card_seed pl-0 mb-2 ">
                <div class="card-body">
                  <div class="row row-cols-2 row-cols-lg-3 g-2 g-lg-2">
                    <div class="col-12 co_12">
                      <div class="p-3 border text-center border-0 border-end ">
                        <h5 class="c_d_s2 c__h">Total Products</h5>
                        {{#productCount}}
                        <h1 class="c_d_s2_sales s_1 ">{{this}}</h1>
                        {{/productCount}}
                        <a href="/seed-company/products" class="c_d_s2_link">
                          <h5>See Details</h5>
                        </a>
                      </div>
                    </div>
                    <div class="col-12 co_12">
                      <div class="p-3 border text-center  border-0 border-end  ">
                        <h5 class="c_d_s2 c__h">Active</h5>
                        <h1 class="c_d_s2_full ">0</h1>
                        <a href="/seed-company/products" class="c_d_s2_link">
                          <h5>See Details</h5>
                        </a>
                      </div>
                    </div>
                    <div class="col-12 co_12">
                      <div class="p-3 border text-center border-0 border-end  ">
                        <h5 class="c_d_s2 c__h">Sold out</h5>
                        <h1 class=" c_d_s2_unfull">0</h1>
                        <a href="/seed-company/products" class="c_d_s2_link">
                          <h5>See Details</h5>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>



          {{/unless}}


          <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.1/chart.min.js"
            integrity="sha512-QSkVNOCYLtj73J4hbmVoOV6KVZuMluZlioC+trLpewV8qMjsWqlIQvkn1KGX2StWvPMdWGBqim1xlC8krl1EKQ=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
          <script>

            let baseUrl = window.location.origin
            $(document).ready(function () {

              label_value = gechtMonth()
              let dt = []
              const ctx = document.getElementById('myChart').getContext('2d');
              const myChart = new Chart(ctx, {
                type: 'bar',
                data: {
                  labels: label_value,
                  //labels: label_value
                  datasets: [{

                    label: 'Monthly',
                    data: [1, 2, 3, 4, 5, 6],
                    backgroundColor: [
                      '#47BA5D',
                      '#47BA5D',
                      '#47BA5D',
                      '#47BA5D',
                      '#47BA5D',
                      '#47BA5D',
                      '#47BA5D',
                      '#47BA5D',
                      '#47BA5D',
                      '#47BA5D',
                      '#47BA5D',
                      '#47BA5D'
                    ],
                    borderColor: [
                      'white',
                      'white',
                      'white',
                      'white',
                      'white',
                      'white',
                      'white',
                      'white',
                      'white',
                      'white',
                      'white',
                      'white'
                    ],
                    borderWidth: 1
                  }]
                },
                options: {
                  scales: {
                    y: {
                      beginAtZero: true
                    }
                  }
                }
              });

              function getMonth() {
                let months = []
                let year = new Date().getFullYear()
                let month = new Date().getMonth()
                month = month + 1
                for (var i = 0; i < month; i++) {
                  new_val = i + 1
                  months.push(year + '-' + '0' + new_val)
                }
                console.log(months)
                return months

              }

              function gechtMonth() {
                let month_name = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']

                let months = []
                let year = new Date().getFullYear()
                let month = new Date().getMonth()
                month = month + 1
                for (var i = 0; i < month; i++) {
                  new_val = i + 1
                  months.push(year + '-' + month_name[new_val])
                }
                console.log(months)
                return months

              }

              function chtamt() {
                let url = baseUrl + '/seed-company/getchartamount'

                fetch(url, {
                  method: 'GET'
                }).then(r => r.json())
                  .then(response => {
                    if (response.message) {
                      let chartamount = response.message
                      console.log(chartamount)
                      let month = []
                      let amount = []
                      month = getMonth()
                      let subamt = ''
                      month.forEach((value, index) => {
                        subamt = 0
                        chartamount.forEach((value2, index) => {
                          let _date = new Date(value2.updated_at)
                          let monthval = new Date(value)
                          console.log(monthval.getMonth())
                          if (_date.getMonth() == monthval.getMonth()) {
                            subamt += value2.amount
                            console.log(subamt)
                          }
                        })
                        amount.push(subamt)
                        console.log(amount)

                      })
                      myChart.data.datasets[0].data = amount;
                      myChart.update();
                      //console.log(myChart.data.datasets[0].data)
                    }
                  })
                  .catch(error => console.log(error))

              }

              setInterval(chtamt, 1000)
            })
          </script>