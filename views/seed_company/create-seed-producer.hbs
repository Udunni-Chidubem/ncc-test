<div class="container py-5">
    <div class="card card_prod card_home">
        <div class="card-body">
            <form method="POST" action="" id="form-producer">
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label for="fullName">Full Name <span class="required-feilds">*</span></label>
                        <input type="text" class="form-control" name="fullName" id="fullName"
                            placeholder="Enter Full Name" required>
                    </div>
                    <div class="form-group col-md-6">
                        <label for="phone">Phone Number <span class="required-feilds">*</span></label>
                        <input type="tel" class="form-control" name="phone" id="phone" placeholder="Enter Phone Number "
                            required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label for="certified">Certified Seed Producer <span class="required-feilds">*</span></label>
                        <select name="certified" id="certified" class="form-select border-bottom ">
                            <option value="">Select an Option</option>
                            <option value="Yes">YES</option>
                            <option value="No">NO</option>
                        </select>
                    </div>
                    <div class="form-group col-md-4">
                        <label for="state_id" class="input_form">Seed Producer State <span class="profile_sub">*</span></label>
                        <div class="input-group">
                            <select name="state_id" class="form-select  border-bottom states " required id="state_id">
                                <option value="">Select State </option>
                                {{#each states}}
                                <option value="{{this.id}}">{{this.name}}</option>
                                {{/each}}
                            </select>
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label for="lg_id" class="input_form">Seed Producer LGA <span class="profile_sub">*</span></label>
                            <div class="input-group">
                                <select required class="form-select border-bottom" id="lg_id"
                                    name="lg_id">
                                    <option value=""></option>
                                </select>
                            </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label for="nameOfSeed">Name of Seed Produced <span class="required-feilds">*</span></label>
                        <input type="text" class="form-control" name="nameOfSeed" id="nameOfSeed" placeholder="Enter name of Seed">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="varietyOfSeed" class="input_form">Variety of seed produced <span class="profile_sub">*</span></label>
                        <input type="text" class="form-control" name="varietyOfSeed" id="varietyOfSeed" placeholder="Enter Variety of Seed">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="volumeOfSeed" class="input_form">Volume of seed produced <span class="profile_sub">*</span></label>
                        <input type="number" class="form-control" name="volumeOfSeed" id="volumeOfSeed" placeholder="e.g: 100">
                    </div>
                </div>
        </div>
        <hr>

        <div class="float-end">
            <div class="float-end m-2 mb-3">
                <button type="submit" class="btn btn-theme float-right submitBtn">Submit</button>
            </div>
            </form>
        </div>
    </div>

    <script type="text/javascript">
        $(document).ready(function () {

            let state = $('#state_id').data('state_id')

            const getDefaultLgas = (state_id) => {
                let url = window.location.origin + '/api/base/lgas/' + state_id
                fetch(url).then(r => r.json())
                    .then(r => {
                        let selected, Options
                        r.forEach(e => {
                            Options += '<option value="' + e.id + '">' + e.name + '</option>'
                        })
                        document.querySelector('#lg_id').innerHTML = Options

                        $('#lg_id').val(lg_id)
                    }
                    ).catch(e => {
                        console.log(e)
                    })
            }


            //Get All LGAs based on selected value of the state

            if (state != null) {
                $('#state_id').val(state_id)

                getDefaultLgas(state_id)
            }

            document.querySelector('#state_id').addEventListener('change', function () {
                let url = window.location.origin + '/api/base/lgas/' + this.value
                fetch(url).then(r => r.json())
                    .then(r => {
                        let Options = '<option value="">Select LGA</option>'
                        r.forEach(e => {
                            Options += '<option value="' + e.id + '">' + e.name + '</option>'
                        })
                        document.querySelector('#lg_id').innerHTML = Options
                    }
                    ).catch(e => {
                        //console.log(e)
                    })
            })
        })
    </script>