                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label for="gender">Gender <span class="required-feilds">*</span></label>
                        <select name="gender" id="gender" class="form-select border-bottom " required aria-required="true">
                            <option value="">Select an Option</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </div>
                    <div class="form-group col-md-4">
                        <label for="age_range" class="input_form">Age Range </label>
                        <div class="input-group input-group-sm mb-3">
                            <select name="age_range" id="age_range" class="form-select border-0 border-bottom" required aria-required="true">
                                <option value="">Select Age Range</option>
                                <option value="15-19">15-19</option>
                                <option value="20-30">20-30</option>
                                <option value="31-40">31-40</option>
                                <option value="41-50">41-50</option>
                                <option value="51 and above">51 and above</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label for="living_status" class="input_form">Current Living Status</label>
                        <div class="input-group input-group-sm mb-3">

                            <select class="form-select border-0 border-bottom" id="living_status" name="living_status"
                                required>
                                <option value="">Select One</option>
                                <option value="IDP">Internally Displaced Person </option>
                                <option value="Host">Indigene of the State</option>
                                <option value="Returnee">Returnee</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label for="certified">Certified Seed Producer <span class="required-feilds">*</span></label>
                        <select name="certified" id="certified" class="form-select border-bottom ">
                            <option value="">Select an Option</option>
                            <option value="Yes">YES</option>
                            <option value="No">NO</option>
                        </select>
                    </div>
                    <div class="form-group col-md-4">
                        <label for="state_id" class="input_form">Seed Producer State <span
                                class="profile_sub">*</span></label>
                        <div class="input-group">
                            <select name="state_id" class="form-select  border-bottom states " required id="state_id">
                                <option value="">Select State </option>
                                {{#each states}}
                                <option value="{{this.id}}">{{this.name}}</option>
                                {{/each}}
                            </select>
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label for="lg_id" class="input_form">Seed Producer LGA <span
                                class="profile_sub">*</span></label>
                        <div class="input-group">
                            <select required class="form-select border-bottom" id="lg_id" name="lg_id">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label for="amount_of_seed">Amount of seed <span class="required-feilds">*</span></label>
                        <input type="number" class="form-control" name="amount_of_seed" id="amount_of_seed" placeholder="Amount of seed" required aria-required="true">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="amount_of_seed_remitted">Amount of seed remitted<span class="required-feilds">*</span></label>
                        <input type="number" class="form-control" name="amount_of_seed_remitted" id="amount_of_seed_remitted" placeholder="Amount of seed remitted" required aria-required="true">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="amount_of_seed_to_be_remitted">Amount of Seeds to be Remitted<span class="required-feilds">*</span></label>
                        <input type="number" class="form-control" name="amount_of_seed_to_be_remitted" id="amount_of_seed_to_be_remitted" placeholder="Amount of Seeds to be Remitted" required aria-required="true">
                    </div>
                </div>
                <div class="form-row seeds">
                    <div class="form-group col-md-4">
                        <label for="nameOfSeed">Name of Seed Produced <span class="required-feilds">*</span></label>
                        <input type="text" class="form-control" name="nameOfSeed" id="nameOfSeed"
                            placeholder="Enter name of Seed" required aria-required="true">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="varietyOfSeed" class="input_form">Variety of seed produced <span
                                class="profile_sub">*</span></label>
                        <input type="text" class="form-control" name="varietyOfSeed" id="varietyOfSeed"
                            placeholder="Enter Variety of Seed" required aria-required="true">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="volumeOfSeed" class="input_form">Volume of seed produced (KG)<span
                                class="profile_sub">*</span></label>
                        <input type="number" class="form-control" name="volumeOfSeed" id="volumeOfSeed"
                            placeholder="e.g: 100" required aria-required="true">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="unit" class="input_form">Unit of measure<span class="profile_sub">*</span></label>
                        <div class="input-group">
                            <select class="form-select border-bottom" id="unit" name="unit" required aria-required="true">
                                <option value="">Select Unit of measure</option>
                                <option value="kg">Kg</option>
                                <option value="Metric Ton">Metric Ton</option>
                            </select>
                        </div>

                    </div>
                    <div class="form-group col-md-4">
                        <label for="yearProduced">Year produced <span class="required-feilds">*</span></label>
                        <input type="date" class="form-control" name="yearProduced" id="yearProduced" required aria-required="true">
                    </div>
                    <div class="form-group col-md-1 flex-end">
                        <div class="col col_sma add_class" style="width: 30px; margin-top:17px">
                            <div class="p-3  " style="width: inherit;">
                                <span class="add "
                                    style="cursor: pointer;display: inline-block;width: inherit;text-align: center;font-size: larger;"
                                    id="_add"><i class=" fa fa-solid fa-plus"></i></span>
                            </div>
                        </div>
                        <div class="col trash_class" style="display: none; width: 30px; margin-top:17px">
                            <div class="p-3 " style="width: inherit;">
                                <span id="_trash"
                                    style="cursor: pointer;display: inline-block;width: inherit;text-align: center;font-size: larger;"
                                    class="_trash"><i class="fa fa-solid fa-trash-can _trash p_red"></i></span>
                            </div>
                        </div>
                    </div>
                </div>


        </div>
        <hr>

        <div class="float-end">
            <div class="float-end m-2 mb-3">
                <button type="submit" class="btn btn-theme float-right submitBtn">Submit</button>
            </div>
            </form>
        </div>
    </div>

    <script type="text/javascript">
        $(document).ready(function () {

            $("#amount_of_seed_remitted").on("input", function () {
                var amount_of_seed = $("#amount_of_seed").val();
                var amount_of_seed_remitted = $("#amount_of_seed_remitted").val();

                var amount_of_seed_to_be_remitted = amount_of_seed - amount_of_seed_remitted;
                $("#amount_of_seed_to_be_remitted").val(amount_of_seed_to_be_remitted);
            });

            let state = $('#state_id').data('state_id')

            const getDefaultLgas = (state_id) => {
                let url = window.location.origin + '/api/base/lgas/' + state_id
                fetch(url).then(r => r.json())
                    .then(r => {
                        let selected, Options
                        r.forEach(e => {
                            Options += '<option value="' + e.id + '">' + e.name + '</option>'
                        })
                        document.querySelector('#lg_id').innerHTML = Options

                        $('#lg_id').val(lg_id)
                    }
                    ).catch(e => {
                        console.log(e)
                    })
            }


            //Get All LGAs based on selected value of the state

            if (state != null) {
                $('#state_id').val(state_id)

                getDefaultLgas(state_id)
            }

            document.querySelector('#state_id').addEventListener('change', function () {
                let url = window.location.origin + '/api/base/lgas/' + this.value
                fetch(url).then(r => r.json())
                    .then(r => {
                        let Options = '<option value="">Select LGA</option>'
                        r.forEach(e => {
                            Options += '<option value="' + e.id + '">' + e.name + '</option>'
                        })
                        document.querySelector('#lg_id').innerHTML = Options
                    }
                    ).catch(e => {
                        //console.log(e)
                    })
            })


            $('#_add').click(function () {
                let ele = $(this).closest(".form-row").clone(true)
                ele.insertAfter(".seeds:last")
                ele.find(".add_class").css("display", 'none')
                ele.find(".trash_class").css("display", "block")
            })
            $('._trash').click(function () {
                $(this).closest(".form-row").remove()
            })
        })

    /*    function disable() {
            console.log("disable")
            let submit_btn = document.querySelector('.submitBtn')
            submit_btn.setAttribute("disabled", "");
            submit_btn.removeAttribute("enabled", "");
        }   */

    </script>