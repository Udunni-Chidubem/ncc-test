    <script type="text/javascript">
        $(document).ready(function () {


            /* Cal amount of seed to be remitted */
            $("body").on("input", "#amountOfSeedRemitted", function () {
                var amount_of_seed = $("#amountOfSeed").val();
                var amount_of_seed_remitted = $("#amountOfSeedRemitted").val();

                var amount_of_seed_to_be_remitted = amount_of_seed - amount_of_seed_remitted;
                $("#amountOfSeedToBeRemitted").val(amount_of_seed_to_be_remitted);
            });


            let certified = $('#certified').data('certified')
            let state = $('#state').data('state')
            let age = $('#age_range').data('val')
            let livingStatus = $('#living_status').data('val')


            if (certified != null) {
                $('#certified').val(certified)
            }

            if (age != null) {
                $('#age_range').val(age)
            }
            if (livingStatus != null) {
                $('#living_status').val(livingStatus)
            }

            const getDefaultLgas = (state_id) => {
                let url = window.location.origin + '/api/base/lgas/' + state_id
                fetch(url).then(r => r.json())
                    .then(r => {
                        let selected, Options
                        r.forEach(e => {
                            Options += '<option value="' + e.id + '">' + e.name + '</option>'
                        })
                        document.querySelector('#lgas').innerHTML = Options

                        $('#lgas').val(lga)
                    }
                    ).catch(e => {
                        console.log(e)
                    })
            }



            if (state != null) {
                $('#state').val(state)

                getDefaultLgas(state)
            }

            let gender = $('#gender').data('gender')
            $('.gender').val(gender)

            if (gender != null) {
                $('.gender').val(gender)
            }

            document.querySelector('#state').addEventListener('change', function () {
                let url = window.location.origin + '/api/base/lgas/' + this.value
                fetch(url).then(r => r.json())
                    .then(r => {
                        let Options = '<option value="">Select LGA</option>'
                        r.forEach(e => {
                            Options += '<option value="' + e.id + '">' + e.name + '</option>'
                        })
                        document.querySelector('#lgas').innerHTML = Options
                    }
                    ).catch(e => {
                        //console.log(e)
                    })
            })


            /* BINARY SOL */

            $("body").on("click", "#edit-seed", function (event) {


                /* Cal amount of seed to be remitted */
                $("body").on("input", "#amountOfSeedRemitted", function () {
                    var amount_of_seed = $("#amountOfSeed").val();
                    var amount_of_seed_remitted = $("#amountOfSeedRemitted").val();

                    var amount_of_seed_to_be_remitted = amount_of_seed - amount_of_seed_remitted;
                    $("#amountOfSeedToBeRemitted").val(amount_of_seed_to_be_remitted);
                });

                const urlPath = window.location.pathname;
                const seedCompanyId = getIdFromCurrentLocationUrlPath(urlPath)
                const seedId = this.getAttribute("id-data");

                const url = window.location.origin + `/seed-company/fetch-single-seed/${seedId}/${seedCompanyId}`;

                fetch(url, {
                    method: 'GET'
                })
                    .then((res) => res.json())
                    .then((res) => {
                        const data = res.data;
                        if (data !== null && data !== undefined) {

                            const nameOfSeed = $('#nameOfSeedInput');
                            const varietyOfSeed = $('#varietyOfSeedInput');
                            const volumeOfSeed = $('#volumeOfSeedInput');
                            const yearProduced = $('#yearProducedInput');
                            const unit = $('#unitInput');
                            const seedIdInput = $('#seedId');
                            const amountOfSeed = $('#amountOfSeed');
                            const amountOfSeedRemitted = $('#amountOfSeedRemitted');
                            const amountOfSeedToBeRemitted = $('#amountOfSeedToBeRemitted');
                            const unitOfAmountOfSeed = $('.unit_for_total_amount_of_seed_given_input');
                            const unitOfAmountOfSeedRemitted = $('.unit_for_total_amount_of_seed_remitted_input');
                            const unitOfAmountOfSeedToBeRemitted = $('.unit_for_total_amount_of_seed_to_be_remitted_input');

                            //console.log(data);

                            seedIdInput.val(data.id);
                            nameOfSeed.val(data.name_of_seed);
                            varietyOfSeed.val(data.variety_of_seed);
                            volumeOfSeed.val(data.volume_of_seed);
                            yearProduced.val(data.year_produced);
                            unit.val(data.unit);
                            amountOfSeed.val(data.amount_of_seed);
                            amountOfSeedRemitted.val(data.amount_of_seed_remitted);
                            amountOfSeedToBeRemitted.val(data.amount_of_seed_to_be_remitted);
                            unitOfAmountOfSeed.val(data.unit_for_total_amount_of_seed_given);
                            unitOfAmountOfSeedRemitted.val(data.unit_for_total_amount_of_seed_remitted);
                            unitOfAmountOfSeedToBeRemitted.val(data.unit_for_total_amount_of_seed_to_be_remitted);

                        } else {
                            console.error('Data is null or undefined');
                        }
                    })
                    .catch((e) => console.log(e));
            });



            function getIdFromCurrentLocationUrlPath(path) {
                /* trim the current page url and extract the identifier */
                const parts = path.split('/');
                const Id = parts[parts.length - 1];
                return Id
            }



            $("#edit").click(function () {

                let inputState;

                var inputs = document.querySelectorAll("input");
                inputs.forEach(function (input) {
                    input.disabled = false;
                    inputState = true;
                });

                var selectInputs = document.querySelectorAll('select');
                selectInputs.forEach(function (select) {
                    select.disabled = false;
                    inputState = true;
                });

                if (inputState) {
