


<div class="container py-5">
    <div class="card">
        <div class="card-body m-2">
            <form method="POST" action="">
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label for="productName">Product Name <span class="required-feilds">*</span></label>
                        <input type="text" class="form-control" id="productName" placeholder="Product Name" required>
                    </div>

                    <div class="form-group col-md-6">
                        <label for="productVarient">Product Varient <span class="required-feilds">*</span></label>
                        <input type="text" class="form-control" id="productVarient" placeholder="Product Varient" required>
                    </div>
                </div>

                <div class="form-group prod-label">
                    <label for="productDescription"> Product Description <span class="required-feilds">*</span></label>
                     <textarea name="productDescription" id="productDescription" class="form-control" placeholder="Product Description" rows="5"></textarea>
                </div> 

                <hr>

                <div class=" row py-4">
                    <div class="col-lg-6 mx-auto">
                        <!-- Upload image input-->
                        <div class="input-group mb-3 px-2 py-2 rounded-pill bg-white shadow-sm">
                            <input id="upload" type="file" onchange="readURL(this);" class="form-control border-0">
                            <label id="upload-label" for="upload" class="font-weight-light text-muted">Choose file</label>
                            <div class="input-group-append">
                                <label for="upload" class="btn btn-light m-0 rounded-pill px-4"> <i class="fa fa-cloud-upload mr-2 text-muted"></i><small class="text-uppercase font-weight-bold text-muted">Choose file</small></label>
                            </div>
                        </div>
                    </div>
                     <div class="image-area col-lg-6">
                        <img id="imageResult" src="#" alt="" class="img-fluid rounded shadow-sm mx-auto d-block">
                    </div>
                </div>
                
                <hr>
                <button type="submit" class="btn btn-theme move-btn-right">Submit</button>

            </form>
        </div>
    </div>


    
</div>