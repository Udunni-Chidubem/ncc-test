<!-- Content Wrapper START -->
<div class="main-content">
  <div class=" container table-responsives table_t_info">

    <table class="table con t_info  table-borderless">
      <thead class="t_info_head ">
        <tr class="">
          <th scope="col">ORDER ID</th>
          <th scope="col">DATE</th>
          <th scope="col">CUSTOMER NAME</th>
          <th scope="col">TOTAL AMOUNT(&#8358;)</Nav>
          </th>
          <th scope="col">PAYMENT STATUS</th>
          <th scope="col">ORDER STATUS</th>
          <th scope="col"></th>
        </tr>
      </thead>
      <tbody class="t_info_body">


        {{#if orders}}
        {{#each orders}}
        <tr class="t_info_row1">
          <th scope="row"><a href="#">{{transaction_id}}</a></th>
          <td>{{dateFormat created_at "DD/MM/YYYY"}}</td>
          <td>{{firstname}} {{lastname}}</td>
          <td>{{amount}}</td>
          <td><span class=" "> <span class="approved px-1"><i class="bi bi-dot"></i> Approved</span> </td>
          <td>
            {{#if (eq status "1")}}
            <span class="pending px-1"><i class="bi bi-dot"></i>Ready to ship</span>
            {{else if (eq status "2")}}
            <span class="shipped px-1"><i class="bi bi-dot"></i>Shipped</span>
            {{else if (eq status "3")}}
            <span class="approved px-1"><i class="bi bi-dot"></i>Fulfilled</span>
            {{else}}
            <span class="processing px-1"><i class="bi bi-dot"></i>Processing</span>
            {{/if}}
          </td>
          {{!-- <td><span class=" "> <span class="pending px-1"><i class="bi bi-dot"></i> Pending</span> </td> --}}
          <td>
            <a href="#">
              <div class="dropdown d_t">
                <a class="btn   dropdown-toggle action_btn" href="#" role="button" id="dropdownMenuLink"
                  data-bs-toggle="dropdown" aria-expanded="false">
                  Actions
                </a>

                <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                  <li><a class="dropdown-item border-0 border-bottom"
                      href="/seed-company/orders/{{transaction_id}}">View Order</a></li>
                </ul>
              </div>
            </a>
          </td>
        </tr>
        {{/each}}
        {{else}}
        <tr>
          <td colspan="7">
            <div class="row d-flex justify-content-center">
              No Order(s) available
            </div>
          </td>
        </tr>
        {{/if}}
      </tbody>
    </table>
  </div>
</div>