{{#if wallet}}
<div class="d-flex justify-content-end mb-2">
	<button class="btn btn-info export-btn"> Export </button>
</div>
<div class=" card account-details-section" id="account-details">
	<div class="card-body">
		{{!-- Balance Grid - Begins --}}
		<div class="balance-grid">
			<div>
				<h5>Ledger Balance</h5>

				<h3>&#8358; {{number wallet.amount}}</h3>

			</div>

			<div class="cleared-balance">
				<h6>Cleared Balance</h6>
				<h4>&#8358; 0</h4>
			</div>

			<div class="uncleared-balance">
				<h6>Uncleared Balance</h6>
				<h4>&#8358; {{number wallet.amount}}</h4>
			</div>
		</div>
		<div class="d-flex justify-content-end mb-2">
			<button class="btn btn-success" id="withdraw-btn" data-bs-toggle="modal" data-bs-target="#withdrawalModal">
				Withdraw </button>
		</div>
		<div class="transaction-div">
			<select name="transaction-types" class="custom-select  mb-2">
				<option value="in_flow">In Flow</option>
				<option value="withdrawal">Withdrawals</option>
			</select>
			<hr>
			<div class="walletTable in_flow">
				<table class="table-responsive table con t_info  table-borderless " id="in_flow_Table">
					<thead class="t_info_head ">
						<tr class="">
							<th scope="col">ORDER ID</th>
							<th scope="col">EARNING(&#8358;)</Nav>
							</th>
							<th scope="col">DATE</Nav>
							</th>
							<th scope="col">STATUS</th>
						</tr>
					</thead>
					<tbody class="t_info_body">
						<tr class="t_info_row1">
							<th scope="row"><a href="#">12345678</a></th>
							<td>&#8358; 2000</td>
							<td>12/12/3032</td>
							<td><span class=" "> <span class="pending px-1"><i class="bi bi-dot"></i> Pending</span>
							</td>

						</tr>

					</tbody>
				</table>
			</div>


			<div class="withdrawal walletTable">
				<table class="container-fluid table con t_info  table-borderless" id="transactionTable">
					<thead class="t_info_head ">
						<tr class="">
							<th scope="col">S/N</th>
							<th scope="col">TRANSACTION ID</th>
							<th scope="col">AMOUNT (&#8358;)</th>
							<th scope="col">DATE</th>
						</tr>
					</thead>
					<tbody class="t_info_body" id="tableBody">
						{{!-- {{#if walletLog}}
						{{this.amount}}
						{{/if}}
						{{#walletLog}}
						{{this.amount}}
						<tr class="t_info_row1">
							<th scope="row"><a href="#">12345678</a></th>
							<td>&#8358; 2000</td>
							<td>12/12/3032</td>
						</tr>
						{{/walletLog}} --}}
						{{!-- {{/each}} --}}
					</tbody>
				</table>
				<div class="col-md-12 p-4"
					style="width: 100%; display: flex; align-items: center; justify-content: space-between">
					<div>
						Showing <span id="start"></span> to <span id="end"></span> of <span id="total"></span>
					</div>
					<div id="paginationControls"></div>
				</div>
			</div>
		</div>
	</div>
</div>
</div>


<!-- Withdrawal Modal-->
<div class="modal fade " id="withdrawalModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
	aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-sm" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<button class="close" type="button" data-bs-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">×</span>
				</button>
			</div>
			<div class="modal-body">
				<div id="msg"></div>
				<div class="col-md-12 d-flex justify-content-center">
					<img src="../../images/spin-wheel.gif" alt="spin wheel" style="visibility: hidden;" id="loader">
				</div>
				<form action="wallet_submit" method="get">
					<div class="mb-2">
						<input type="number" class="form-control" id="amount" name="amount" value=""
							placeholder="Enter Amount to Withdraw">
					</div>
					<div class="mb-2">
						<input type="password" class="form-control" id="password" name="password" value=""
							placeholder="Password">
					</div>

			</div>
			<div class="modal-footer">
				<button class="btn btn-success w-100" type="button" data-bs-dismiss="modal" id="close-btn"
					style="display: none;">OK</button>
				<button type="submit" class="btn btn-success w-100" style="display: block;"
					id="withdraw-btn">Withdraw</button>
				<button class="btn btn-danger w-100" type="button" data-bs-dismiss="modal" style="display: block;"
					id="cancel-btn">Cancel</button>
			</div>
			</form>
		</div>
	</div>
</div>
{{/if}}


<script>
	$(document).ready(function () {

		$("select").change(function () {
			$(this).find("option:selected").each(async function () {
				var optionValue = $(this).attr("value");
				if (optionValue) {
					$(".walletTable").not("." + optionValue).hide();
					$("." + optionValue).show();
					if (optionValue == "withdrawal") {
						return await fetchWidthdrawalHistory(currentPage, pageSize);;
					}
				} else {
					$(".walletTable").hide();
				}
			});
		}).change();

		$('#withdrawalModal').on('shown.bs.modal', function () {
			$('#withdrawalModal').trigger('focus')
		});



		/*
			Binary SOL
		*/

		$("body").on("submit", (e) => {
			e.preventDefault();

			this.innerText = "Please wait...";


			$('#loader').css('visibility', 'visible');

			const urlPath = window.location.pathname;
			const url = window.location.origin + '/seed-company/found-withdraw';

			var form = new FormData();
			var amount = document.getElementById('amount').value;
			var password = document.getElementById("password").value;

			form.append("amount", amount);
			form.append("password", password);

			fetch(
				url,
				{
					method: "POST",
					body: form,
				}
			)
				.then(res => res.json())
				.then(res => {


					$('#loader').css('visibility', 'hidden');

					if (res.success === true) {

						document.getElementById('withdraw-btn').style.display = 'none';
						document.getElementById('cancel-btn').style.display = 'none';
						document.getElementById('close-btn').style.display = 'block';

						const msg = `<div class="alert alert-success" style="font-size: 14px;">${'Transaction Successful'}</div>`;
						document.getElementById('msg').innerHTML = msg;



						return;
					} else if (res.success === false && res.status === 400) {
						const msg = `<div class="alert alert-danger" style="font-size: 14px;">${res.message}</div>`;
						document.getElementById('msg').innerHTML = msg;
						return;
					}
					else {
						//console.log(res.message)
						const msg = `<div class="alert alert-danger" style="font-size: 14px;">${'Transaction Failed'}</div>`;
						document.getElementById('msg').innerHTML = msg;
						return;
					}
				})
				.catch((e) => console.log(e));
		});

		$('#close-btn').click(() => {
			window.location.reload();
		});



		let currentPage = 1;
		const pageSize = 10;

		async function fetchWidthdrawalHistory(page = 1, pageSize = 10) {
			const url = `${window.location.origin}/seed-company/withdraw-log?page=${page}&pageSize=${pageSize}`;

			fetch(url, { method: "GET" })
				.then((res) => res.json())
				.then((res) => {
					$('.pagination').remove();
					$('#transactionTable_info').remove();
					const tableBody = document.getElementById('tableBody');
					tableBody.innerHTML = '';

					var sn = (page - 1) * pageSize + 1;

					res.data.forEach(element => {
						const newRow = document.createElement('tr');
						newRow.className = 't_info_row1';
						newRow.innerHTML = `
						<td>${sn++}</td>
						<th scope="row"><a href="#">${element.transaction_ref}</a></th>
						<td>&#8358; ${element.amount}</td>
						<td>${element.created_at}</td>
						`;

						tableBody.appendChild(newRow);
					});

					console.log(res.totalPages);
					console.log(res.currentPage);
					updatePaginationControls(res.totalPages, res.currentPage);
				})
				.catch((e) => {
					console.log(e);
				});
		}

		function updatePaginationControls(totalPages, currentPage) {
			const paginationControls = document.getElementById('paginationControls');
			paginationControls.innerHTML = ''; // Clear existing controls

			if (currentPage > 1) {
				const prevButton = document.createElement('button');
				prevButton.className = 'btn btn-light btn-sm shadow w-100';
				prevButton.innerText = 'Previous';
				prevButton.addEventListener('click', () => {
					fetchWidthdrawalHistory(currentPage - 1, pageSize);
				});
				paginationControls.appendChild(prevButton);
			}

			if (currentPage < totalPages) {
				const nextButton = document.createElement('button');
				nextButton.className = 'btn btn-light btn-sm shadow w-100 bordered';
				nextButton.innerText = 'Next';
				nextButton.addEventListener('click', () => {
					fetchWidthdrawalHistory(currentPage + 1, pageSize);
				});
				paginationControls.appendChild(nextButton);
			}
		}


		/*
			Binary EOL
		*/






	});


</script>