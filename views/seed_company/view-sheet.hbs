<div class= "view-sheet-body">
  <div class="table-responsives table_t_info">

    <table class="table t_info  table-bordered">
      <thead class="t_info_head ">
        <tr class="">
          <th scope="col">S/N</th>
          <th scope="col">Name</th>
          <th scope="col">Phone No.</th>
          <th scope="col">Product Name</th>
          <th scope="col">Variant</th>
          <th scope="col">Qty</th>
          <th scope="col">Size</th>
          <th scope="col">Cost</th>
          <th scope="col">Date</th>
          <th scope="col">State</th>
          <th scope="col">LGA</th>
          <th scope="col">Community</th>
        </tr>
      </thead>
      <tbody class="t_info_body">
      {{#each saleSheets }}
        <tr>
          <td scope="row">{{@index}}</td>
          <td>{{customer_name}}</td>
          <td>{{customer_number}}</td>

          {{#cancatArray product_name}}
          <td>{{this}}</td>
          {{/cancatArray}}

          {{#cancatArray product_variant}}
          <td>{{this}}</td>
          {{/cancatArray}}

          {{#cancatArray quantity}}
          <td>{{this}}</td>
          {{/cancatArray}}
          
          {{#cancatArray size}}
          <td>{{this}}</td>
          {{/cancatArray}}

          {{#cancatArray product_cost}}
          <td>{{this}}</td>
          {{/cancatArray}}
          
          <td>{{dateFormat  this.date_sold  "'DD/MM/YYYY'"}}</td>
          <td>{{State.name}}</td>
          <td>{{LGA.name}}</td>
          <td>{{community}}</td>

        </tr>
       {{/each}}
        


      </tbody>