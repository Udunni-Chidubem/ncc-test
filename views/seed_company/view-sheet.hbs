<div class="view-sheet-body">
  <div class="table-responsives table_t_info">

    <table class="table t_info  table-bordered">
      <thead class="t_info_head ">
        <tr class="">
          <th scope="col">S/N</th>
          <th scope="col">Name</th>
          <th scope="col">Phone No.</th>
          <th scope="col">Product Name</th>
          <th scope="col">Variety</th>
          <th scope="col">Qty</th>
          <th scope="col">Size</th>
          <th scope="col">Cost</th>
          <th scope="col">Date</th>
          <th scope="col">State</th>
          <th scope="col">LGA</th>
          <th scope="col">Community</th>
          <th scope="col">Action</th>
        </tr>
      </thead>
      <tbody class="t_info_body">
        {{#each saleSheets }}
        <tr>
          <td scope="row">{{increment @index}}</td>
          <td>{{customer_name}}</td>
          <td>{{customer_number}}</td>

          {{#cancatArray product_name}}
          <td>{{this}}</td>
          {{/cancatArray}}

          {{#cancatArray product_variant}}
          <td>{{this}}</td>
          {{/cancatArray}}

          {{#cancatArray quantity}}
          <td>{{this}}</td>
          {{/cancatArray}}

          {{#cancatArray size}}
          <td>{{this}}</td>
          {{/cancatArray}}

          {{#cancatArray product_cost}}
          <td>{{this}}</td>
          {{/cancatArray}}

          <td>{{dateFormat this.sale_date 'dddd, MMMM Do YYYY'}}</td>
          <td>{{State.name}}</td>
          <td>{{LGA.name}}</td>
          <td>{{community}}</td>
          <td><button class="btn btn-xs btn-light" id="edit" data-id="{{id}}"><i
                class="fa fa-edit text-success"></i></button></td>
        </tr>
        {{/each}}
      </tbody>



      <script>

        $(document).ready(function () {
          $("body").on("click", "#edit", function () {
            let id = $(this).data("id");
            window.location.href = "/seed_company/edit-sheet/" + id
            axios.
          })
        });

      </script>