<div class="view-sheet-body">
  <div class="tab-pane" style="padding: 8px;"  role="tabpanel">
    <table class=" table t_info table-bordered table-striped table-responsive table-hover" id="all-sheet-table">
      <thead class="t_info_head ">
        <tr>
          <th>S/N</th>
          <th>NAME</th>
          <th>PHONE NO.</th>
          <th>PRODUCT NAME</th>
          <th>VARIANT</th>
          <th>QTY</th>
          <th>SIZE</th>
          <th>COST</th>
          <th>DATE</th>
          <th>STATE</th>
          <th>LGA</th>
          <th>COMMUNITY</th>
        </tr>
      </thead>

      <tbody class="t_info_body">
        {{#each saleSheets}}
        <tr>
          <td colspan="" rowspan="" headers="">{{increment @index}}</td>
          <td colspan="" rowspan="" headers="">{{customer_name}}</td>
          <td colspan="" rowspan="" headers="">{{customer_number}}</td>

          {{#cancatArray product_name}}
          <td>{{this}}</td>
          {{/cancatArray}}

          {{#cancatArray product_variant}}
          <td>{{this}}</td>
          {{/cancatArray}}

          {{#cancatArray quantity}}
          <td>{{this}}</td>
          {{/cancatArray}}

          {{#cancatArray size}}
          <td>{{this}}</td>
          {{/cancatArray}}

          {{#cancatArray product_cost}}
          <td>{{this}}</td>
          {{/cancatArray}}

          <td colspan="" rowspan="" headers="">{{dateFormat this.sale_date "dddd, MMMM Do YYYY"}}</td>
          <td colspan="" rowspan="" headers="">{{State.name}}</td>
          <td colspan="" rowspan="" headers="">{{LGA.name}}</td>
          <td colspan="" rowspan="" headers="">{{community}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>