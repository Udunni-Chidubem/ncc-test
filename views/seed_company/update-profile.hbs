
<form method="post" id="update">
 <div class="container ">
   <div class="row">
      <div class="col-12">
         <div class="card card_home card_profile rounded mx-auto shadow pl-0 mb-2 ">
            <div class="card-body bg-light">
               <div class="row row-cols-5 row-cols-lg-1 g-2 g-lg-2">
                  <div class="col-12 text-center">
                     <div class="p-3">
                        <h5 class="card-header card-c p-0 mb-3 bg-light profile_header">Personal Information</h5>
                          <img src="../images/profile-avatar.png" id="output" class=" mb-2 mx-auto d-block img_round" alt="user profile image">
                          <label for="file">
                          <span class="profilePic-btn">Change Image</span>
                          </label>
                          <input id="file" class="fileDisplay" type="file" onchange="loadFile(event)"/>                        <div class="row">
                           <div class="col-sm-6">
                              <label for="company" class="input_form">Company Name <span class="profile_sub">*</span></label>
                              <div class="input-group input-group-sm mb-3">
                                 <input 
                                    type="text" 
                                    class="form-control border-0 border-bottom input_borderless" 
                                    required
                                    readonly
                                    name="name_of_company"
                                    id="company_name"
                                    aria-label="Sizing example input" 
                                    aria-describedby="inputGroup-sizing-sm"
                                    value="{{ company.name_of_company}}">
                              </div>
                           </div>
                           <div class="col-sm-6">
                              <label for="email"  class="input_form">Email Address <span class="profile_sub">*</span></label>
                              <div class="input-group input-group-sm mb-3">
                                 <input 
                                    type="email" 
                                    class="form-control border-0 border-bottom" 
                                    required
                                    name="email"
                                    id="email"
                                    value="{{company.email}}"
                                    aria-label="Sizing example input" 
                                    aria-describedby="inputGroup-sizing-sm">
                              </div>
                           </div>
                        </div>
                        <div class="row">
                           <div class="col-sm-6">
                              <label for="phone" class="input_form">Phone Number <span class="profile_sub">*</span></label>
                              <div class="input-group input-group-sm mb-3">
                                 <input 
                                    class="form-control" 
                                    required 
                                    type="text" 
                                    id="phone" 
                                    name="phone_no" 
                                    placeholder="Phone e.g 0*******" 
                                    pattern="^0[0-9]{10}$"
                                    value="{{company.phone_no}}"
                                    readonly
                                    title="Phone Number should start with 0 and contain 11digits"
                                    minlength="11"
                                    maxlength="11">
                              </div>
                           </div>
                           <div class="col-sm-6">
                              <label for="tin" class="input_form">Other Seeds Sold  <span class="profile_sub">*</span></label>
                              <div class="input-group input-group-sm mb-3">
                                 <input 
                                    type="text" 
                                    class="form-control border-0 border-bottom" 
                                    maxlength="14" 
                                    minlength="13"
                                    id="tin"
                                    name="tin"
                                    value="{{company.tin}}"
                                    aria-label="Sizing example input" 
                                    aria-describedby="inputGroup-sizing-sm"
                                    pattern="[0-9]+"
                                    >
                              </div>
                           </div>
                        </div>
                        <div class="row">
                           <div class="col-sm-6 license_link" class="input_form">
                              <label for="licenced" class="input_form">License Number <span class="profile_sub">*</span> </label>
                              <div class="input-group input-group-sm mb-3">
                                 <input 
                                    type="text" 
                                    class="form-control border-0 border-bottom" 
                                    required
                                    id="licensed_no"
                                    name="licensed_no"
                                    value="{{company.licensed_no}}"
                                    aria-label="Sizing example input"
                                    aria-describedby="inputGroup-sizing-sm"> 
                              </div>
                              <a href="#" class="red_link" >Don't Have a License? Click Here</a>
                           </div>
                           <div class="col-sm-6 license_link">
                              <label for="certification" class="input_form">Certification Number <span class="profile_sub">*</span></label>
                              <div class="input-group input-group-sm mb-3">
                                 <input 
                                    type="text" 
                                    class="form-control border-0 border-bottom" 
                                    required
                                    name="certification_number"
                                    id="certification_number"
                                    value="{{company.certification_number}}"
                                    aria-label="Sizing example input" 
                                    aria-describedby="inputGroup-sizing-sm">
                              </div>
                               <a href="#" class="red_link" >Don't Have a Cetification? Click Here</a>
                           </div>
                        </div>
                        <div class="row">
                           <div class="col-sm-6" >
                              <div class="input-group input-group-sm mb-3">
                                 <label for="state" class="input_form">State <span class="profile_sub">*</span></label>
                                 <div class="input-group mb-3">
                                    <select name="state_id" class="form-select border-0 border-bottom states" required id="state" data-state="{{company.state_id}}">
                                       <option value="">Select State </option>
                                       {{#each states}}
                                       <option value="{{this.id}}">{{this.name}}</option>
                                       {{/each}}
                                    </select>
                                 </div>
                              </div>
                           </div>
                           <div class="col-sm-6">
                              <div class="input-group input-group-sm mb-3">
                                 <label for="lga" class="input_form">LGA <span class="profile_sub">*</span></label>
                                 <div class="input-group mb-3">
                                    <select class="form-select border-0 border-bottom lgas" required id="lgas" name="lg_id" data-lga="{{company.lg_id}}">
                                    </select>
                                 </div>
                              </div>
                           </div>
                        </div>
                        <div class="row">
                           <div class="col-sm-12">
                              <label for="address" class="input_form">Address <span class="profile_sub">*</span></label>
                              <div class="input-group input-group-sm mb-3">
                                 <textarea class="form-control border-0 border-bottom" name="address"  id="address" cols="30" style="align-content:left; overflow:auto" rows="5" required>{{ company.address }} </textarea>
                              </div>
                           </div>
                        </div>
                        <div class="row">
                           <div class="col-12">
                              <div class="columns mx-auto"  style="width: 160px;">
                                 <button type="submit" class="btn float-end mb-1 submitBtn">Update</button>
                              </div>
                           </div>
                        </div>
                     </div>
                  </div>
               </div>
            </div>
         </div>
      </div>
   </div>
</div>
</form>



<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.1.1/jquery.min.js"></script>
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js" integrity="sha512-qTXRIMyZIFb8iQcfjXWCO8+M5Tbc38Qi5WzdPOYZHIlZpzBHG3L3by84BBBOiRGiEb7KKtAOAs5qYdUiZiQNNQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

<script type="text/javascript">
    $(document).ready(function(){ 

        let lga = $('#lgas').data('lga')

        const getDefaultLgas = (state_id) => {
            let url =  window.location.origin+'/api/base/lgas/'+ state_id
            fetch(url).then(r=>r.json())
            .then(r => { 
                //let Options =  '<option value="">Select LGA</option>'
                let selected,Options
                r.forEach(e=>{
                    selected = (e.id == lga ? 'selected' : null)
                    Options+='<option value="'+e.id+'" selected="'+selected+'">'+e.name+'</option>'
                })
                document.querySelector('#lgas').innerHTML= Options
            }
            ).catch(e=>{
                console.log(e)
            })
        }


        let state = $('#state').data('state')
        if(state != null || lga != null ){
            $('#state').val(state)

            getDefaultLgas(state)

            setTimeout(function(){
                let url =  window.location.origin+'/api/base/lgas/'+ state
                fetch(url).then(r=>r.json())
                .then(r => { 
                    let selected,Options
                    r.forEach(e=>{
                        selected = (e.id == lga ? 'selected' : null)
                        Options+='<option value="'+e.id+'" selected="'+selected+'">'+e.name+'</option>'
                    })
                    document.querySelector('#lgas').innerHTML= Options
                }
                ).catch(e=>{
                    console.log(e)
                })
            }, 1000)
        }


    $("#update").on('submit', function(e){
      e.preventDefault()
      
      let _data = {
        name_of_company: $('#company_name').val(),
        phone_no: $('#phone').val(),
        tin: $('#tin').val(),
        address: $('#address').val(),
        licensed_no: $('#licensed_no').val(),
        certification_number: $('#certification_number').val(),
        state_id: $('#state').val(),
        lg_id: $('#lgas').val(),
        email: $('#email').val(),
        address: $('#address').val()
      }

      let updateURL =  window.location.origin+'/seed-company/update-profile'
      
      $.ajax({
        type: 'POST',
        url: updateURL,
        data: $(this).serialize(),
        beforeSend: () => {
          $('.submitBtn').html('Please Wait...')
        },
        success: (response) => {
          if(response.statusCode === 402){
            let msg = ''
            let errors = response.data
            errors.forEach((value, index) => {
              msg += (index + 1 ) + '.' + value.msg + ' \n'
            })
            error_toastr(msg)
          }else if(response.statusCode == 500 || response.statusCode == 400){
            error_toastr(response.data)
          }else{
            let m = state != null ? 'Your profile has been update successfully.' : response.message
            success_toastr(m)

            setTimeout(function(){
              if(!state){
                window.location='dashboard'
              }
              
            }, 2000)
          }
        },
        complete: () => {
          $('.submitBtn').html('Update')
        },
        error: (err) => { }
      })
      
    })

    })

      const loadFile = function (event) {
  event.preventDefault()
let image = document.getElementById("output");
image.src = URL.createObjectURL(event.target.files[0]);
};
</script>
