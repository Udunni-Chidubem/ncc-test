<form action="" method="post"> 
 <div class="container ">
        <div class="row">
          <form action="" method="post"></form>
            <div class="col-12">
                <div class="card card_home rounded mx-auto shadow pl-0 mb-2 ">
                    <div class="card-body bg-light">
                     
                      <div class="row row-cols-5 row-cols-lg-1 g-2 g-lg-2">
                        
                        <div class="col-12">
                         
                           
                          <div class="p-3     ">
                            <h5 class="card-header card-c p-0 mb-3 bg-light profile_header">Personal Information</h5>
                          <img src="../images/farmer-with-vege-p-2000.jpeg" class=" mb-2 mx-auto d-block img_round" alt="...">
                             <div class="row">
                                <div class="col-sm-6">
                                  <label for="company" class="input_form">Company Name</label>
                                    <div class="input-group    input-group-sm mb-3">
                                      
                                      <input type="text" class="form-control border-0 border-bottom  input_borderless " required aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm">
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                  <label for="email"  class="input_form">Email</label>
                                  <div class="input-group input-group-sm mb-3">
                                    
                                    <input type="text" class="form-control border-0 border-bottom" required aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm">
                                  </div>
                              </div>
                             </div>

                             <div class="row">
                              <div class="col-sm-6">
                                <label for="phone" class="input_form">Phone Number</label>
                                  <div class="input-group input-group-sm mb-3">
                                    
                                    <input type="number" class="form-control border-0 border-bottom" min="11" max="14" required aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm">
                                  </div>
                              </div>

                              <div class="col-sm-6">
                                <label for="tin" class="input_form">TIN</label>
                                  <div class="input-group input-group-sm mb-3">
                                    
                                    <input type="number" class="form-control border-0 border-bottom" max="13" min="10" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm">
                                  </div>
                              </div>
                           </div>

                             <div class="row">
                              <div class="col-sm-6" class="input_form">
                                <label for="licenced" class="input_form">Licensed Number </label>
                                  <div class="input-group input-group-sm mb-3">
                                    
                                    <input type="number" class="form-control border-0 border-bottom" required aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm">
                                  </div>
                              </div>

                              <div class="col-sm-6">
                                <label for="certification" class="input_form">Certification Number</label>
                                <div class="input-group input-group-sm mb-3">
                                  
                                  <input type="number" class="form-control border-0 border-bottom" required aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm">
                                </div>
                            </div>
                           </div>

                           <div class="row">
                            <div class="col-sm-6" >
                                <div class="input-group input-group-sm mb-3">
                                  
                                  <label for="state" class="input_form">State</label>
                                <div class="input-group mb-3">
                              
                                  <select class="form-select border-0 border-bottom states" required id="inputGroupSelect01">                
                                    <option value="">Select State </option>
                                    {{#each states}}
                                        <option value="{{this.id}}">{{this.name}}</option>
                                    {{/each}}
                                     
                                  </select>
                                </div>

                                </div>
                            </div>

                            <div class="col-sm-6">
                              <div class="input-group input-group-sm mb-3">
                                
                                <label for="lga" class="input_form">LGA</label>
                                <div class="input-group mb-3">
                              
                                  <select class="form-select border-0 border-bottom lgas" required id="inputGroupSelect01">
                                     
                                    <option value="1"> </option>
                                    <option value="2">Female</option>
                                     
                                  </select>
                                </div>

                              </div>
                          </div>
                         </div>
                       
                       <div class="row">
                        <div class="col-sm-6">
                          <label for="address" class="input_form">Address</label>
                          <div class="input-group input-group-sm mb-3">
                            
                            <input type="text" class="form-control border-0 border-bottom" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm">
                          </div>
                      </div>
                       </div>  
                       
                       <div class="row">
                        <div class="col-12">
                          <div class="columns mx-auto"  style="width: 160px;">
                            <button type="button float-end" class="btn  mb-1">Update</button>
                          </div>
                        </div>
                       </div>
                        
                     </div>

                     
                          </div>
                          
</form>                          