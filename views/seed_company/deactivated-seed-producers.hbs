<!-- Content Wrapper START -->
<div class="main-content">
    <div class="container">
        <div id="msg"></div>
        {{!-- <div class="row  ">
            <div class="col-12   ">
                <a href="seed-producers/create" class="btn create_p mb-2  float_end ">
                    <span><i class=" fa fa-solid fa-plus"></i></span> Create Seed Producer
                </a>
            </div>
        </div> --}}
    </div>
    <div class="card table-responsives table_t_info p-3">
        <table class="table con t_info  table-borderless" id="seedProducers">
            <thead class="t_info_head ">
                <tr class="">
                    <th scope="col">S/N</th>
                    <th scope="col">Name</th>
                    <th scope="col">Seed Produced</th>
                    <th scope="col">Variety</th>
                    <th scope="col">Volume</th>
                    <th scope="col">Location</th>
                    <th scope="col">Date Created</th>
                    <th scope="col"></th>
                </tr>
            </thead>


            <tbody class="t_info_body products-list-table">
                {{#each seedProducer}}
                    {{#if (eq status 2)}}
                        <tr class="t_info_row1">
                            <th scope="row">{{increment @index}}</th>
                            <td> {{full_name}}</td>
                            <td>{{SeedProducerSeeds.[0].name_of_seed}}</td>
                            <td>{{SeedProducerSeeds.[0].variety_of_seed}}</td>
                            <td>{{SeedProducerSeeds.[0].volume_of_seed}} {{SeedProducerSeeds.[0].unit}}</td>
                            <td>{{LGA.name}}, {{State.name}}</td>
                            <td>{{dateFormat created_at "DD/MM/YYYY"}}</td>
                            <td><a href="#">
                                    <div class="dropdown d_t">
                                        <a class="btn   dropdown-toggle action_btn" href="#" role="button" id="dropdownMenuLink"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                            Actions
                                        </a>

                                        <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                                            <li><a class="dropdown-item border-0 border-bottom"
                                                    href="/seed-company/seed-producer/{{id}}">View</a></li>
                                            <li><a class="dropdown-item border-0 border-bottom update-seed-producer-status-btn"
                                                    href="#" 
                                                    id-data="{{user_id}}" 
                                                    seed-producer-data="{{id}}" 
                                                    id="update-seed-producer-status-btn"
                                                    current-status-data="{{status}}"
                                                    >
                                                    Deactivate
                                                    </a>
                                                </li>
                                        </ul>
                                    </div>
                                </a></td>
                        </tr>
                    {{/if}}
                {{/each}}
            </tbody>
        </table>
    </div>
</div>

<script>

    $(document).ready(function () {
        $('#seedProducers').DataTable({});


        /*
            Binary SOL
        */

            function getCurrentStatus() {
                const statusElements = document.querySelectorAll('.update-seed-producer-status-btn');
                statusElements.forEach((status) => {
                    const currentStatus = parseInt(status.getAttribute('current-status-data'));
                    if (currentStatus === 2) {
                        status.textContent = "Activate";
                    } else {
                        status.textContent = "Deactivate";
                    }
                });
            }

            getCurrentStatus();

            $(".update-seed-producer-status-btn").click((event) => {
                const seedCompany = event.target;
                const userId = seedCompany.getAttribute("id-data");
                const seedProducerId = seedCompany.getAttribute("seed-producer-data");
                const currentStatus = seedCompany.getAttribute("current-status-data");
                
                var url = window.location.origin + `/seed-company/update-seed-producer-staus/${userId}/${seedProducerId}`;

                fetch(url, {
                    method: "PATCH"
                })
                .then((res) => res.json())
                .then((res) => {
                    const data = res;
                    
                    if(data.success == true){
                        document.getElementById('msg').innerHTML = `
                        <div class='alert alert-success alert-dismissible fade show' role='alert'>
                            ${data.msg}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>`;
                        if(data.state === 2){
                            seedCompany.textContent = 'Activate';
                            setTimeout(() => {
                                location.reload();
                            }, 500)
                        }
                        else{
                            seedCompany.textContent = 'Deactivate';
                            setTimeout(() => {
                                location.reload();
                            }, 500)
                        }
                        return;
                    }else{
                        document.getElementById('msg').innerHTML = `
                        <div class='alert alert-warning alert-dismissible fade show' role='alert'>
                            ${data.msg}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>`;
                        setTimeout(() => {
                            location.reload();
                        }, 500)
                    }
                    
                })
                .catch((e) => console.log(e));

            });


        /*
            Binary EOL
        */

    });
</script>