
<div class="container py-5">
    <div class="card card_prod card_home">
        <div class="card-body">
            <form method="POST" action="" id="form-product" enctype="multipart/form-data">
                <div class="form-row"  >
                    <div class="form-group col-md-4">
                        <label for="productName">Product Name <span class="required-feilds">*</span><span class="d-inline-block" data-toggle="tooltip" data-placement="right" title="Is the product Maize, Cowpea, Groundnut, Rice"><i class="bi bi-info-circle"></i></span> </label></label>
                        <input type="text" class="form-control" name="productName" id="productName" placeholder="E.g Maize" required>
                    </div>
                    <div class="form-group col-md-4">
                        <label for="productVarient">Product Variant <span class="required-feilds">*</span> <span class="d-inline-block" data-toggle="tooltip" data-placement="right" title="What is the variant / specie of the product?"><i class="bi bi-info-circle"></i></span> </label></label>
                        <input type="text" class="form-control" name="productVariant" id="productVariant" placeholder="e.g Yellow maize" required>
                    </div>
                    <div class="form-group col-md-4">
                        <label for="productVarient">Product Local Name <span class="required-feilds">*</span><span class="d-inline-block" data-toggle="tooltip" data-placement="right" title="What is the local name?"><i class="bi bi-info-circle"></i></span> </label></label>
                        <input type="text" class="form-control" name="productLocalName" id="productLocalName" placeholder="Local Name" required>
                    </div>
                </div>
                <div class="form-group prod-label">
                    <label for="productDescription"> Product Description <span class="required-feilds">*</span> <span class="d-inline-block" data-toggle="tooltip" data-placement="right" title="Give a short description on the variety of the product, how long it takes to grow/mature, the best season for planting and the best soil type to be used in planting."><i class="bi bi-info-circle"></i></span> </label></label>
                     <textarea name="productDescription" name="productDescription" id="productDescription" class="form-control" placeholder="Give a short description on the variety of the product, how long it takes to grow/mature, the best season for planting and the best soil type to be used in planting." rows="8"></textarea>
                </div>
                
                <div class="inp_cont" id="inp_cont">
                    <div class="">
                        <div class="row row-cols-2 row-cols-lg-6 g-2 g-lg-2 col_rma m-0">
                            <div class="col col_sma ">
                                <div class="   ">
                                    <label for="firstname" class="input_form input_form_head">Package Size <i>(kg)</i>  </label>
                                </div>
                            </div>
                            <div class="col col_sma">
                                <div class=" ">
                                    <label for="firstname" class="input_form input_form_head">Quantity </label>
                                </div>
                            </div>
                            <div class="col col_sma">
                                <div class=" ">
                                    <label for="firstname" class="input_form input_form_head">Min Stock <span class="d-inline-block" data-toggle="tooltip" data-placement="right" title="Minimum quantity before restock."><i class="bi bi-info-circle"></i></span> </label></label>
                                </div>
                            </div>
                            <div class="col col_sma">
                                <div class=" ">
                                    <label for="firstname" class="input_form input_form_head">Unit Price (NGN) </label>
                                </div>
                            </div>
                            <div class="col col_sma">
                            </div>
                        </div>
                        <div class="row   row-cols-2 row-cols-lg-6 g-2 g-lg-2 mb-2 col_rma"  >
                            <div class="col col_sma">  
                                <div class="py-3 ">
                                    <input type="number" class="form-control   input_borderless " aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm" name="pkg_size">
                                </div>
                            </div>
                            <div class="col col_sma">   
                                <div class="py-3 "> 
                                    <input type="number" class="form-control   input_borderless " aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm" name="quantity">
                                </div>
                            </div>
                            <div class="col col_sma">
                                <div class="py-3 ">
                                    <input type="number" class="form-control   input_borderless " aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm" name="min_order">
                                </div>
                            </div>
                            <div class="col col_sma">
                                <div class="py-3 ">
                                    <input type="number" class="form-control   input_borderless " aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm" name="price">
                                </div>
                            </div>
                            <div class="col col_sma">    
                                <div class="p-3  ">
                                    <span class="add " id="_add"><i class=" fa fa-solid fa-plus"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="row row-cols-2 row-cols-lg-6 g-2 g-lg-2 mb-2 col_rma hidden input_number" id="input_number">
                            <div class="col col_sma">
                                <div class="py-3 ">
                                    <input type="number" class="form-control   input_borderless " aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm" name="pkg_size">
                                </div>
                            </div>
                            <div class="col col_sma">
                                <div class="py-3 ">
                                    <input type="number" class="form-control   input_borderless " aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm" name="quantity">
                                </div>
                            </div>
                            <div class="col col_sma">
                                <div class="py-3 ">
                                    <input type="number" class="form-control   input_borderless " aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm"  name="min_order">
                                </div>
                            </div>
                            <div class="col col_sma">
                                <div class="py-3 ">
                                    <input type="number" class="form-control   input_borderless " aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm"  name="price">
                                </div>
                            </div>
                            <div class="col col_sma">
                                <div class="p-3 ">
                                    <span id="_trash"><i class="fa fa-solid fa-trash-can _trash p_red"></i></span>
                                </div>
                            </div>
                        </div>
                     </div>
                </div> 
                
                <div class=" row py-4">
                <div class="col-lg-6 mx-auto">
                    <!-- Upload image input-->
                    <div class="input-group mb-3 px-2 py-2 rounded-pill bg-white shadow-sm">
                        <input id="upload" name="upload" onchange="filesChange(event.target.files); readURL(this)" type="file" class="form-control border-0" accept="image/*">
                        <label id="upload-label" for="upload" class="font-weight-light text-muted">Choose file</label>
                        <div class="input-group-append">
                            <label for="upload" class="btn btn-light m-0 rounded-pill px-4"> <i class="fa fa-cloud-upload mr-2 text-muted"></i><small class="text-uppercase font-weight-bold text-muted">Choose file</small></label>
                        </div>
                    </div>
                </div>
                    <div class="image-area col-lg-6">
                    <img id="imageResult" src="#" alt="" class="img-fluid rounded shadow-sm mx-auto d-block">
                </div>
            </div>                    
            </div>
            <hr>
            
            <div class="float-end">
            <div class="float-end m-2 mb-3">
                <button type="submit" class="btn btn-theme float-right submitBtn">Submit</button>                    
            </div>
        </form>
    </div>
</div>