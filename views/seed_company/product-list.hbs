<!-- Content Wrapper START -->
<div class="main-content">
  <div class="container">
    <div class="row  ">
      <div class="col-12   ">
        <a href="./products/create" class="btn create_p mb-2  float_end ">
          <span><i class=" fa fa-solid fa-plus"></i></span> Create New Product
        </a>
      </div>
    </div>
  </div>
  <div class=" container table-responsives table_t_info">
    <table class="table con t_info  table-borderless">
      <thead class="t_info_head ">
        <tr class="">
          <th scope="col">S/N</th>
          <th scope="col">Product Name</th>
          <th>Product Image</th>
          <th scope="col">Product Variety</th>
          <th scope="col">Local Name</th>
          <th scope="col">Status</th>
          <th scope="col"></th>
        </tr>
      </thead>

      {{#if product}}

      <tbody class="t_info_body products-list-table">

        {{#each product.result }}

        <tr class="t_info_row1">
          <th scope="row">{{increment @index}}</th>
          <td> {{ this.product_name }}</td>
          <td style="width: 150px;">
            <div class="table_img">
              <a href="/seed-company/products/{{this.id}}"><img src="../product_images/{{this.file_name}}"
                  alt="Product Image"></a>
            </div>
          </td>

          <td>{{ this.variant }}</td>
          <td>{{this.local_name}}</td>
          <td>
            <span class="{{#if this.status}} approved {{else}} pending {{/if}} px-1"><i class="bi bi-dot"></i>
              {{#if this.status}} Published {{else}} Pending {{/if}}
            </span>
          </td>
          <td><a href="#">
              <div class="dropdown d_t">
                <a class="btn   dropdown-toggle action_btn" href="#" role="button" id="dropdownMenuLink"
                  data-bs-toggle="dropdown" aria-expanded="false">
                  Actions
                </a>

                <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                  <li><a class="dropdown-item border-0 border-bottom" href="/seed-company/products/{{this.id}}">Update
                      Product</a></li>
                  <li><a class="dropdown-item border-0 border-bottom"
                      href="/seed-company/orders?product={{this.id}}">Related
                      Orders</a></li>
                  {{!-- <li><a class="dropdown-item" href="/seed-company/add-stock/{{this.id}}">Add Stock</a></li> --}}
                </ul>
              </div>
            </a></td>
        </tr>

        {{/each}}
      </tbody>

      {{/if}}

    </table>

    <div class="d-flex align-items-start flex-column">
      <nav aria-label="...">
        <ul class="pagination ml-auto p-2">
          <li class="page-item{{#if (eq pagination.page 0)}} disabled {{/if}}">
            <a class="page-link" href="?page={{pagination.previous}}" tabindex="-1">Previous</a>
          </li>
          {{#for 1 pagination.pageCount 1}}
          <li class="page-item "><a class="page-link page-count" href="?page={{#sub this 1}}{{this}}{{/sub}}">{{this}}</a></li>
          {{/for}}
          <li class="{{#if (or (eq pagination.page pagination.next) (eq pagination.pageCount 1))}} disabled {{/if}}page-item">
            <a class="page-link" href="?page={{pagination.next}}">Next</a>
          </li>

        </ul>
      </nav>

    </div>


  </div>
</div>
<script>
  //highlighting active page links in pagination **START**
    const urlParams = new URLSearchParams(window.location.search);
    let currentPage = parseInt(urlParams.get('page'));
    currentPage = currentPage + 1;
    $(".page-count").first().addClass("active-page");

    $(".page-count").each(function(index,element){
      let activePage = $(element).html();

      if (currentPage == activePage){
        $(".page-count").first().removeClass("active-page")
        $(element).addClass("active-page")
      } 

    })
 //highlighting active page links in pagination **END**

</script>