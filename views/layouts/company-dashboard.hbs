  <script>


    const success_toastr = (msg) => {
      Toastify({
        text: msg,
        duration: 4000,
        newWindow: true,
        close: true,
        gravity: "bottom", // `top` or `bottom`
        position: "left", // `left`, `center` or `right`
        backgroundColor: "linear-gradient(to bottom, #00b09b, #28a745)", //#00b09b #96c93d
        stopOnFocus: true, // Prevents dismissing of toast on hover
        onClick: function () { }, // Callback after click
      }).showToast();
    }

    const error_toastr = (msg) => {
      Toastify({
        text: msg,
        duration: 5000,
        newWindow: true,
        close: false,
        gravity: "top", // `top` or `bottom`
        position: "right", // `left`, `center` or `right`
        backgroundColor: "linear-gradient(to right, rgba(255,0,0,1), rgba(255,0,0,1))",
        stopOnFocus: true, // Prevents dismissing of toast on hover
        onClick: function () { }, // Callback after click
      }).showToast();
    }


    var files = null;
    $(document).ready(function () {
      $('#_add').on('click', function () {
        let len = $('.input_number').length
        if (len == 1 && $('.input_number').hasClass('hidden')) {
          $('.input_number').removeClass('hidden')
        } else if (len < 9) {
          $(".input_number")
            .first()
            .clone(true).removeClass('hidden')
            .appendTo($("#inp_cont"))

        } else {
          alert("You can't have more than 10 packages to a product");
        }

      });

      $("#_trash").on('click', function () {
        let len = $('.input_number').length
        if (len == 1 && !($('.input_number').hasClass('hidden'))) {
          $(this).closest('.row').addClass('hidden')
        } else if (len > 1) {
          $(this).closest(".row").remove()
        }
      })

      $('.states').on('click', function () {
        let url = window.location.origin + '/api/base/lgas/' + this.value
        fetch(url).then(r => r.json())
          .then(r => {
            let Options = '<option value="">Select LGA</option>'
            r.forEach(e => {
              Options += '<option value="' + e.id + '">' + e.name + '</option>'
            })
            document.querySelector('.lgas').innerHTML = Options
          }
          ).catch(e => {
            console.log(e)
          })
      })

      $('#form-product').on('submit', function () {
        event.preventDefault();
        $('.submitBtn').html('Please Wait...')
        const form = new FormData()
        let data = $('#form-product').serializeArray()
        form.append('upload', files);
        data.forEach(e => {
          if (e.value != null && e.value != "") {
            form.append(e.name, e.value)
          }
        })
        let url = window.location.origin + "/seed-company/products/create";
        productPosting(url, form)
      })
      $("#product-update-form").on('submit', function () {
        event.preventDefault()
        $('.submitBtn').html('Please Wait...')
        const form = new FormData()
        let id = window.location.pathname.split("/")
        id = id[id.length - 1]
        let url = window.location.origin + "/seed-company/products/update/" + id;
        form.append('upload', files);
        let data = $(this).serializeArray()
        data.forEach(e => {
          if (e.value != null && e.value != "") {
            form.append(e.name, e.value)
          }
        })
        productPosting(url, form)
      })
      //alert("my alert")

      $('#form-producer').on('submit', function () {
        event.preventDefault();
        $('.submitBtn').html('Please Wait...')
        const form = new FormData()
        let data = $('#form-producer').serializeArray()
        data.forEach(e => {
          if (e.value != null && e.value != "") {
            form.append(e.name, e.value)
          }
        })
        let url = window.location.origin + "/seed-company/seed-producers/create";
        producerPosting(url, form)
      })

      getCartCount()

    })

    function filesChange(file) {
      files = file[0];
    }

    $(function () {
      $('[data-toggle="tooltip"]').tooltip()
    })

    const getCartCount = () => {
      let url = window.location.origin + '/seed-company/orders/count/company'
      fetch(url, {
        method: 'GET'
      })
        .then(resp => resp.json())
        .then(json => {
          if (json.message > 0) {
            let notice = $('#noticeCount')
            notice.addClass('badge-danger')
            notice.css('background-color', 'red')
            notice.text(json.message)
          }
          // console.log(json)
        }).catch(error => {
          console.log(error)
        })
    }

    const productPosting = (url, form) => {
      fetch(url, {
        method: 'POST',
        body: form
      }).then(r => r.json())
        .then(r => {
          $('.submitBtn').html('Submit')
          if (r.statusCode === 402) {
            let msg = ''
            let errors = r.data
            errors.forEach((value, index) => {
              msg += (index + 1) + '.' + value.msg + ' \n'
            })
            error_toastr(msg)
          } else if (r.statusCode == 500 || r.statusCode == 400) {
            error_toastr(r.data)
          } else {
            success_toastr(r.message)

            setTimeout(function () {
              window.location = '/seed-company/products'
            }, 2000)
          }
        })
        .catch(e => {
          console.log(e)
        });
    }

    const producerPosting = (url, form) => {
      fetch(url, {
        method: 'POST',
        body: form
      }).then(r => r.json())
        .then(r => {
          $('.submitBtn').html('Submit')
          if (r.statusCode === 402) {
            let msg = ''
            let errors = r.data
            errors.forEach((value, index) => {
              msg += (index + 1) + '.' + value.msg + ' \n'
            })
            error_toastr(msg)
          } else if (r.statusCode == 500 || r.statusCode == 400) {
            error_toastr(r.data)
          } else {
            success_toastr(r.message)

            setTimeout(function () {
              window.location = '/seed-company/seed-producers'
            }, 2000)
          }
        })
        .catch(e => {
          console.log(e)
        });
    }
    $(document).ready(function () {

      /* change password*/
      let baseUrl = window.location.origin
      $('.btn_update_password').on('click', function () {
        let currentpassword = $('#currentpassword').val()
        let newpassword = $('#newpassword').val()
        let confirmpassword = $('#confirmpassword').val()
        let userphoneno = $('#userphoneno').val()
        console.log(userphoneno)

        const ch_pass_data = {
          'currentpassword': currentpassword,
          'newpassword': newpassword,
          'confirmpassword': confirmpassword,
          'userphoneno': userphoneno
        }

        let settingsurl = baseUrl + '/seed-company/settings'

        fetch(settingsurl, {
          method: 'POST',
          body: JSON.stringify(ch_pass_data),
          headers: { "Content-type": "application/json; charset=UTF-8" }
        })
          .then(r => r.json())
          .then(response => {
            if (response.statusCode == 402) {
              let msg = ''
              let errors = response.data
              errors.forEach((value, index) => {
                msg += (index + 1) + '. ' + value.msg + ' \n'
              })
              error_toastr(msg)

            } else if (response.statusCode == 500 || response.statusCode == 400) {
              error_toastr(response.message)
            } else {
              success_toastr(response.message)
              let currentpassword = $('#currentpassword').val('')
              let newpassword = $('#newpassword').val('')
              let confirmpassword = $('#confirmpassword').val('')
              document.querySelector('#btn_update_password').removeAttribute('enabled');
              document.querySelector('#btn_update_password').setAttribute('disabled', true);
            }
          })
          .catch(error => console.log(error))
      })
    })

  </script>
</body>

