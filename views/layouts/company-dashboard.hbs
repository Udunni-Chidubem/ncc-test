<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.1.1/jquery.min.js"></script>
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>    
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.1/chart.min.js"
      integrity="sha512-QSkVNOCYLtj73J4hbmVoOV6KVZuMluZlioC+trLpewV8qMjsWqlIQvkn1KGX2StWvPMdWGBqim1xlC8krl1EKQ=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    ></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.26.1/axios.min.js"></script>

   <script>

      const success_toastr = (msg) => {
        Toastify({
          text: msg,
          duration: 4000,
          newWindow: true,
          close: true,
          gravity: "bottom", // `top` or `bottom`
          position: "left", // `left`, `center` or `right`
          backgroundColor: "linear-gradient(to bottom, #00b09b, #28a745)", //#00b09b #96c93d
          stopOnFocus: true, // Prevents dismissing of toast on hover
          onClick: function () { }, // Callback after click
        }).showToast();
      }

       const error_toastr = (msg) => {
        Toastify({
          text: msg,
          duration: 5000,
          newWindow: true,
          close: false,
          gravity: "top", // `top` or `bottom`
          position: "right", // `left`, `center` or `right`
          backgroundColor: "linear-gradient(to right, rgba(255,0,0,1), rgba(255,0,0,1))",
          stopOnFocus: true, // Prevents dismissing of toast on hover
          onClick: function () { }, // Callback after click
        }).showToast();
      }

     
     var files = null;
     $(document).ready(function(){
        $('#_add').on('click', function(){
          let len = $('.input_number').length
          if(len == 1 && $('.input_number').hasClass('hidden')){
            $('.input_number').removeClass('hidden')
          }else if(len<4){
            $(".input_number")
            .first()
            .clone(true).removeClass('hidden')
            .appendTo($("#inp_cont"))
           
          }else{
             alert("You can't have more than 5 packages to a product");
          }
            
        });

        $("#_trash").on('click', function(){
           let len = $('.input_number').length
          if(len == 1 && !($('.input_number').hasClass('hidden'))){
            $(this).closest('.row').addClass('hidden')
          }else if(len>1){
            $(this).closest(".row").remove()
          }
        })

        $('.states').on('click', function(){
            let url =  window.location.origin+'/api/base/lgas/'+this.value
            fetch(url).then(r=>r.json())
            .then(r=>{
                let Options =  '<option value="">Select LGA</option>'
                r.forEach(e=>{
                    Options+='<option value="'+e.id+'">'+e.name+'</option>'
                })
                document.querySelector('.lgas').innerHTML=Options
            }
            ).catch(e=>{
                console.log(e)
            })
        })

        $('#form-product').on('submit', function(){
          event.preventDefault();
          $('.submitBtn').html('Please Wait...')
          const form = new FormData()
          let data = $('#form-product').serializeArray()
          form.append('upload', files);
          data.forEach(e=>{
            if(e.value != null && e.value != ""){
              form.append(e.name, e.value)
            }
          })
           let url = window.location.origin+"/seed-company/create-product";  
          fetch(url, {
            method:'POST',
            body : form
          }).then(r=>r.json())
          .then(r=> {
             $('.submitBtn').html('Submit')
            if(r.statusCode === 402){
                let msg = ''
                let errors = r.data
                errors.forEach((value, index) => {
                  msg += (index + 1 ) + '.' + value.msg + ' \n'
                })
                error_toastr(msg)
              }else if(r.statusCode == 500 || r.statusCode == 400){
                error_toastr(r.data)
              }else{

                success_toastr(r.message)

                setTimeout(function(){
                  window.location='product-list'
                }, 2000)
              }
          })
          .catch(e=>{
            console.log(e)
          });
          
        })
     })

    function filesChange(file){
        console.log(file[0])
        files = file[0];
    }
</script>
</body>
