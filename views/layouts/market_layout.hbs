<!DOCTYPE html>
<!-- Designined by CodingLab | www.youtube.com/codinglabyt -->
<html lang="en" dir="ltr">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title> NIGSIMS - {{ title }} </title>
  <link rel="stylesheet" href="../../../css/farmer_market_place.css">
  <link rel="stylesheet" href="../../../css/style.css">
  <link rel="stylesheet" href="../../../css/payment_page_preview.css">
  <link rel="stylesheet" href="../../../css/info.css">

  <!-- Boxiocns CDN Link -->
  <!-- <link href='https://unpkg.com/boxicons@2.0.7/css/boxicons.min.css' rel='stylesheet'> -->
  <link href='https://unpkg.com/boxicons@2.1.2/css/boxicons.min.css' rel='stylesheet'>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css"
    integrity="sha512-KfkfwYDsLkIlwQp6LFnl8zNdLGxu9YAA1QvwINks4PhcElQSvqcyVLLD9aMhXd13uQjoXtEKNosOWaZqXgel0g=="
    crossorigin="anonymous" referrerpolicy="no-referrer" />

</head>


<body class="body">

  <header>
    <nav class="navbar navbar-defaults navbar-expand-lg fixed-top  navbar-dark  ">
      <div class="container-fluid">
        <a class="navbar-brand navbar-heading" href="#">{{ title }}</a>
        <button class="navbar-toggler mbar" type="button" data-bs-toggle="collapse"
          data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false"
          aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <span class="navbar-toggler sidebar_arrow"> <i class="bi bi-arrow-left-circle-fill"></i></span>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav ms-auto mls-auto mb-2 mb-lg-0">

            <li class="nav-item">
              <a class="nav-link" href="#">{{ fullname }}</a>
            </li>
            <li class="nav-item">
              <a class="nav-link  " href="#"><i class="bi bi-bell"></i>
                <!-- <span class="notrifications"></span> -->
              </a>
            </li>
            <li class="nav-item">

            </li>


          </ul>

        </div>
      </div>
    </nav>
  </header>
  <aside class="sidebar close ">

    <div>
      <div class="sidebar-menu-bar">
        <i class='bx bx-menu side-bx-menu'></i>
      </div>
      <div class="mobile-logo-details">
        <img src="../../../images/dashboard_logo.png" alt="nigsims-logo">
      </div>
      <ul class="nav-links">
        {{!-- <h4 class="nav-links">Adamu Garba </h4> --}}
        <li>
          <a href="/farmer/dashboard">
            <i class='bx bx-grid-alt'></i>
            <span class="link_name">Dashboard</span>
          </a>
        </li>

        <li>
          <a href="{{#if isVerified }} # {{else}} /farmer/update-profile {{/if}}">
            <i class='bx bx-user'></i>
            <span class="link_name">Profile

              {{#if isVerified }}
              <span class="p_red">(Unverified)</span>
              {{/if}}

            </span>
          </a>

        </li>

        {{#unless isVerified }}
        <li>
          <a href="/farmer/market_place/type/sorting">
            <i class='bx bx-cart-add'></i>
            <span class="link_name">Market Place</span>
          </a>

        </li>
        <li>
          <a href="#">
            <i class='bx bx-purchase-tag'></i>
            <span class="link_name">Transaction</span>
          </a>

        </li>
        <li>
          <a href="#">
            <i class='bx bx-library'></i>
            <span class="link_name">Knowledge Base</span>
          </a>

        </li>
        <li>
          <a href="#">
            <i class='bx bx-help-circle'></i>
            <span class="link_name">Help</span>
          </a>

        </li>

        <li id="settings">
          <a href="#">
            <i class='bx bx-cog'></i>
            <span class="link_name">Settings</span>
          </a>

        </li>
        {{/unless}}

        <li>
          <form method="post" action="/logout?_method=DELETE">
            <button type="submit">
              <i class='bx bx-log-out'></i>
              <span class="link_name">Log Out</span>
            </button>
          </form>
        </li>


      </ul>
    </div>
  </aside>


  <div class="home">

    <div class="page-header">
      <div class="header-sub-title">
        <nav class="breadcrumb breadcrumb-dash">
          <a href="/farmer/dashboard" class="breadcrumb-item"><i class="fa fa-home m-r-5"></i> Home</a>
          <a class="breadcrumb-item " href="#">{{ title }}</a>
          <span class="breadcrumb-item active">{{ sub_title }}</span>
        </nav>
      </div>
    </div>

    {{{body}}}
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p"
    crossorigin="anonymous"></script>
  <script src="//code.jquery.com/jquery-1.11.1.min.js"></script>

  <script src="../../../js/script.js"></script>
  <script src="../../../js/payment_page_preview.js"></script>

  <!--Start of Tawk.to Script-->
