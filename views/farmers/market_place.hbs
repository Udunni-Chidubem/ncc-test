<div class="container-fluid pt=5">
  <div class="card card-4">
    <div class="card-body">
      {{#if message}}
        <div
          class="alert alert-danger alert-dismissible fade show"
          role="alert"
        >
          {{message}}
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Close"
          ></button>
        </div>
      {{/if}}
      <form method="get" class="ml-5 mr-4 search-form">
        <div class="input-group">
          <input
            class="input--style-4 inputs"
            type="search"
            placeholder="Search for product"
            name="Search"
            required
          />
          <div class="input-group-append min-search-btn">
            <button class="btn btn-secondary btn--blue" type="submit"><i
                class="fa fa-search"
              ></i></button>
          </div>
          <button
            class="btns btn--radius-2 btn--blue ml-2 pri-search-btn"
            type="submit"
          >Search</button>
        </div>
        {{#if products}}
          <div class="search-filter ml-5 mr-4 mt-2">
            <div class="input-field">
              <label><b>Results: &nbsp; </b> Sort By</label>
              <select name="sorting">
                <option value="" disabled selected>Choose your option</option>
                <option value="highest-price">Highest Price</option>
                <option value="lowest-prices">Lowest Price</option>
              </select>
            </div>
          </div>
        {{/if}}

      </form>
    </div>

  </div>

  {{#ifNotEquals products.status 1}}

    <section class="products">
      {{#each products.result}}
        <div class="card products-card">
          <div class="card-body products-content">
            <div class="product-img">
              <img
                src="../../product_images/{{this.file_name}}"
                alt="Product Image"
              />
            </div>
            <div class="product-info">
              <div class="product-details">
                <h4 class="product-name">{{this.product_name}}</h4>
                <p class="product-variant">Variety: {{this.variant}}</p>
                <p class="product-seller">Seller:
                  {{"User.SeedCompany.name_of_company"}}</p>
                <p class="product-location">Location:
                  {{"User.SeedCompany.State.name"}}
                  State</p>
              </div>
              <div class="product-price">
                <p>Unit Price per KG</p>
                <h4 class="price_{{this.id}}"></h4>
                <p>Choose Qty (kg)</p>
                <div class="input-field product-size">
                  <select id="{{this.id}}" class="size">
                    <option value="">Choose Qty</option>
                    {{#json this.item}}
                      {{#each this.pkg}}
                        <option index="{{@index}}" value="{{this}}">{{this}}
                          kg</option>
                      {{/each}}
                    {{/json}}
                  </select>
                </div>

                <p style="margin-bottom: 10px;">Select Amount</p>
                <div class="input-group">
                  <span class="input-group-btn">
                    <button
                      type="button"
                      class="quantity-left-minus btn btn-count btn-number"
                      disabled="true"
                      data-type="minus"
                      data-field=""
                    >
                      <span class="fa fa-minus"></span>
                    </button>
                  </span>
                  <input
                    type="text"
                    id="quantity"
                    name="quantity"
                    class="input-number"
                    value="1"
                    min=""
                    max="{{this.quantity}}"
                  />
                  <span class="input-group-btn">
                    <button
                      disabled="true"
                      type="button"
                      class="quantity-right-plus btn btn-count btn-number"
                      data-type="plus"
                      data-field=""
                    >
                      <span class="fa fa-plus"></span>
                    </button>
                  </span>
                </div>
              </div>
            </div>
            <div class="product-actions">
              <button
                class="btn btn-place-order"
                onclick="window.location.href='/farmer/products/{{this.id}}'"
              ><i class="fa fa-eye"></i> View Product</button>
              <button
                class="btn btn-save-product add-to-cart"
                data-prodid="{{this.id}}"
              > <i class="bx bx-cart-add"></i>Add to Cart</button>
            </div>
          </div>
        </div>

      {{/each}}
      <div class="row m-5">
        <div class="col-sm-12 col-md-4 d-flex justify-content-start">
          <div
            class="dataTables_info"
            id="contactList_info"
            role="status"
            aria-live="polite"
          >
            Showing
            {{#eval products.currentPage size}}
              {{this}}
            {{/eval}}
            to
            {{products.result.length}}
            of
            {{products.totalItems}}
            entries
          </div>
        </div>
        <div class="col-sm-12 col-md-8 d-flex justify-content-end">
          {{! <span style="margin: 5px">Size</span>
          <select
            style="width: 100px; margin: 5px"
            name=""
            id=""
            class="form-control"
          ></select> }}
          <div
            class="dataTables_paginate paging_simple_numbers"
            id="contactList_paginate"
          >
            <ul class="pagination">
              <li
                :class="[
              selectedPage == 0
                ? 'disabled paginate_button page-item previous'
                : 'paginate_button page-item previous',
            ]"
                id="contactList_previous"
              >
               
                  <button
                    onclick="previousPage({{products.currentPage}})"
                    aria-controls="contactList"
                    data-dt-idx="0"
                    tabindex="0"
                    class="page-link"
                  >
                    Previous
                  </button>
              
              </li>
            
              {{#numToArray products.totalPages}}
                {{#each this}}
                  <li
                class="'paginate_button page-item active"
              >
                <button
                  onclick="goTo({{this}})"
                  aria-controls="contactList"
                  data-dt-idx="1"
                  tabindex="0"
                  class="page-link"
                >
                  {{ this }}
                </button>
                </li>
               {{/each}}
              {{/numToArray}}
              
              {{!-- <li
                class="disabled paginate_button page-item next"
                id="contactList_next"
              > --}}
           
                <button
                 onclick="nextPage({{products.currentPage}}, {{products.totalPages}})"
                  aria-controls="contactList"
                  data-dt-idx="2"
                  tabindex="0"
                  class="page-link"
                >
                  Next
                </button>
             
              </li>
            </ul>
          </div>
          <span style="margin: 5px">Go To</span>
          <select
            style="width: 100px"
            name=""
            id=""
            class="form-control"
            onchange="goTo(event.target.value)">
            {{#numToArray products.totalPages}}
              {{#each this}}
                  <option value="{{this}}">
                    {{this}}
                  </option>
                {{/each}}
            {{/numToArray}}
          </select>
        </div>
      </div>
    </section>

  {{else}}
    <br /><br /><br />
    <center><i
        class="fa fa-search"
        style="font-size:133px;color:#C2CFE0;"
      ></i></center>
    <br />

    <div
      class="paragraph"
      style="color: #34AFF9; text-align: center; size: 18px;height: 27px; font-size:medium;"
    >
      What are you looking for ?
    </div>
  {{/ifNotEquals}}

</div>

<script>
  function previousPage(currentPage){ 
    let url=window.location.toString()
    if(currentPage>1){

    if(url.includes("?")){
      window.location=url+'page='+(currentPage-1); 
    } else{
      window.location=url+'?page='+(currentPage-1); 
    } 
    }
 
  } 
  function goTo(event){
    let url=window.location.toString()
    if(url.includes("?")){
      window.location=url+'page='+event; 
    } else{
      window.location=url+'?page='+event; 
    } 
  }
  function nextPage(currentPage, totalPages){
     let url=window.location.toString()
    if(currentPage<totalPages){
    if(url.includes("?")){
      window.location=url+'page='+(currentPage+1); 
    } else{
      window.location=url+'?page='+(currentPage+1); 
    } 
    }
   
  }
</script>