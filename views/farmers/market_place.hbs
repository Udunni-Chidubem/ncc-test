<div class="container-fluid pt=5">
        <div class="card card-4"> 
            <div class="card-body">
                <form method="get" class="ml-5 mr-4">
                    <div class="input-group">
                        <input class="input--style-4 inputs" type="search" placeholder="Search for product" name="Search" required>  
                        <button class="btns btn--radius-2 btn--blue ml-2" type="submit">Search</button>
                    </div>

                    <div class="search-tip">
                        <p ><i class="fa fa-lightbulb"></i> tip: You need 3kg of maize seed for your farm</p>
                    </div>
                
                {{#if products}}
                <div class="search-filter ml-5 mr-4 mt-2">
                      <div class="input-field">
                        <label><b >Results: &nbsp; </b> Sort By</label>
                        <select name="sorting">
                          <option value="" disabled selected>Choose your option</option>
                          <option value="highest-price">Highest Price</option>
                          <option value="lowest-prices">Lowest Price</option>
                        </select>
                      </div>
                </div>
                {{/if}}

                </form>
            </div>
                
        </div> 


