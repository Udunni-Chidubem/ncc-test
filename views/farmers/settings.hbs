            <div class="card settings_ active content password">
                <div class="card-body">
                    <div class="input-group mb-3">
                        <input type="password" required minlength="6" id="currentpassword" class="form-control"
                            name="currentpassword" placeholder="Current Password" aria-label="Current Password"
                            aria-describedby="basic-addon1" onkeyup='check();'>
                    </div>
                    <div class="input-group mb-3">
                        <input type="password" minlength="6" class="form-control" id="newpassword" name="newpassword"
                            placeholder="New Password" aria-label="New Password" aria-describedby="basic-addon1"
                            onkeyup='check();'>
                    </div>
                    <div class="input-group mb-3">
                        <input type="password" required minlength="6" class="form-control" id="confirmpassword"
                            name="confirmpassword" placeholder="Retype New Password" aria-label="Confirm Password"
                            aria-describedby="basic-addon1" onkeyup='check();'>
                    </div>
                    <div class="input-group mb-3">
                        <input type="hidden" class="form-control" id="userphoneno" value="{{farmerData.phone_no}}"
                            name="userphoneno" aria-label=" User Phoneno" aria-describedby="basic-addon1">
                    </div>
                    <span id='message'></span>
                    <div class="col-12  ">
                        <div class="columns mx-auto" style="width: 160px;">
                            <button class="btn btn_update_password mb-1" disabled id="btn_update_password">
                                Update</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    //tab toggle
    const btns = document.querySelectorAll(".tab_info_");
    const card = document.querySelectorAll(".content");

    function tab(obj) {
        const id = obj.getAttribute('id');
        //console.log(id)
        if (id) {
            btns.forEach(function (btn) {
                btn.classList.remove("active");
            });
            obj.classList.add("active");
            card.forEach(function (table) {
                table.classList.remove("active");
            });
            const element = document.querySelector('.' + id);
            element.classList.add("active");
        }
    }

    //password retype
    var check = function () {
        if (document.getElementById('newpassword').value ==
            document.getElementById('confirmpassword').value) {
            document.getElementById('message').style.color = 'green';
            document.getElementById('message').innerHTML = 'Password matching';
            document.querySelector('#btn_update_password').removeAttribute('disabled');
            document.querySelector('#btn_update_password').setAttribute('enabled', true);
        } else {
            document.getElementById('message').style.color = 'red';
            document.getElementById('message').innerHTML = 'Password not matching';
            document.querySelector('#btn_update_password').removeAttribute('enabled');
            document.querySelector('#btn_update_password').setAttribute('disabled', true);
        }
    }
</script>