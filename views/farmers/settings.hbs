<div class="container">
    <div class="row _settings">
        <div class="col-3">
            <ul class="list-group">
                <li class="list-group-item active tab_info_" id="password" aria-current="true" onclick="tab(this)">
                    Password and Security
                </li>
                <li class="list-group-item  tab_info_" id="account" onclick="tab(this)">
                    Deactivate Account
                </li>
            </ul>
        </div>
        <div class="col-9">

            {{#if password_change_status}}
            <div class="row d-flex justify-content-center">
                <div class="col-12 alert alert-success">
                    {{password_change_status}}
                </div>
            </div>
            {{/if}}
            {{#if messages.error}}
            <div class="row d-flex justify-content-center">
                <div class="col-12 alert alert-danger">
                    {{messages.error}}
                </div>
            </div>
            {{/if}}
            {{#if message}}
            <div class="row d-flex justify-content-center">
                <div class="col-12 alert alert-danger">
                    {{message}}
                </div>
            </div>
            {{/if}}
            {{#if errors.length}}
            <div class="row d-flex justify-content-center">
                <div class="col-12 alert alert-danger">
                    <ul>
                        {{#each errors}}
                        <li>{{this.message}}</li>
                        {{/each}}
                    </ul>
                </div>
            </div>
            {{/if}}

            {{#if extractedErrors}}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <ul style="padding: 5px;">
                    {{#each extractedErrors}}
                    <li>{{msg}}</li>
                    {{/each}}
                </ul>
            </div>
            {{/if}}

            <div class="card settings_  content account">
                <div class="card-body">
                    Deactivate Account
                </div>
            </div>
            <div class="card settings_ active content password">
                <div class="card-body">
                    <form action="" method="post">
                        <div class="input-group mb-3">
                            <input type="password" value="{{ formData.phone }}" required minlength="6"
                                class="form-control" name="currentpassword" placeholder="Current Password"
                                aria-label="Current Password" aria-describedby="basic-addon1">
                        </div>
                        <div class="input-group mb-3">
                            <input type="password" value="{{ formData.phone }}" minlength="6" class="form-control"
                                id="newpassword" name="newpassword" placeholder="New Password" aria-label="New Password"
                                aria-describedby="basic-addon1" onkeyup='check();'>
                        </div>
                        <div class="input-group mb-3">
                            <input type="password" value="{{ formData.phone }}" required minlength="6"
                                class="form-control" id="confirmpassword" name="confirmpassword"
                                placeholder="Retype New Password" aria-label="Confirm Password"
                                aria-describedby="basic-addon1" onkeyup='check();'>
                        </div>
                        <div class="input-group mb-3">
                            <input type="hidden" class="form-control" value="{{farmerData.phone_no}}" name="userphoneno"
                                aria-label=" User Phoneno" aria-describedby="basic-addon1">
                        </div>
                        <span id='message'></span>
                        <div class="col-12  ">
                            <div class="columns mx-auto" style="width: 160px;">
                                <button type="button float-end" class="btn  mb-1">Update</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    //tab toggle
    const btns = document.querySelectorAll(".tab_info_");
    const card = document.querySelectorAll(".content");

    function tab(obj) {
        const id = obj.getAttribute('id');
        //console.log(id)
        if (id) {
            btns.forEach(function (btn) {
                btn.classList.remove("active");
            });
            obj.classList.add("active");
            card.forEach(function (table) {
                table.classList.remove("active");
            });
            const element = document.querySelector('.' + id);
            element.classList.add("active");
        }
    }

    //password retype
    var check = function () {
        if (document.getElementById('newpassword').value ==
            document.getElementById('confirmpassword').value) {
            document.getElementById('message').style.color = 'green';
            document.getElementById('message').innerHTML = 'Password matching';
        } else {
            document.getElementById('message').style.color = 'red';
            document.getElementById('message').innerHTML = 'Password not matching';
        }
    }
</script>