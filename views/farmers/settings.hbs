<div class="container">
    <div class="row _settings">
        <div class="col-3">
            <ul class="list-group">
                <li class="list-group-item active tab_info_" id="password" aria-current="true" onclick="tab(this)">
                    Password and Security
                </li>
                <li class="list-group-item  tab_info_" id="account" onclick="tab(this)">
                    Deactivate Account
                </li>
            </ul>
        </div>


        <div class="col-9">

            {{#if password_change_status}}
            <div class="row d-flex justify-content-center">
                <div class="col-12 alert alert-success">
                    {{password_change_status}}
                </div>
            </div>
            {{/if}}
            {{#if messages.error}}
            <div class="row d-flex justify-content-center">
                <div class="col-12 alert alert-danger">
                    {{messages.error}}
                </div>
            </div>
            {{/if}}
            {{#if message_}}
            <div class="row d-flex justify-content-center">
                <div class="col-12 alert alert-danger">
                    {{message_}}
                </div>
            </div>
            {{/if}}
            {{#if errors.length}}
            <div class="row d-flex justify-content-center">
                <div class="col-12 alert alert-danger">
                    <ul>
                        {{#each errors}}
                        <li>{{this.message}}</li>
                        {{/each}}
                    </ul>
                </div>
            </div>
            {{/if}}

            {{#if extractedErrors}}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <ul style="padding: 5px;">
                    {{#each extractedErrors}}
                    <li>{{msg}}</li>
                    {{/each}}
                </ul>
            </div>
            {{/if}}

