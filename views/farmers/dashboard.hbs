
 <div class="container">
    <div class="row">
      <div class="col-12">
        <div class="card shadow card_home pl-0 mb-2 ">
          <div class="card-body">
             <div class="row">
               <div class="col-12">
                 <h4>Welcome, {{ fullname }}!</h4>
               </div>

               {{#if isVerified }}
                <div class="row">
                  <div class="col-6 profile_sub"><p>Kindly set up your profile to continue using NIGSIMS</p></div>
                  <div class="col-6">
                    <div class="float-end">
                      <a href="/farmer/update-profile" class="btn button_update mb-1">Update Profile</a>
                    </div>
                  </div>
                </div>

               {{/if}}

             </div>
            </div>
          </div>
      </div>
    </div>


{{#unless isVerified}}

<div class="card card_home shadow-lg  produce mb-2 ">
