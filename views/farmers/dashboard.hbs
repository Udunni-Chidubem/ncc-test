 <div class="container  ">
    <div class="row">
      <div class="col-12">
        <div class="card shadow card_home pl-0 mb-2 ">
          <div class="card-body">
             <div class="row">
               <div class="col-12">
                 <h4>Welcome, {{ fullname }}!

                 </h4>
               </div>

               {{#if isVerified }}
                <div class="row">
                  <div class="col-6 profile_sub"><p>Kindly set up your profile to continue using NIGSIMS</p></div>
                  <div class="col-6">
                    <div class="float-end">
                      <a href="/farmer/update-profile" class="btn button_update mb-1">Update Profile</a>
                    </div>
                  </div>
                </div>

               {{/if}}

             </div>
            </div>
          </div>
      </div>
    </div>


{{!-- {{#unless isVerified}} --}}

<div class="card card_home shadow-lg  produce mb-2 pb-0 ">
      <div class="card-body">
         <div class="row mb-1" >
           <div class="col-12">
             <span> <img src="../../images/ep_map-location.png" alt=""> </span>
             <span>{{ lga }}, {{ state }}</span>
           </div>
         </div>

         <div class="row f_1 row-cols-2 row-cols-lg-5 g-2 g-lg-3">
          <div class="col-3">
            <div class="">
              <p>Size of Land
              </p>
            </div>
          </div>
          <div class="col-6">
            <div class="">
              <p>Crops Farmed</p>
            </div>
          </div>
          </div>

          <div class="row f_2 row-cols-2 row-cols-lg-5 g-2 g-lg-3">
            <div class="col-3">
              <div class="">
                <p>{{ farmer.farm_size }}</p>
              </div>
            </div>
            <div class="col-6">
              <div class=" ">
                <ul class=" ul_list_item    " >
                  {{#farmer.product_farmed}}
                    <li class=" list_item ">{{this}}</li>
                  {{/farmer.product_farmed}}
            </ul>
              </div>
            </div>
            </div>
        </div>
      </div>

      <div class="card shadow-lg card_home mb-2 weather">
        <div class="card-body">
           <div class="row">
             <div class="col-12 head">
               <h4>WEATHER FORECAST</h4>
             </div>
           </div>

           <div class="container">
            <div class="row row-cols-2 row-cols-lg-6 g-2 g-lg-4">
              <div class="col _col">
                <div class="p-3 pt-1 pb-1  weather_sub">
                  <p>22oC - 32oC</p>
                  <p><img src="../images/Drizzle.png" alt=""></p>
                  <p>TODAY</p>
                  <p>23 MARCH</p>
                </div>
              </div>
              <div class="col _col">
                <div class="p-3 pt-1 pb-1  weather_sub">
                  <p>22oC - 32oC</p>
                  <p><img src="../images/Sunny.png" alt=""></p>
                  <p>TODAY</p>
                  <p>23 MARCH</p>
                </div>
              </div>
              <div class="col _col">
                <div class="p-3 pt-1 pb-1  weather_sub">
                  <p>22oC - 32oC</p>
                  <p><img src="images/Partly-cloudy.png" alt=""></p>
                  <p>TODAY</p>
                  <p>23 MARCH</p>
                </div>
              </div>
              <div class="col _col">
                <div class="p-3 pt-1 pb-1  weather_sub">
                  <p>22oC - 32oC</p>
                  <p><img src="../images/Drizzle.png" alt=""></p>
                  <p>TODAY</p>
                  <p>23 MARCH</p>
                </div>
              </div>
              <div class="col _col">
                <div class="p-3 pt-1 pb-1  weather_sub">
                  <p>22oC - 32oC</p>
                  <p><img src="../images/Drizzle.png" alt=""></p>
                  <p>TODAY</p>
                  <p>23 MARCH</p>
                </div>
              </div>
              <div class="col _col">
                <div class="  pt-1 pb-1   ">
                  <div class=" ">
                    <button type="button" class="btn weather_button_update mb-1">Rainy Season</button>
                  </div>
                </div>
              </div>
               
            </div>
          </div>
          </div>
        </div>

        <div class="row">
              <div class="col-12">
                <div class="card shadow card_home  pl-0 mt-3 mb-2 ">
                  <div class="card-body card_comps">
                    <div class="row row-cols-2  card_comp row-cols-lg-4 g-2 g-lg-2">
                      <div class="col-lg-3 col-md-6 col-sm-6 ">
                        <div class="p-3 border sal_bac card_dis text-center border-0 border-end">
                          <h5 class="c_d_s2 c_d_s2_sale sales">Total Purchases </h5>
                          <h1 class="c_d_s2_sales ">{{transactionCount}}</h1>
                        </div>
                      </div>
                      <div class="col-lg-3 col-md-6 col-sm-6 ">
                        <div class="p-3 border text-center border-0 border-end">
                          <h5 class="c_d_s2">Items In Cart</h5>
                          <h1 class="c_d_s2_full ">{{cartCount}}</h1>
                        </div>
                      </div>
                      <div class="col-lg-3 col-md-6 col-sm-6 ">
                        <div class="p-3 border text-center border-0 border-end">
                          <h5 class="c_d_s2 orders">Orders</h5>
                          <h1 class=" c_d_s2_unfull">{{transactionCount}}</h1>
                        </div>
                      </div>
  
                {{transactions.TransactionCarts}}
                      <div class="col-lg-3 col-md-6 col-sm-6 ">
                        <div class="p-3 border text-center border-0 border-end">
                          <h5 class="c_d_s2">Completed</h5>
                          {{#if (eq transactionStatus.status "3")}}
                            <h1 class=" c_d_s2_unfull">{{transactionCount}}</h1>
                            {{else}}
                            <h1 class=" c_d_s2_unfull">0</h1>                            
                          {{/if}}
                        </div>
                      </div>
                      </div>
          
                    </div>
                  </div>
              </div>
   

              <div class="container-fluid  ">
                
  
              <div class="card card_home mb-2 summary_tran">
                <div class="card-body">
                   <div class="row">
                     <div class="col-12">
                       <h4>Transaction Summary</h4>
                     </div>
                   </div>
      
                   <div class="row">
                    <div class="col-12 summary_sub">
                      <table class="table con t_info table_info card_tab table-responsives table-borderless" id="transactionTable">
                        <thead class="t_info_head ">
                          <tr class="">
                            <th scope="col">S/N</th>
                            <th scope="col">Order ID</th>
                            <th scope="col">STATUS</th>
                            <th scope="col"></th>
                          </tr>
                        </thead>
                        <tbody class="t_info_body">
                          {{#each transactions}}
                          <tr class="t_info_row1">
                            <th scope="row"  >{{#add @index 1}} {{this}} {{/add}}</th>
                            <td>{{this.transaction_id}}</td>
                            <td><span class=" "> <span class="process px-1"><i class="bi bi-dot"></i>  {{status}}</span> 
                            <br>
                            <span class="mt-1"> Paid on {{dateFormat this.created_at "dddd, MMMM Do YYYY"}}</span> 
                            </td>
                            <td><a href="#">See Details</a></td>
                          </tr>
                          {{/each}}
                        </tbody>
                      </table>
                    </div>
                  </div>
                  </div>
                </div>

                
              </div>
              
  

    </div>


{{!-- {{/unless}} --}}

</div>

