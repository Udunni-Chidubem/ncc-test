  <form method="POST" id="updateProfile">
  <div class=" ">
        <div class="row">
            <div class="col-12">
                <div class="card card_home rounded mx-auto shadow pl-0 mb-2 profile-card">
                    <div class="card-body bg-light">
                     
                      <div class="row row-cols-5 row-cols-lg-1 g-2 g-lg-2">
                        
                        <div class="col-12">
                         
                          <div class="p-3">
                            <h5 class="card-header card-c p-0 mb-3 bg-light profile_header">Personal Information</h5>
                          <img src="../images/farmer-with-vege-p-2000.jpeg" class=" mb-2 mx-auto d-block img_round" alt="...">
                             <div class="row">
                                <div class="col-sm-6">
                                  <label for="firstname" class="input_form">First name <span class="profile_sub">*</span> </label>
                                    <div class="input-group input-group-sm mb-3">
                                      <input type="text" readonly required id="firstname" name="firstname" value="{{ farmerData.firstname }}" class="form-control border-0 border-bottom  input_borderless" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm">
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                  <label for="lastname" class="input_form">Last name <span class="profile_sub">*</span> </label>
                                  <div class="input-group input-group-sm mb-3">
                                    <input type="text" readonly required id="lastname" name="lastname" value="{{ farmerData.lastname }}" class="form-control border-0 border-bottom" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm">
                                  </div>
                              </div>
                             </div>

                             <div class="row">
                              <div class="col-sm-6">
                                <label for="dob" class="input_form">Date of Birth </label>
                                  <div class="input-group input-group-sm mb-3">
                                    <input
                                        style="color:rgb(58, 56, 56);"
                                        width="312"
                                        type="numeric" 
                                        class="form-control border-0 border-bottom" 
                                        aria-label="Sizing example input" 
                                        aria-describedby="inputGroup-sizing-sm"
                                        name="date_of_birth"
                                        placeholder="dd/mm/yyyy"
                                        data-date-format="dd/mm/yyyy"
                                        id="dob"
                                        max="2019-12-31"
                                        data-dob="{{ farmerData.date_of_birth }}"
                                    />
                                  </div>
                                  <script>
                                        $('#dob').datepicker({
                                            uiLibrary: 'materialdesign',
                                            format:  'mm/dd/yyyy',
                                            maxDate: '12/12/2010',
                                            value: '01/01/2010',
                                            keyboardNavigation: true,
                                            // modal: true, 
                                            // header: true, 
                                            // footer: true
                                        })
                                    </script>
                              </div>

                              <div class="col-sm-6">
                                <label for="gender" class="input_form">Gender <span class="profile_sub">*</span></label>
                                <div class="input-group mb-3">
                                  <select name="gender" required class="form-select border-0 border-bottom gender" id="gender" data-gender="{{ farmerData.gender }}">
                                    <option value="">Gender</option>
                                  </select>
                                </div>
                            </div>
                           </div>


                           <div class="row">
                            <div class="col-sm-6" >
                                <div class="input-group input-group-sm mb-3">
                                  
                                  <label for="state" required class="input_form">State <span class="profile_sub">*</span></label>
                                <div class="input-group mb-3">
                              
                                  <select class="form-select border-0 border-bottom" data-state="{{ farmerData.state_id }}" id="state" name="state_id">                                    
                                    <option value="">Select State</option>
                                    {{#each states}}
                                        <option value="{{this.id}}">{{this.name}}</option>
                                    {{/each}}
                                  </select>
                                </div>

                                </div>
                            </div>

                            <div class="col-sm-6">
                              <div class="input-group input-group-sm mb-3">
                                
                                <label for="lga" class="input_form">LGA <span class="profile_sub">*</span></label>
                                <div class="input-group mb-3">
                              
                                  <select required class="form-select border-0 border-bottom" id="lgas" data-lga="{{ farmerData.lg_id }}" name="lg_id">
                                     <option value=""></option>
                                  </select>
                                </div>

                              </div>
                          </div>
                         </div>

                         <div class="row">
                              <div class="col-sm-6">
                                <label for="nin" class="input_form">NIN</label>
                                <div class="input-group input-group-sm mb-3">
                                  <input 
                                    type="password"
                                    id="nin"
                                    title="It should contain 11digits only"
                                    minlength="11"
                                    maxlength="11"
                                    class="form-control border-0 border-bottom bi bi-eye-slash" 
                                    aria-label="Sizing example input" 
                                    aria-describedby="inputGroup-sizing-sm"
                                    name="nin" value="{{ farmerData.nin }}">
                                </div>
                            </div>

                            <div class="col-sm-6" class="input_form">
                                <label for="bvn" class="input_form">BVN</label>
                                  <div class="input-group input-group-sm mb-3">
                                    <input 
                                        type="password"
                                        id="bvn"
                                        pattern="[0-9]{11}$"
                                        title="It should contain 11digits only"
                                        minlength="11"
                                        maxlength="11"
                                        class="form-control border-0 border-bottom" 
                                        aria-label="Sizing example input" 
                                        aria-describedby="inputGroup-sizing-sm"
                                        name="bvn" value="{{ farmerData.bvn }}"
                                            />
                                  </div>
                              </div>
                           </div>


                           <div class="row">

                              <div class="col-sm-6" class="input_form">
                               <label for="education" class="input_form">Level of Education <span class="profile_sub">*</span></label>
                                  <div class="input-group input-group-sm mb-3">
                                    <select name="level_of_education" required class="form-select border-0 border-bottom" id="levelE" data-level="{{ farmerData.level_of_education }}">
                                      <option value="">Select One</option>
                                    </select>
                                  </div>
                            </div>

                              <div class="col-sm-6">
                                <label for="nin" class="input_form">Farm Produce</label>
                                <div class="input-group input-group-sm mb-3">
                                      <select class="js-example-basic-multiple form-control border-0 border-bottom" required name="farm_produce" multiple="multiple" id="farmProduce" value="{{ farmerData.product_farmed }}">
                                      </select>
                                </div>
                            </div>

                           </div>



                           <div class="row">

                              <div class="col-sm-6" class="input_form">
                               <label for="education" class="input_form">Phone Number</label>
                                  <div class="input-group input-group-sm mb-3">
                                      <input type="text" readonly required id="phone_no" name="phone_no" value="{{ farmerData.phone_no }}" class="form-control border-0 border-bottom  input_borderless" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm">

                                  </div>
                            </div>

                              <div class="col-sm-6"> </div>

                           </div>

                           <br/>

                         <h5 class="card-header card-c p-0 bg-light profile_header">Delivery Information</h5>
                          
                         <div class="row">
                          <div class="col-sm-6">
                              <div class="input-group input-group-sm mb-3">                              
                                <label for="state" class="input_form">State <span class="profile_sub">*</span></label>
                                <div class="input-group mb-3">
                              
                                  <select 
                                    class="form-select border-0 border-bottom" 
                                    name="state_of_delivery" 
                                    id="stateDelivery" 
                                    required 
                                    data-stateDelivery="{{ deliveryInfo.state_id }}" />
                                      <option value="">Select One</option>
                                     {{#each states}}
                                        <option value="{{this.id}}">{{this.name}}</option>
                                    {{/each}}
                                  </select>
                                </div>

                              </div>
                          </div>

                          <div class="col-sm-6">
                            <div class="input-group input-group-sm mb-3">
                              
                              <label for="lga" class="input_form">LGA <span class="profile_sub">*</span></label>
                                <div class="input-group mb-3">
                              
                                  <select 
                                      class="form-select border-0 border-bottom" 
                                      name="lga_of_delivery" 
                                      id="lgaDelivery" 
                                      required
                                       data-lgaDelivery="{{ deliveryInfo.lg_id }}" />               
                                    <option value=""></option>
                                  </select>
                                </div>
                            </div>
                        </div>
                       </div>
                       
                       <div class="row">
                        <div class="col-sm-12 ">
                            <div class="input-group input-group-sm mb-3">
                              
                              <label for="address" class="input_form">Address <span class="profile_sub">*</span></label>
                              <div class="input-group mb-3">

                                <textarea 
                                  class="form-control border-0 border-bottom" 
                                  name="address"
                                  style="align-content:left; overflow:auto"
                                  id="address" cols="30" rows="5" required>
                                   {{ deliveryInfo.address }} 
                                </textarea>
                              </div>

                            </div>

                            <div class="col-12">
                              <div class="columns mx-auto" style="width: 160px;">
                                <button type="submit" class="btn float-end mb-1 submitBtn">Update</button>
                              </div>
                            </div>
                        </div>

                        
                     </div>

                     
                          </div>
                          
                        </div>
                      </div>
                    </div>
                </div>
          </div>
</form>

      
<script type="text/javascript" src="https://code.jquery.com/jquery-2.1.1.min.js"></script>
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js" integrity="sha512-qTXRIMyZIFb8iQcfjXWCO8+M5Tbc38Qi5WzdPOYZHIlZpzBHG3L3by84BBBOiRGiEb7KKtAOAs5qYdUiZiQNNQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script type="text/javascript">

    const success_toastr = (msg) => {
      Toastify({
          text: msg,
          duration: 4000,
          newWindow: true,
          close: true,
          gravity: "bottom", // `top` or `bottom`
          position: "left", // `left`, `center` or `right`
          backgroundColor: "linear-gradient(to bottom, #00b09b, #28a745)", //#00b09b #96c93d
          stopOnFocus: true, // Prevents dismissing of toast on hover
          onClick: function () { }, // Callback after click
        }).showToast();
      }

      // success_toastr('You have successfully update your profile')

    const error_toastr = (msg) => {
      Toastify({
        text: msg,
        duration: 5000,
        newWindow: true,
        close: false,
        gravity: "top", // `top` or `bottom`
        position: "right", // `left`, `center` or `right`
        backgroundColor: "linear-gradient(to right, rgba(255,0,0,1), rgba(255,0,0,1))",
        stopOnFocus: true, // Prevents dismissing of toast on hover
        onClick: function () { }, // Callback after click
      }).showToast();
    }

   $('.js-example-basic-multiple').select2({
        placeholder: "Select multiple items",
        allowClear: true
    });

    $(document).ready(function(){

      let lga = $('#lgas').data('lga')

      let state = $('#state').data('state')

        const getDefaultLgas = (state_id) => {
            let url =  window.location.origin+'/api/base/lgas/'+ state_id
            fetch(url).then(r=>r.json())
            .then(r => {
                let selected,Options
                r.forEach(e=>{
                    Options+='<option value="'+e.id+'">'+e.name+'</option>'
                })
                document.querySelector('#lgas').innerHTML= Options

                $('#lgas').val(lga)
            }
            ).catch(e=>{
                console.log(e)
            })
        }


        //Get All LGAs based on selected value of the state
        
        if(state != null){
          $('#state').val(state)

          getDefaultLgas(state)
        }


        let gender = $('#gender').data('gender')
        $('.gender').val(gender)
        
        if(gender != null){
          $('.gender').val(gender)
        }


        document.querySelector('#state').addEventListener('change', function(){
              let url =  window.location.origin+'/api/base/lgas/'+this.value
              fetch(url).then(r=>r.json())
              .then(r=>{
                  let Options =  '<option value="">Select LGA</option>'
                  r.forEach(e=>{
                      Options+='<option value="'+e.id+'">'+e.name+'</option>'
                  })
                  document.querySelector('#lgas').innerHTML=Options
              }
              ).catch(e=>{
                  //console.log(e)
              })
          })

        document.querySelector('#stateDelivery').addEventListener('change', function(){
          let url =  window.location.origin+'/api/base/lgas/'+this.value
          fetch(url).then(r=>r.json())
            .then(r=>{
                let Options =  '<option value="">Select LGA</option>'
                r.forEach(e=>{
                    Options+='<option value="'+e.id+'">'+e.name+'</option>'
                })
                document.querySelector('#lgaDelivery').innerHTML=Options
            }
            ).catch(e=>{
                console.log(e)
            })
        })
        
        let stateD = $('#stateDelivery').data('statedelivery')
        let lgaDelivery = $('#lgaDelivery').data('lgadelivery')
        if(stateD != null){
          $('#stateDelivery').val(stateD)

          setTimeout(function(){
                let url =  window.location.origin+'/api/base/lgas/'+ stateD
                fetch(url).then(r=>r.json())
                .then(r => { 
                    let selected,Options
                    r.forEach(e=>{
                        Options+='<option value="'+e.id+'">'+e.name+'</option>'
                    })
                    document.querySelector('#lgaDelivery').innerHTML= Options

                    $('#lgaDelivery').val(lgaDelivery)
                }
                ).catch(e=>{
                    console.log(e)
                })
            }, 1000)
        }

        let url =  window.location.origin+'/api/base/get-droplist'

        fetch(url,{})
          .then(response => response.json())
          .then(response => {
            if(response.statusCode === 200){
              
                let objArray, len, i, farm_produce, level
                objArray = response.data.gender
                len = objArray.length

                let Options =  '<option value="">Select One</option>'

                var ele = document.getElementById('gender');

                for(i=0; i < len; i++){
                    ele.innerHTML = ele.innerHTML + '<option value="' + objArray[i].name + '">' + objArray[i].name + '</option>';
                }


                level = response.data.eduLevel

                len = level.length
                var ele = document.getElementById('levelE');

                
                for(i=0; i < len; i++){
                    ele.innerHTML = ele.innerHTML + '<option value="' + level[i].name + '">' + level[i].name + '</option>';
                }

                setTimeout(function(){

                  let level = $('#levelE').data('level')
                    if(level != null){
                        $('#levelE').val(level)
                    }
                }, 1000)


                farm_produce = response.data.farm_produce
                len = farm_produce.length

                var ele = document.getElementById('farmProduce');
                //$(ele).atrr('val')
                let val =ele.getAttribute('value')
                for(i=0; i < len; i++){ 
                    ele.innerHTML = ele.innerHTML + '<option value="' + farm_produce[i].name + '"' + (val.includes(farm_produce[i].name) ? 'selected="'+true+'"' : null)+'>' + farm_produce[i].name + '</option>';
                }
            }
        }).catch(e => {
          console.log(e)
        })
        


        $("#updateProfile").on('submit', function(e){
          e.preventDefault()
          
          let _data = {
            firstname: $('#firstname').val(),
            lastname: $('#lastname').val(),
            date_of_birth: $('#dob').val(),
            gender: $('#gender').val(),
            level_of_education: $('#levelE').val(),
            state_id: $('#state').val(),
            lg_id: $('#lgas').val(),
            bvn: $('#bvn').val(),
            nin: $('#nin').val(),
            state_of_delivery: $('#stateDelivery').val(),
            lga_of_delivery: $('#lgaDelivery').val(),
            address: $('#address').text(),
            farm_produce: $('#farmProduce').val()
          }

          let updateURL =  window.location.origin+'/farmer/update-profile'
          
          $.ajax({
              type: 'POST',
              url: updateURL,
              data: $(this).serialize(),
              beforeSend: () => {
                $('.submitBtn').html('Please Wait...')
              },
              success: (response) => {
                if(response.statusCode == 402){
                    let msg = ''
                    let errors = response.data
                    errors.forEach((value, index) => {
                      msg += (index + 1 ) + '.' + value.msg + ' \n'
                    })
                    error_toastr(msg)
                  }else if(response.statusCode == 500 || response.statusCode == 400){
                    error_toastr(response.data)
                  }else{

                    let m = state != null ? 'Your profile has been update successfully.' : response.message
                    success_toastr(m)

                    setTimeout(function(){
                      if(!state){
                        window.location='dashboard'
                      }
                    }, 2000)
                  }
              },
              complete: () => {
                  $('.submitBtn').html('Update')
              },
              error: (err) => {

              }
          })

        })
    })
    
</script>
