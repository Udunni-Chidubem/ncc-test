{{#if product }}
<div class="container">
	<div class="card">
        <div class="card-body m-3">
        	 <div class="search-tip">
                <p ><i class="fa fa-lightbulb"></i> Recommendation: You need 3kg of maize seed for your farm</p>
             </div>
             <div class="product-grid">
             	<div class="product-img">
             		 <img src="../../product_images/{{product.file_name}}" alt="Product Image">
             	</div>
             	<div class="product-details">
             		<h4 class="product-name">{{product.product_name}}</h4>                   
	                <p class="product-variant">{{product.variant}}</p>                   
	                <p class="product-seller">{{seedCompany}}</p> 

	                <hr class="product-line">

	                <h5>Description</h5>
	                <p>{{product.description}}</p>
					
					{{!-- <button class="btn btn-save-product mr-2"><i class="fa fa-cart-add"></i>Add to Cart</button> --}}
                     <button class="btn btn-save-product mr-2 addCart" data-prodid="{{product.id}}"> <i class='bx bx-cart-add'></i>Add to Cart</button>
	                <button class="btn btn-place-order">Place Order</button>
	                {{!-- <button class="btn btn-place-order" onclick="window.location.href='./payment_page_preview'">Place Order</button> --}}
             	</div>
             	<div class="view-product-price">                
             	    <p>Unit Price</p>
                  <h4 class="price_{{product.id}}" id="price"></h4>
                  <div class="input-field product-size">
                          <select id="{{product.id}}" class="size">
                            <option value="">Choose Size</option>
                            {{#json product.item}}
                                {{#each this.pkg}}
                                    <option value="{{this}}">{{this}} kg</option>
                                {{/each}}
                            {{/json}}
                        </select>
                    </div>

                  <p style="margin-bottom: 10px;">Select quantity</p>

                  <div class="input-group">
                      <span class="input-group-btn">
                          <button type="button" class="quantity-left-minus btn btn-count btn-number"  data-type="minus" data-field="">
                            <span class="fa fa-minus"></span>
                          </button>
                      </span>
                      <input type="text" id="quantity" name="quantity" class="input-number" value="1" min="1" max="100">
                      <span class="input-group-btn">
                          <button type="button" class="quantity-right-plus btn btn-count btn-number" data-type="plus" data-field="">
                              <span class="fa fa-plus"></span>
                          </button>
                      </span>
                  </div>

             	</div>
             </div>
        </div>
	</div>
</div>
{{else}}

{{/if}}