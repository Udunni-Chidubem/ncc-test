<section class="parent-container">
  <div class="container1">
    <h1 class="h1">Order Summary</h1>
    <div class="horizontalLine"></div>
    <div class="orderContainer">
      <div class="orderGrid">
        {{#if getCartItems}}
        {{#each getCartItems}}
        <div>
          <p>{{Product.product_name}}</p>
        </div>
        <div>
          <p>{{size}}kg</p>
        </div>
        {{/each}}
        {{/if}}
      </div>

      <hr />
      <div class="costGrid">
        {{#itemSum getCartItems}}
        <div>
          <h6>Sub-Total</h6>
        </div>
        <div>
          <p>&#8358; {{this}}</p>
        </div>
        <div>
          <h6>Shipping</h6>
        </div>
        <div>
          <p>&#8358; 0</p>
        </div>
        <div>
          <h6>Processing</h6>
        </div>
        <div>
          <p>&#8358; 70</p>
        </div>
      </div>
      <hr />
      <div class="costGrid">
       
        <div class="total">
          <p>Total</p>
        </div>

        <div class="totalCost">
          {{#add this 70}}
          <p>&#8358;{{this}} </p>
          {{/add}}
        </div>
        {{/itemSum}}
      </div>
    </div>
  </div>
  <form class="form-container" action="/farmer/cart/checkout" method="post">
    <div class="container2">
      <h1 class="h1">Delivery information</h1>
      <div class="horizontalLine"></div>
      {{#each getCartItems}}
      <input type="hidden" name="items" id="{{id}}" value="{{id}}" />
      {{/each}}
      <div class="shippingGrid">
        <div class="shippingAddress">
          <h4>{{farmer.firstname}} {{farmer.lastname}}, {{farmer.phone_no}}</h4>
          <p>Address:{{farmer.address}}
            {{deliveryInfo.LGA.name}},
            {{deliveryInfo.State.name}}</p>
          <p>Pick up point:
            <textarea name="pickup" id="pickup" style="width: 400px;">{{deliveryInfo.address}},
              {{deliveryInfo.LGA.name}},
              {{deliveryInfo.State.name}}</textarea>
          </p>
        </div>
      </div>
    </div>

    <div class="card ml-4 p-4" style="width:75%;">
      <h1 class="h1">payment</h1>
      <div class="horizontalLine"></div>

      <div class="pre_pay">
        <p><em>Select your preferred mode of payment</em></p>

        {{#itemSum getCartItems}}
        <input type="hidden" name="total_sum" id="total_sum" value="{{#add this 70}}{{this}}  {{/add}}" />
        {{/itemSum}}
        <div class="row">
           <div class="form-check form-check-inline col-xl-3 col-md-3 col-sm-12">
            <input class="form-check-input" required="true" type="radio" name="inlineRadioOptions" id="card"
              value="card" />
            <label class="form-check-label" for="card">Card</label>
          </div>
          <div class="form-check form-check-inline col-xl-3 col-md-3 col-sm-12">
            <input class="form-check-input" required="true" type="radio" name="inlineRadioOptions" id="payOnDelivery"
              value="payOnDelivery">
            <label class="form-check-label" for="payOnDelivery">Pay On Delivery</label>
          </div>
        </div>     
        <div id="gateway-option-block" style="display:none">
            <h5  class="pt-3" >
              Choose Gateway
            </h5> 
          
            <div class="row">
              <div class="form-check form-check-inline col-xl-3 col-md-3 col-sm-12">
                <input class="form-check-input"  type="radio" name="gatewayOptions" id="ussd" value="paystack">
                <label class="form-check-label" for="ussd">Paystack</label>
              </div>
              <div class="form-check form-check-inline col-xl-3 col-md-3 col-sm-12">
                <input class="form-check-input" type="radio" name="gatewayOptions" id="pos" value="9PSB">
                <label class="form-check-label" for="pos">9PSB</label>
              </div>
            </div>
        </div>
        <hr class="mb-2"/>
        <button type="submit" class="btn btn-theme" style="float: right;">Pay</button>
      </div>
    </div>
  </form>
  {{! <div class="container4">
    <h1>order summary</h1>
    <div class="horizontalLine"></div>
    <div class="firstSummary">
      <div class="order">
        <h4>White Maize</h4>
        <p>Variant</p>
      </div>
      <div class="orderQty">
        <p>Qty</p>
        <p>2kg</p>
      </div>
    </div>
    <div class="horizontalLine"></div>
    <div class="secondSummary">
      <div class="amountCalc">
        <p>Subtotal</p>
        <p>Shipping</p>
        <p>Total</p>
      </div>
      <div class="summaryAmount">
        <p>4,999</p>
        <p class="shippingFee">250</p>
        <h3>5,249</h3>
      </div>
    </div>
    <div>
      <button type="button" class="summaryBtn">Pay</button>
      <!-- <button type="button" class="summaryBtn">Save</button> -->
    </div>
  </div> }}
</section>
<script>
  document.onreadystatechange=function(){
    if(document.readyState=='complete'){
      $('#card, #payOnDelivery').on('click', function(){
        if(this.value=='card'){
          $("#gateway-option-block").css('display', 'block')
        }else{
          $("#gateway-option-block").css('display', 'none')
        }
      })
    }
  }
</script>