 <section class="parent-container">
      <div class="container1">
        <h1 class="h1">Order Summary</h1>
        <div class="horizontalLine"></div>
        <div class="orderContainer">
          <div class="orderGrid">
            {{#if getCartItems}}
              {{#each getCartItems}}
                <div>
                  <p>{{Product.product_name}}</p>
                </div>
                <div>
                  <p>{{size}}kg</p> 
                </div>
              {{/each}}
            {{/if}}
          </div>

          <hr>
          <div class="costGrid">
            <div>
              <h6>Sub-Total</h6>  
            </div>
            <div>
              <p>&#8358; 0</p>
            </div>
            <div>
              <h6>Shipping</h6>  
            </div>
            <div>
              <p>&#8358; 0</p>
            </div>
          </div>
        <hr>
          <div class="costGrid ">  
            {{#itemSum getCartItems}}     
            <div class="total">
              <p>Total</p>  
            </div>

            <div class="totalCost">
              <p>&#8358;{{this}} </p>
            </div>
            {{/itemSum}}
          </div>
        </div>
      </div>

      <div class="container2">
        <h1 class="h1">Delivery information</h1>
        <div class="horizontalLine"></div>

        <div class="shippingGrid">
          <div class="shippingAddress">
            <h4>{{farmer.firstname}} {{farmer.lastname}}, {{farmer.phone_no}}</h4>
            <p>Address:{{farmer.address}}  {{deliveryInfo.LGA.name}}, {{deliveryInfo.State.name}}</p>
            <p>Pick up point: <span>{{deliveryInfo.address}}, {{deliveryInfo.LGA.name}}, {{deliveryInfo.State.name}}</span></p>
          </div>
        </div>
      </div>

      <div class="container3">
        <h1 class="h1">payment</h1>
        <div class="horizontalLine"></div>

        <div class="pre_pay">
          <p><em>Select your preferred mode of payment</em></p>
          <form class="form-container" action="/farmer/cart/checkout" method="post">

            <div class="form-check form-check-inline">
              <input class="form-check-input" type="radio" name="inlineRadioOptions" id="card" value="card">
              <label class="form-check-label" for="card">Card</label>
            </div>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="radio" name="inlineRadioOptions" id="ussd" value="ussd">
              <label class="form-check-label" for="ussd">USSD</label>
            </div>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="radio" name="inlineRadioOptions" id="pos" value="pos">
              <label class="form-check-label" for="pos">POS</label>
            </div>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="radio" name="inlineRadioOptions" id="payOnDelivery" value="payOnDelivery">
              <label class="form-check-label" for="payOnDelivery">Pay On Delivery</label>
            </div>
{{!-- 
            <input type="radio" name="ussd" value="ussd" />
            <label for="ussd">USSD</label>
