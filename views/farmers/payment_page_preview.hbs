<section class="parent-container">
      <div class="container1">
        <h1 class="h1">order review</h1>
        <div class="horizontalLine"></div>
        <div class="orderContainer">
          <div class="orderGrid">
            <div class="orderImage">
              <img src="../images/maize.jpg" alt="" />
            </div>

            <div class="orderInfo">
              <p class="orderName">Maize FM/123</p>
              <p>Variant</p>
              <p>Seed company</p>
            </div>
          </div>
          <div class="qty orderInfo">
            <p class="qtyAmount">N 3,999</p>
            <p>Select Qty</p>
            <div class="qtyWrapper orderInfo">
              <!-- <i class="bx bx-plus-circle"></i>
              <p>1</p>
              <i class="bx bx-minus-circle"></i>-->
              <div
                class="value-button"
                id="decrease"
                onclick="decreaseValue()"
                value="Decrease Value"
              >
                -
              </div>
              <input type="number" id="number" value="0" />

              <div
                class="value-button"
                id="increase"
                onclick="increaseValue()"
                value="Increase Value"
              >
                +
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="container2">
        <h1 class="h1">Dilivery information</h1>
        <div class="horizontalLine"></div>

        <div class="shippingGrid">
          <div class="shippingAddress">
            <h4>Adamu Garba, +234 801 234 5678</h4>
            <p>Address: No 1 Dutse Alhaji street, Mai Gishiri Kuri, Gombe</p>
            <p>Pick up point: <span>Giri Round about</span></p>
          </div>
          <div class="addAddress">
            <p>
              <span><i class="bx bx-plus"></i></span>Add New Address
            </p>
            <p>Select Other Address</p>
          </div>
        </div>
      </div>

      <div class="container3">
        <h1 class="h1">payment</h1>
        <div class="horizontalLine"></div>

        <div>
          <p><em>Select your preferred mode of payment</em></p>
          <form class="form-container">
            <input type="radio" name="ussd" value="ussd" />
            <label for="ussd">USSD</label>
            <input type="radio" name="ussd" class="pos" value="pos" />
            <label for="ussd">POS</label>
          </form>
        </div>
      </div>
      <div class="container4">
        <h1>order summary</h1>
        <div class="horizontalLine"></div>
        <div class="firstSummary">
          <div class="order">
            <h4>White Maize</h4>
            <p>Variant</p>
          </div>
          <div class="orderQty">
            <p>Qty</p>
            <p>2kg</p>
          </div>
        </div>
        <div class="horizontalLine"></div>
        <div class="secondSummary">
          <div class="amountCalc">
            <p>Subtotal</p>
            <p>Shipping</p>
            <p>Total</p>
          </div>
          <div class="summaryAmount">
            <p>4,999</p>
            <p class="shippingFee">250</p>
            <h3>5,249</h3>
          </div>
        </div>
        <div>
          <button type="button" class="summaryBtn">Pay</button>
          <!-- <button type="button" class="summaryBtn">Save</button> -->
        </div>
      </div>
    </section>