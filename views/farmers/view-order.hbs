<div class="container__">
	<div class="card">
		<div class="card-body">
			<div class="order_id ">
				Order {{transaction_id}}
			</div>
			<div class="table-responsives table_t_info">
				<h4 class="order_header">Order information</h4>
				<table class="table con t_info  table-border">
					<thead class="t_info__head ">
						<tr>
							<th>Item</th>
							<th>Seller</th>
							<th>Package Size</th>
							<th>Qty</th>
							<th>Price</th>
							<th>Status</th>
						</tr>
					</thead>
					{{#each transactions}}
					<tbody class="t_info_body table-striped table-theme-secondary">
						<tr>
							<td style="width: 150px;">
								<p>{{this.Cart.Product.product_name}}</p>
								<div class="table_img">
									<a href=""><img src="../../product_images/{{this.Cart.Product.file_name}}"
											alt="Product Image"></a>
								</div>
								<p>{{this.Cart.Product.description}}</p>
							</td>
							<td>kk</td>
							<td>{{this.Cart.size}}Kg</td>
							<td>{{this.Cart.qty}}</td>
							<td>&#8358; {{this.Cart.unit_price}}</td>
							<td> <span class=" approved  px-1"><i class="bi bi-dot"></i> approved</span>
								<p>09/87/54</p>
								<input class="form-check-input item-check-box" type="hidden" name="items"
									value="{{this.Cart.Product.id}}" id="{{this.Cart.Product.id}}">
								<p><button class="btn btn-save-product add-to-cart" data-prodid="{{this.id}}">Order
										Again</button></p>
							</td>
						</tr>
					</tbody>
					{{/each}}
				</table>
			</div>
			<hr>
			<div class="buyer_info">
				<div>
					<h4>Payment Information</h4>
					<p>Payment Mode: <span>{{currency_}}</span> </p>
					<p>Amount Paid: <span>{{total_amount}}</span> </p>
				</div>

				<div>
					<h4>Delivery information</h4>
					<span>{{pick_up}}
						{{!-- {{farmer.User.DeliveryInformation.LGA.name}},
						{{farmer.User.DeliveryInformation.State.name}} --}}
					</span>
				</div>
			</div>
		</div>
	</div>
</div>