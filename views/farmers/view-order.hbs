<div class="container__">
	<div class="card">
		<div class="card-body">
			<div class="order_id ">
				Order {{transaction_id}}
			</div>
			<div class="table-responsives table_t_info">
				<h4 class="order_header">Order information</h4>
				<table class="table con t_info  table-border">
					<thead class="t_info__head ">
						<tr>
							<th>Item</th>
							<th>Seller</th>
							<th>Package Size</th>
							<th>Transaction Ref</th>
							<th>Qty</th>
							<th>Price </th>
							<th>Status</th>
						</tr>
					</thead>
					{{#each orderStatus}}
					<tbody class="t_info_body table-striped table-theme-secondary">
						<tr>
							<td>
								<p>{{this.product_name}}</p>
								<div class="table_img" style="width: 150px;">
									<a href=""><img src="../../product_images/{{this.file_name}}"
											alt="Product Image"></a>
								</div>
								<p>{{this.description}}</p>
							</td>
							<td>{{this.name_of_company}}</td>
							<td>{{this.size}}Kg</td>
							<td>{{this.transaction_ref}}Kg</td>
							<td>{{this.qty}}</td>
							<td>&#8358; {{this.price}}</td>
							<td>
								{{#if (eq this.status "1")}}
								<span class="pending px-1"><i class="bi bi-dot"></i>Ready to ship</span>
								{{else if (eq this.status "2")}}
								<span class="shipped px-1"><i class="bi bi-dot"></i>Shipped</span>
								{{else if (eq this.status "3")}}
								<span class="approved px-1"><i class="bi bi-dot"></i>Fulfilled</span>
								{{else}}
								<span class="processing px-1"><i class="bi bi-dot"></i>Processing</span>
								{{/if}}
								<p>{{dateFormat updated_at "DD/MM/YYYY"}}</p>
								{{!-- <input class="form-check-input item-check-box" type="hidden" name="items"
									value="{{this.p_id}}" id="{{this.p_id}}"> --}}
								<p><button class="btn btn-save-product add-to-cart" data-prodid="{{this.p_id}}">Order
										Again</button></p>
							</td>
						</tr>
					</tbody>
					{{/each}}
				</table>
			</div>
			<hr>
			<div class="buyer_info">
				<div>
					<h4>Payment Information</h4>
					<p>Payment Mode: <span>{{currency_}}</span> </p>
					<p>Amount Paid: <span>{{total_amount}}</span> </p>
				</div>

				<div>
					<h4>Delivery information</h4>
					<span>{{pick_up}}
						{{!-- {{farmer.User.DeliveryInformation.LGA.name}},
						{{farmer.User.DeliveryInformation.State.name}} --}}
					</span>
				</div>
			</div>
		</div>
	</div>
</div>