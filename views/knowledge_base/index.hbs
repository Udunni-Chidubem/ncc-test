{{> header}}

<body class="body">
    {{> main_menu}}

    <div class="searchBar-container">
        <div>
            <form action="#" class="form-search">
                <input type="text" placeholder="What are you looking for?" name="search" class="search-bar">
                <button type="button" class="search-btn">Search</button>
            </form>
        </div>

    </div>

    <div class="valueSeeds-container row">
        {{#each knowledgeBases }}
        <div class="valueSeeds-image col-3">
            <a href="/maize">
                <img src="/images/Maize.png">
            </a>
            <p class="seed-title">Maize</p>
        </div>
        {{/each}}

        <div class="valueSeeds-image">
            <a href="/groundnut">
                <img src="/images/groundnut.png">
            </a>
            <p class="seed-title">Groundnut</p>

        </div>

        <div class="valueSeeds-image">
            <a href="/cowpie">
                <img src="/images/cowpea.png">
            </a>
            <p class="seed-title">Cowpea</p>
        </div>
        <div class="valueSeeds-image">
            <a href="/rice">
                <img src="/images/rice.png">
            </a>
            <p class="seed-title">Rice</p>
        </div>
        <div class="valueSeeds-image">
            <a href="/recommendation">
                <img src="/images/recommended.png" alt="recommendation">
            </a>
            <p class="seed-title">Recommendation</p>
        </div>


    </div>

</body>

{{> footer}}