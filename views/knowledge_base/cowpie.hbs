<div class="mainpage">
  <div class="heading1">

    <h3 class="mainheading"> {{knowledgeBase.name}}</h3>
    <hr class="underline" />

  </div>
  <div class="description-grid" id="description">
    <div class="text-descp">
      <img
        class="dub-image"
        src="/knowledge_base/images/{{knowledgeBase.image_path}}"
        alt="A picture of cowpea"
      />

    </div>
    <div class="row">
      <object
        data="/knowledge_base/file/{{knowledgeBase.file_path}}"
        width="100%"
        height="1000px"
      >
        <p>Alternative text - include a link
          <a href="/knowledge_base/file/{{knowledgeBase.file_path}}">to the PDF!</a></p>
      </object>
    </div>
  </div>

</div>