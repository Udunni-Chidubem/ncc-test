<div class="knowledge-header">
    <h1 class="text-center m-0">Knowledge Base</h1>
</div>

<body class="body">

    <div class="knowledge-content-card p-3">
        {{#each knowledgeBases }}
        <a href="/{{this.name}}">
            <div class="card">
                <img class="knowB card-img-top" src="/knowledge_base/images/{{this.image_path}}" alt="Card image cap">
                <div class="knowB card-body">
                    <h5 class="card-title">{{this.name}}</h5>
                    <p class="card-text">{{this.description}}</p>
                    <p class="card-text"><small class="text-muted"></small></p>
                </div>
            </div>
        </a>
        {{/each}}
    </div>
</body>

{{!-- {{> footer}} --}}