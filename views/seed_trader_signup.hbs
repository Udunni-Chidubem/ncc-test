 <div class="container-fluid pt-3" id="contain">
    <div class="page-wrapper bg-gra-02 font-poppins">
        <div class="wrapper wrapper--w680">
            <div class="card card-4">
                <div class="card-body">
                    <h1 class="title p-b-15">Create An Account</h1>
                     
                    {{!-- <div class="form-col">  --}}
                    <form method="POST" class="p-t-15" >
                        <div class="row">
                            <div class="col-md-5 col-sm-12">
                                <div class="form-group"> 
                                    <input class="form-control" type="text" name="firstname" placeholder="First name">
                                </div>
                            </div>
                           <div class="col-md-5 col-sm-12">
                                <div class="form-group"> 
                                    <input class="form-control" type="text" name="lastname" placeholder="Last name">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                           <div class="col-md-5 col-sm-12">
                                <div class="form-group">
                                    <select name="lga" required id="lga" class="form-control">
                                        <option value="">Select LGA</option>
                                    </select>
                                </div>
                            </div>
                             
                              {{!-- <div class="col-md-5 col-sm-12">
                                <div class="form-group">
                                    <input class="form-control" type="tel" name="accountnumber" placeholder="Enter Your Account Number">
                                </div>
                            </div> --}}
                               <div class="col-md-5 col-sm-12">
                                <div class="form-group">
                                    <input class="form-control" type="password" name="password" placeholder="Enter Your Password">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            
                            <div class="col-md-5 col-sm-12">
                                <div class="form-group">
                                    <input class="form-control" required type="text" id="phone"  name="phone" placeholder="Phone no">
                                
                                </div>
                            </div>

                            <div class="col-md-5 col-sm-12">
                                <div class="form-group">
                                  <select class="form-control"  name="gender" id="gender">
                                       <option value="">Gender</option>
                                      <option value="m">Male</option>
                                      <option value="f">Female</option>
                                  </select>
                                </div>
                            </div>
                        </div>
                         
                        <div class="row">
                            <div class="col-md-5 col-sm-12">
                             <div class="form-group">
                                    <select name="state" required id="state" class="form-control">
                                        <option value="">Select State</option>
                                        {{#each states}}
                                            <option value="{{this.dataValues.id}}">{{this.dataValues.name}}</option>
                                        {{/each}}
                                    </select>
                                </div>
                             </div>   

                            {{!-- <div class="col-md-5 col-sm-12">
                                <div class="form-group">
                                    <input class="form-control" type="tel" name="Accountnumber" placeholder="Enter Your Account Number">
                                </div>
                            </div> --}}
                             
                        </div>   
                              
                        {{!-- <div class="p-t-15">
                            <center><button class="btn btn--radius-2 btn--green" type="button">Submit</button></center>
                        </div>
                        <div class="row">
                            <div class="d-flex justify-content-end">
                                <center><p style="color:#47ba5d;"> Already Have An Account? <a href="" class="links">SIgn In</a></p></center>
                            </div>
                        </div> --}}

                                         <div class="p-t-16">
                            <center><button class="btn primary-button    w-button  btn--radius-2 btn--green" type="submit">Submit</button></center>
                        </div>

                         <div class="p-t-16">
                            <center><p style="color:#47ba5d;"> Already Have An Account? <a href="/login" class="links">SIgn In</a></p></center>
                             
                        </div>
                    </form>
                    {{!-- </div> --}}
                </div>
            </div>
        </div>
    </div>
</div>


 
   