<div class="bg-primary">
    {{>breadcrumbs}}
</div>

<br>
<br>

<form action="" method="get">
<div class="content active" id="all">
    <div class=" container table-responsives table_t_info">
        <table class="table con t_info  table-borderless" id="product-table-all">
            <thead class="t_info_head ">
                <tr class="row-height">
                    <th scope="col">
                    <div class="btnreport datecycle">
                        <label for="selectico" class="labelos">State </label>
                         <select class="btndropdown" aria-labelledby="" id="selectico">
                             {{#each states}}
                            <option id=" {{this.id}} " class="dropdown-item">{{this.name}}</option>
                             {{/each}}
                            {{!-- <option id="2" class="dropdown-item">Action</option>
                            <option id="3" class="dropdown-item">Another action</option>
                            <option id="4" class="dropdown-item">Something else here</option> --}}
                        </select>
                       
                    </div>
                    </th>

                    <th scope="col">
                    <div class="btnreport datecycle">
                        <label for="btndropdown" class="labelos">Product</label>
                         <select class="btndropdown" aria-labelledby="">
                            <option id="1" class="dropdown-item">Product</option>
                            <option id="2" class="dropdown-item">Cowpea</option>
                            <option id="3" class="dropdown-item">Maize</option>
                            <option id="4" class="dropdown-item">Rice</option>
                            <option id="5" class="dropdown-item">Groundnut</option>
                        </select>
                       
                    </div>
                    </th>

                    <th scope="col">
                    <div class="btnreport datecycle">
                        <label for="btndropdown" class="labelos">Status</label>
                         <select class="btndropdown" aria-labelledby="">
                            <option id="1" class="dropdown-item">Status</option>
                            <option id="2" class="dropdown-item">Pending</option>
                            <option id="3" class="dropdown-item">Confirmed</option>
                        </select>
                       
                    </div>
                    </th>
                   
                    <th scope="col">
                    <div class="btnreport btndropdown datecycle">
                        <label for="datepic" class="labelos">Start Date</label>
                        <input class="btndropdown" type="date" id="datepic">
                        
                    </div>
                    </th>

                    <th scope="col">
                     <div class="btnreport btndropdown datecycle">
                        <label for="datepic" class="labelos">End Date</label>
                        <input class="btndropdown" type="date" id="datepic">
                        
                    </div>
                    </th>
                    
                     
                    <th scope="col">
                    <div class="btn-group btnreport_search">
                        <button type="submit" class="btn btn-primary">Search</button>
                    </div>
                    </th>
                     <th scope="col">
                    <div class="">
                        <button class="btn btn-width download-btn btn-outline-light">Export</button>
                    </div>
                    </th>
                     <th scope="col">

                    </th>
                </tr>
                <tr class="row-height">
                    <th scope="col">NAME</th>
                    <th scope="col">STATE</th>
                    <th scope="col">PRODUCT</th>
                    <th scope="col">DATE</th>
                    <th scope="col">AMOUNT</th>
                    <th scope="col">STATUS</th>
                    <th scope="col"></th>
                    <th scope="col"></th>
                    
                </tr>
            </thead>
            <tbody>

                <tr class="row-one row-height">
                    <td scope="col">Name</td>
                    <td scope="col"><strong>State</strong></td>
                    <td scope="col"> <strong>Product</strong></td>
                    <td scope="col"> <strong>Date</strong></td>
                     <td scope="col"> <strong>Amount</strong></td>
                    <td scope="col">

                        <span class="published">Confirmed</span>

                        <span class="unpublished">Pending</span>

                    </td>
                    <td scope="col"></td>
                    <td scope="col"></td>
                </tr>

            </tbody>
        </table>
    </div>
</div>
</form>