<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.1/chart.min.js"
  integrity="sha512-QSkVNOCYLtj73J4hbmVoOV6KVZuMluZlioC+trLpewV8qMjsWqlIQvkn1KGX2StWvPMdWGBqim1xlC8krl1EKQ=="
  crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.js"></script>
<script>
  const ctx = document.getElementById('myChart').getContext('2d');
  const myChart = new Chart(ctx, {
    type: 'bar',
    data: {
      labels: ['Jan', 'Feb', 'Mar', 'May'],
      datasets: [{

        label: 'Monthly',
        data: [7, 9, 12, 14],
        backgroundColor: [
          '#F99746',
          '#F99746',
          '#F99746',
          '#F99746',
          '#F99746',
          '#F99746'
        ],
        borderColor: [
          'white',
          'white',
          'white',
          'white',
          'white',
          'white',
        ],
        borderWidth: 1
      }]
    },
    options: {
      scales: {
        y: {
          beginAtZero: true
        }
      }
    }
  });


  var xactorValues = ["Active Account", "Inactive Account"];
  var yfarmerValues = [55, 19];
  var barColors = [
    "#FFB946",
    "#5DCD6D",

  ];

  new Chart("farmer", {
    type: "doughnut",
    data: {

      datasets: [{
        backgroundColor: barColors,
        data: yfarmerValues
      }]
    },
    options: {
      title: {
        display: true,
        text: "Farmer"
      }
    }
  });


  var yseedcompanyValues = [55, 19];

  new Chart("seedcompany", {
    type: "doughnut",
    data: {

      datasets: [{
        backgroundColor: barColors,
        data: yseedcompanyValues
      }]
    },
    options: {
      title: {
        display: true,
        text: "Seed Company"
      }
    }
  });

  var yseedtraderValues = [55, 19];

  new Chart("seedtrader", {
    type: "doughnut",
    data: {
      labels: xproductValues,
      datasets: [{
        backgroundColor: barColors,
        data: yseedtraderValues
      }]
    },
    options: {
      title: {
        display: true,
        text: "Seed Traders"
      }
    }
  });



  var xproductValues = ["published", "unpublished"];
  var yproductValues = [55, 19];
  var productbarColors = [
    "#FB8200",
    "#7B61FF",

  ];

  new Chart("totalproduct", {
    type: "doughnut",
    data: {
      labels: xproductValues,
      datasets: [{
        backgroundColor: productbarColors,
        data: yproductValues
      }]
    },
    options: {
      title: {
        display: true,
        text: "Total Products"
      }
    }
  });
</script>