<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.1/chart.min.js"
  integrity="sha512-QSkVNOCYLtj73J4hbmVoOV6KVZuMluZlioC+trLpewV8qMjsWqlIQvkn1KGX2StWvPMdWGBqim1xlC8krl1EKQ=="
  crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.js"></script>
<script>

  /* farmer count*/
  const farmercount_1 = document.getElementById('farmercount_1');
  farmerinactivelist = farmercount_1.getAttribute("farmerinactivelist")

  const farmercount_2 = document.getElementById('farmercount_2');
  farmeractivelist = farmercount_2.getAttribute("farmeractivelist")

  /* seed company count*/
  const seedcompany_1 = document.getElementById('seedcompany_1');
  seedcompanyinactivelist = seedcompany_1.getAttribute("seedcompanyinactivelist")

  const seedcompany_2 = document.getElementById('seedcompany_2');
  seedcompanyactivelist = seedcompany_2.getAttribute("seedcompanyactivelist")

  /* seed trader count*/
  const seedtrader_1 = document.getElementById('seedtrader_1');
  seedtraderinactivelist = seedtrader_1.getAttribute("seedtraderinactivelist")

  const seedtrader_2 = document.getElementById('seedtrader_2');
  seedtraderactivelist = seedtrader_2.getAttribute("seedtraderactivelist")

  // let x = $('.stat').data('user')
  // console.log(x)


  const ctx = document.getElementById('myChart').getContext('2d');
  const myChart = new Chart(ctx, {
    type: 'bar',
    data: {
      labels: ['Jan', 'Feb', 'Mar', 'May'],
      datasets: [{

        label: 'Monthly',
        data: [12, 64, 76, 676],
        backgroundColor: [
          '#F99746',
          '#F99746',
          '#F99746',
          '#F99746',
          '#F99746',
          '#F99746'
        ],
        borderColor: [
          'white',
          'white',
          'white',
          'white',
          'white',
          'white',
        ],
        borderWidth: 1
      }]
    },
    options: {
      scales: {
        y: {
          beginAtZero: true
        }
      }
    }
  });


  var xactorValues = ["Active Account", "Inactive Account"];
  var yfarmerValues = [farmeractivelist, farmerinactivelist];
  // var yfarmerValues = [x.f_count[0].f_count, x.f_count[1].f_count];
  //var yfarmerValues = [33,99];
  var barColors = [
    "#5DCD6D",
    "#FFB946",

  ];

  new Chart("farmer", {
    type: "doughnut",
    data: {
      labels: xactorValues,
      datasets: [{
        backgroundColor: barColors,
        data: yfarmerValues
      }]
    },
    options: {
      legend: {
        display: false
      },
      title: {
        display: true,
        text: "Farmer"
      }
    }
  });


  var yseedcompanyValues = [seedcompanyactivelist, seedcompanyinactivelist];
  // var yseedcompanyValues = [x.sc_count[0].sc_count, x.sc_count[1].sc_count];
  //var yseedcompanyValues = [12,33];

  new Chart("seedcompany", {
    type: "doughnut",
    data: {
      labels: xactorValues,
      datasets: [{
        backgroundColor: barColors,
        data: yseedcompanyValues
      }]
    },
    options: {
      legend: {
        display: false
      },
      title: {
        display: true,
        text: "Seed Company"
      }
    }
  });

  var yseedtraderValues = [seedtraderinactivelist, seedtraderactivelist];
  // var yseedtraderValues = [x.st_count[0].st_count, x.st_count[1].st_count];
  //var yseedtraderValues = [54,34];

  new Chart("seedtrader", {
    type: "doughnut",
    data: {
      labels: xactorValues,
      datasets: [{
        backgroundColor: barColors,
        data: yseedtraderValues
      }]
    },
    options: {
      legend: {
        display: false
      },
      title: {
        display: true,
        text: "Seed Traders"
      }
    }
  });



  var xproductValues = ["published", "unpublished"];
  var yproductValues = [55, 19];
  var productbarColors = [
    "#FB8200",
    "#7B61FF",

  ];

  new Chart("totalproduct", {
    type: "doughnut",
    data: {
      labels: xproductValues,
      datasets: [{
        backgroundColor: productbarColors,
        data: yproductValues
      }]
    },
    options: {
      legend: {
        display: false
      },
      title: {
        display: true,
        text: "Total Products"
      }
    }
  });
</script>