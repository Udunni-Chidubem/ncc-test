<div class="bg-primary">
  {{>breadcrumbs}}
</div>

<br>
<br>


<form action="" method="get">
<div class="content active" id="all">
    <div class=" container table-responsives table_t_info">
        <table class="table con t_info  table-borderless" id="product-table-all">
            <thead class="t_info_head ">
                <tr class="row-height">
                    <th scope="col">
                    <div class="btnreport datecycle">
                        <label for="selectico">Location </label>
                         <select class="btndropdown" aria-labelledby="" id="locationselect" name="locationselect">
                            <option value="">Select Location</option>
                             {{#each states}}
                            <option value="{{this.id}}"> {{this.name}} </option>
                             {{/each}}
                            {{!-- <option id="2" class="dropdown-item">Action</option>
                            <option id="3" class="dropdown-item">Another action</option>
                            <option id="4" class="dropdown-item">Something else here</option> --}}
                        </select>
                       
                    </div>
                    </th>
                   
                    <th scope="col">
                    <div class="btnreport btndropdown datecycle">
                        <label for="datepic">Start Date</label>
                        <input class="btndropdown" type="date" id="startdate" name="datepic">
                        
                    </div>
                    </th>

                    <th scope="col">
                     <div class="btnreport btndropdown datecycle">
                        <label for="datepic">End Date</label>
                        <input class="btndropdown" type="date" id=" enddate" name="datepic2">
                        
                    </div>
                    </th>
                    <th scope="col">
                    <div class="btnreport datecycle">
                        <label for="btndropdown">Gender</label>
                         <select class="btndropdown" aria-labelledby="" id="genderselect" name="genderselect">
                              <option id="1" value="" class="dropdown-item">Gender</option>
                            <option id="2" class="dropdown-item">Male</option>
                            <option id="3" class="dropdown-item">Female</option>
                        </select>
                       
                    </div>
                    </th>
                     <th scope="col">
                    <div class="btnreport datecycle">
                        <label for="btndropdown">Age-Range</label>
                         <select class="btndropdown" aria-labelledby="" id="ageselect" name="ageselect">
                            <option id="1" value="" class="dropdown-item">Age-Range</option>
                            <option id="2" class="dropdown-item">15-19</option>
                            <option id="3" class="dropdown-item">20-30</option>
                            <option id="4" class="dropdown-item">31-40</option>
                            <option id="5" class="dropdown-item">41-50</option>
                            <option id="6" class="dropdown-item">51 and above</option>
                        </select>
                       
                    </div>
                    </th>
                    <th scope="col">
                    <div class="btn-group btnreport_search">
                        <button type="submit" class="btn btn-primary btnsearch" id="btnsub" name="btnsub">Search</button>
                    </div>
                    </th>
                     <th scope="col">
                    <div class="">
                        <button class="btn btn-width download-btn btn-outline-light btnsearch" name="export">Export</button>
                    </div>
                    </th>
                     <th scope="col">

                    </th>
                </tr>
                <tr class="row-height">
                    <th scope="col">NAME</th>
                    <th scope="col">PHONE NUMBER</th>
                    <th scope="col">LOCATION</th>
                    <th scope="col">GENDER</th>
                    <th scope="col">AGE RANGE</th>
                    <th scope="col"></th>
                    <th scope="col"></th>
                    <th scope="col"></th>
                       
                    </th>
                </tr>
            </thead>
            <tbody>
                  {{#each users}}
                <tr class="row-one row-height">
                    {{#if Farmer.firstname}}
                        <td scope="col"> <strong>{{Farmer.firstname}}  {{Farmer.lastname}} </strong></td>
                    {{/if}}
                    {{#if SeedTrader.firstname}}
                        <td scope="col"> <strong>{{SeedTrader.firstname}}  {{SeedTrader.lastname}} </strong></td>
                    {{/if}}
                    {{#if SeedCompany.name_of_company}}
                        <td scope="col"> <strong>{{SeedCompany.name_of_company}} </strong></td>
                    {{/if}}


                    
                    <td scope="col"> <strong>{{username}}</strong></td>



                    {{#if Farmer.firstname}}
                    <td scope="col"> <strong> {{Farmer.LGA.name}}, {{Farmer.State.name}}</strong></td>         
                    {{/if}}
                    {{#if SeedTrader.firstname}}
                    <td scope="col"> <strong> {{SeedTrader.LGA.name}}, {{SeedTrader.State.name}}</strong></td>
                    {{/if}}
                    {{#if SeedCompany.name_of_company}}
                    <td scope="col"> <strong> {{SeedCompany.LGA.name}}, {{SeedCompany.State.name}}</strong></td>
                    {{/if}}


                    {{#if Farmer.firstname}}
                    <td scope="col"> <strong>{{Farmer.gender}}</strong></td>
                    {{/if}}

                    {{#if SeedTrader.firstname}}
                    <td scope="col"> <strong>{{SeedTrader.gender}}</strong></td>
                    {{/if}}
                    {{#if SeedCompany.name_of_company}}
                    <td scope="col"> <strong></strong></td>
                    {{/if}}


                    {{#if Farmer.firstname}}
                    <td scope="col"> <strong>{{Farmer.date_of_birth}}</strong></td>
                    {{/if}}

                    {{#if SeedTrader.firstname}}
                    <td scope="col"> <strong>{{SeedTrader.age}}</strong></td>
                    {{/if}}

                    {{#if SeedCompany.name_of_company}}
                    <td scope="col"> <strong></strong></td>
                    {{/if}}

                    <td scope="col"> <strong></strong></td>
                    <td scope="col"> </td>
                    <td scope="col"> </td>
                </tr>
                  {{/each}}
            </tbody>
        </table>
    </div>
</div>
</form>