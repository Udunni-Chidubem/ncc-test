<div class="bg-primary">
  {{>breadcrumbs}}
</div>

<br>
<br>

{{!-- btn-outline-light btn-sm dropdown-toggle --}}

<form action="get">
<div class="content active" id="all">
    <div class=" container table-responsives table_t_info">
        <table class="table con t_info  table-borderless" id="product-table-all">
            <thead class="t_info_head ">
                <tr class="row-height">
                    <th scope="col">
                    <div class="btn-group btnreport">
                        <button type="button" class="btn dropdown-menu defaultDropdown btndropdown" id="defaultDropdown"
                            data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false">
                            Location
                        </button>
                         <select class="btndropdown" aria-labelledby="">
                            <option id="1" class="dropdown-item">Action</option>
                            <option id="2" class="dropdown-item">Another action</option>
                            <option id="3" class="dropdown-item">Something else here</option>
                        </select>
                    </div>
                    </th>
                   
                    <th scope="col">
                    <div class="btn-group btnreport">
                        <button class="btn btn-outline-light btn-sm dropdown-toggle" type="button" id="defaultDropdown"
                            data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false">
                            Start Date
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="defaultDropdown">
                            <li class="dropdown-item"><input type="date"></li>
                           
                        </ul>
                    </div>
                    </th>
                    <th scope="col">
                    <div class="btn-group btnreport">
                        <button class="btn btn-outline-light btn-sm dropdown-toggle" type="button" id="defaultDropdown"
                            data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false">
                            End Date
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="defaultDropdown">
                            <li class="dropdown-item"><input type="date"></li>
                        </ul>
                    </div>
                    </th>
                    <th scope="col">
                    <div class="btn-group btnreport">
                        <button class="btn btn-outline-light btn-sm dropdown-toggle" type="button" id="defaultDropdown"
                            data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false">
                            Gender
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="defaultDropdown">
                           <li class="dropdown-item">Male</li>
                           <li class="dropdown-item">Female</li>
                           
                        </ul>
                    </div>
                    </th>
                     <th scope="col">
                    <div class="btn-group btnreport">
                        <button class="btn btn-outline-light btn-sm dropdown-toggle" type="button" id="defaultDropdown"
                            data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false">
                            Age Range
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="defaultDropdown">
                             <li class="dropdown-item">15-19</li>
                            <li class="dropdown-item">20-30</li>
                            <li class="dropdown-item">31-40</li>
                            <li class="dropdown-item">41-50</li>
                            <li class="dropdown-item">51 and above</li>
                        </ul>
                    </div>
                    </th>
                    <th scope="col">
                    <div class="btn-group btnreport_search">
                        <button type="button" class="btn btn-primary">Search</button>
                    </div>
                    </th>
                     <th scope="col">
                    <div class="">
                        <button class="btn btn-width download-btn btn-outline-light">Export</button>
                    </div>
                    </th>
                     <th scope="col">

                    </th>
                </tr>
                <tr class="row-height">
                    <th scope="col">NAME</th>
                    <th scope="col">PHONE NUMBER</th>
                    <th scope="col">LOCATION</th>
                    <th scope="col">GENDER</th>
                    <th scope="col">AGE RANGE</th>
                    <th scope="col"></th>
                    <th scope="col"></th>
                    <th scope="col"></th>
                       
                    </th>
                </tr>
            </thead>
            <tbody>
                  {{#each getUsers}}
                <tr class="row-one row-height">
                    {{#if Farmer}}
                        <td scope="col"> <strong>{{Farmer.firstname}}  {{Farmer.lastname}} </strong></td>
                    {{/if}}
                    {{#if SeedTrader}}
                        <td scope="col"> <strong>{{SeedTrader.firstname}}  {{SeedTrader.lastname}} </strong></td>
                    {{/if}}
                    {{#if SeedCompany}}
                        <td scope="col"> <strong>{{SeedCompany.name_of_company}} </strong></td>
                    {{/if}}


                    
                    <td scope="col"> <strong>{{username}}</strong></td>



                    {{#if Farmer}}
                    <td scope="col"> <strong> {{Farmer.LGA.name}}, {{Farmer.State.name}}</strong></td>         
                    {{/if}}
                    {{#if SeedTrader}}
                    <td scope="col"> <strong> {{SeedTrader.LGA.name}}, {{SeedTrader.State.name}}</strong></td>
                    {{/if}}
                    {{#if SeedCompany}}
                    <td scope="col"> <strong> {{SeedCompany.LGA.name}}, {{SeedCompany.State.name}}</strong></td>
                    {{/if}}


                    {{#if Farmer}}
                    <td scope="col"> <strong>{{Farmer.gender}}</strong></td>
                    {{/if}}

                    {{#if SeedTrader}}
                    <td scope="col"> <strong>{{SeedTrader.gender}}</strong></td>
                    {{/if}}
                    {{#if SeedCompany}}
                    <td scope="col"> <strong></strong></td>
                    {{/if}}


                    {{#if Farmer}}
                    <td scope="col"> <strong>{{Farmer.date_of_birth}}</strong></td>
                    {{/if}}

                    {{#if SeedTrader}}
                    <td scope="col"> <strong>{{SeedTrader.age}}</strong></td>
                    {{/if}}

                    {{#if SeedCompany}}
                    <td scope="col"> <strong></strong></td>
                    {{/if}}

                    <td scope="col"> <strong></strong></td>
                    <td scope="col"> </td>
                    <td scope="col"> </td>
                </tr>
                  {{/each}}
            </tbody>
        </table>
    </div>
</div>
</form>