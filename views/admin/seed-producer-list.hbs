<div class="bg-primary">
    {{>breadcrumbs}}
</div>
<div class="float-end">
    <button class="btn upload-btn mt-2" type="button" data-bs-toggle="modal" data-bs-target="#UploadModal"
        id="getSeedCompanies">
        Upload Seed Producer
    </button>
</div>
<div class="product-mgt-container">
    <div class="d-flex flex-row container mt-2">
        <div class="tab-btn active" data-id="all">ALL</div>
        <div class="tab-btn" data-id="active">ACTIVE</div>
        <div class="tab-btn" data-id="deactivated">DEACTIVATED</div>
        <div class="tab-btn" data-id="independent-seed-producers" id="independent">INDEPENDENT SEED PRODUCERS</div>
    </div>
    <div>

        <!-- single item -->
        <div class="content active" id="all">
            <div class=" container table-responsives table_t_info card p-3">
                <div id="msg"></div>
                <table class="table con t_info  table-borderless" id="seedProducers">
                    <thead class="t_info_head ">
                        <tr class="row-height">
                            <th scope="col">S/N</th>
                            <th scope="col">Name</th>
                            <th scope="col">Number of seeds produced</th>
                            <th scope="col">Seed Company</th>
                            <th scope="col">Location</th>
                            <th scope="col">Date Created</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each seedProducer}}
                        <tr class="t_info_row1">
                            <td>{{increment @index}}</td>
                            <td> {{this.full_name}}</td>
                            <td> {{this.SeedProducerSeeds.length}}</td>
                            <td>{{User.SeedCompany.name_of_company}}</td>
                            <td>{{LGA.name}}, {{State.name}}</td>
                            <td>{{dateFormat created_at "DD/MM/YYYY"}}</td>
                            <td><a href="#">
                                    <div class="dropdown d_t">
                                        <a class="btn   dropdown-toggle action_btn" href="#" role="button"
                                            id="dropdownMenuLink" data-bs-toggle="dropdown" aria-expanded="false">
                                            Actions
                                        </a>

                                        <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                                            <li><a class="dropdown-item border-0 border-bottom"
                                                    href="/admin/seed-producer/{{id}}">View</a></li>
                                            <li><a class="dropdown-item border-0 border-bottom update-seed-producer-status-btn"
                                                    href="#" id-data="{{user_id}}" seed-producer-data="{{id}}"
                                                    id="update-seed-producer-status-btn"
                                                    current-status-data="{{status}}">
                                                    Deactivate
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </a></td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
        <!-- end of single item -->

        <!-- single item -->
        <div class="content" id="active">
            <div class=" container table-responsive table_t_info card p-3">
                <table class="table con t_info  table-borderless " id="seedProducers-active">
                    <thead class="t_info_head ">
                        <tr class="row-height">
                            <th scope="col">S/N</th>
                            <th scope="col">Name</th>
                            <th scope="col">Number of seeds produced</th>
                            <th scope="col">Seed Company</th>
                            <th scope="col">Location</th>
                            <th scope="col">Date Created</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each seedProducer}}
                        {{#if (eq status 1)}}
                        <tr class="t_info_row1">
                            <td>{{increment @index}}</td>
                            <td> {{this.full_name}}</td>
                            <td> {{this.SeedProducerSeeds.length}}</td>
                            <td>{{User.SeedCompany.name_of_company}}</td>
                            <td>{{LGA.name}}, {{State.name}}</td>
                            <td>{{dateFormat created_at "DD/MM/YYYY"}}</td>
                            <td><a href="#">
                                    <div class="dropdown d_t">
                                        <a class="btn   dropdown-toggle action_btn" href="#" role="button"
                                            id="dropdownMenuLink" data-bs-toggle="dropdown" aria-expanded="false">
                                            Actions
                                        </a>

                                        <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                                            <li><a class="dropdown-item border-0 border-bottom"
                                                    href="/admin/seed-producer/{{id}}">View</a></li>
                                            <li><a class="dropdown-item border-0 border-bottom update-seed-producer-status-btn"
                                                    href="#" id-data="{{user_id}}" seed-producer-data="{{id}}"
                                                    id="update-seed-producer-status-btn"
                                                    current-status-data="{{status}}">
                                                    Deactivate
                                                </a>
                                            </li>

                                        </ul>
                                    </div>
                                </a></td>
                        </tr>
                        {{/if}}
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <!-- end of single item -->

    <!-- single item -->
    <div class="content" id="deactivated">
        <div class=" container table-responsives table_t_info card p-3">
            <table class="table con t_info  table-borderless" id="seedProducers-inactive">
                <thead class="t_info_head ">
                    <tr class="row-height">
                        <th scope="col">S/N</th>
                        <th scope="col">Name</th>
                        <th scope="col">Number of seeds produced</th>
                        <th scope="col">Seed Company</th>
                        <th scope="col">Location</th>
                        <th scope="col">Date Created</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each seedProducer}}
                    {{#if (ne status 1)}}
                    <tr class="t_info_row1">
                        <td>{{increment @index}}</td>
                        <td> {{this.full_name}}</td>
                        <td> {{this.SeedProducerSeeds.length}}</td>
                        <td>{{User.SeedCompany.name_of_company}}</td>
                        <td>{{LGA.name}}, {{State.name}}</td>
                        <td>{{dateFormat created_at "DD/MM/YYYY"}}</td>
                        <td><a href="#">
                                <div class="dropdown d_t">
                                    <a class="btn   dropdown-toggle action_btn" href="#" role="button"
                                        id="dropdownMenuLink" data-bs-toggle="dropdown" aria-expanded="false">
                                        Actions
                                    </a>

                                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                                        <li><a class="dropdown-item border-0 border-bottom"
                                                href="/admin/seed-producer/{{id}}">View</a></li>

                                        <li><a class="dropdown-item border-0 border-bottom update-seed-producer-status-btn"
                                                href="#" id-data="{{user_id}}" seed-producer-data="{{id}}"
                                                id="update-seed-producer-status-btn" current-status-data="{{status}}">
                                                Deactivate
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </a></td>
                    </tr>
                    {{/if}}
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
    <!--independent seed producers ** START ** -->
    <div class="content" id="independent-seed-producers">
        <div class=" container table-responsives table_t_info card p-3">
            <table class="table con t_info  table-borderless" id="seedProducers-inactive">
                <thead class="t_info_head ">
                    <tr class="row-height">
                        <th scope="col">S/N</th>
                        <th scope="col">Name</th>
                        <th scope="col">Number of seeds produced</th>
                        <th scope="col">Location</th>
                        <th scope="col">Date Created</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each independentSeedProducers}}
                    {{#if (eq status 1)}}
                    <tr class="t_info_row1">
                        <td>{{increment @index}}</td>
                        <td> {{this.full_name}}</td>
                        <td> {{this.NoSeedCompanyseedProducerSeeds.length}}</td>
                        <td>{{LGA.name}}, {{State.name}}</td>
                        <td>{{dateFormat created_at "DD/MM/YYYY"}}</td>
                        <td><a href="#">
                                <div class="dropdown d_t">
                                    <a class="btn   dropdown-toggle action_btn" href="#" role="button"
                                        id="dropdownMenuLink" data-bs-toggle="dropdown" aria-expanded="false">
                                        Actions
                                    </a>

                                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                                        <li><a class="dropdown-item border-0 border-bottom"
                                                href="/admin/seed-producer/{{id}}?type=independent">View</a></li>

                                        <li><a class="dropdown-item border-0 border-bottom update-seed-producer-status-btn"
                                                href="#" id-data="{{user_id}}" seed-producer-data="{{id}}"
                                                id="independent-seed-producer-status-btn"
                                                current-status-data="{{status}}">
                                                Deactivate
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </a></td>
                    </tr>
                    {{/if}}
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
    <!--independent seed producers ** END ** -->

</div>
<!-- end of single item -->
</div>


<!-- Modal -->
<div class="modal fade" id="UploadModal" tabindex="-1" aria-labelledby="UploadModalLabel" aria-hidden="true">
    <div class="modal-dialog dialog">
        <div class="modal-content content">
            <div class="modal-body vasadModal">
                <h4>Upload Seed Producer List</h4>
                <div class="card txn-modal-content">
                    <div id="upload-msg"></div>
                    <div class="labels">
                        <h5>Without seed company: <input type="checkbox" class="form-check-input" name="noSeedCompany"
                                id="noSeedCompany" style="cursor: pointer;"></h5>
                    </div>
                    <hr />
                    {{!-- <div class="col-sm-1 flex justify-items-center shadow bg-light border rounded">
                        <input type="checkbox" class="form-check-input" name="noSeedCompany" id="noSeedCompany"
                            style="cursor: pointer;">
                    </div> --}}
                    <p></p>
                    <div class="labels" id="searchLabel">
                        <h5>Search for Seed Company</h5>
                    </div>
                    <div class="col form-group">
                        <input type="text" class="form-control" name="keyword" id="keyword"
                            placeholder="Enter search keyword..">
                    </div>
                    <div class="col">
                        <div class="col" id="selectedResult">
                            <!-- selected result is appended here -->
                        </div>
                    </div>
                    <p></p>
                    <div class="col">
                        <div class="col" id="searchResult">
                            <!-- search result is displayed here -->
                        </div>
                    </div>

                    <p></p>
                    <div class="labels">
                        <h5>Upload File</h5>
                    </div>
                    <form id="uploadSeedProducerListForm" method="POST" enctype="multipart/form-data">
                        <div class="col form-group">
                            <input type="file" class="form-control" name="producerList" id="producerList">
                            <input type="hidden" class="form-control" name="seed_company_id" id="seed_company_id">
                        </div>
                </div>
            </div>
            <div class="modal-footer" style="display: flex; justify-content: space-between; ">
                <div>
                    <img src="../../images/spin-wheel.gif" alt="spin wheel"
                        style="visibility: hidden; width: 30px; height: 30px;" id="loader">
                </div>
                <div>
                    <button type="submit" class="btn btn-danger" data-bs-dismiss="modal"
                        id="cancelUpload">Cancel</button>
                    <button type="submit" class="btn btn-txn fund_btn" id="uploadSeedProducerListBtn">Upload</button>
                </div>
            </div>
            </form>
        </div>
    </div>
</div>



<script>
    const about = document.querySelector(".product-mgt-container");
    const btns = document.querySelectorAll(".tab-btn");
    const tables = document.querySelectorAll(".content");
    about.addEventListener("click", function (e) {
        const id = e.target.dataset.id;
        if (id) {
            // remove selected from other buttons
            btns.forEach(function (btn) {
                btn.classList.remove("active");
            });
            e.target.classList.add("active");
            // hide other tables
            tables.forEach(function (table) {
                table.classList.remove("active");
            });
            const element = document.getElementById(id);
            element.classList.add("active");
        }
    });

    $(document).ready(function () {
        $('#seedProducers').DataTable({
        });
        $('#seedProducers-active').DataTable({
        });
        $('#seedProducers-inactive').DataTable({
        });



        /*
                Binary SOL
            */

        function getCurrentStatus() {
            const statusElements = document.querySelectorAll('.update-seed-producer-status-btn');
            statusElements.forEach((status) => {
                const currentStatus = parseInt(status.getAttribute('current-status-data'));
                if (currentStatus === 2) {
                    status.textContent = "Activate";
                } else {
                    status.textContent = "Deactivate";
                }
            });
        }

        getCurrentStatus();


        function hideSearchField() {
            const searchLabel = document.getElementById('searchLabel');
            const searchField = document.getElementById('keyword');
            searchLabel.style.display = 'none';
            searchField.style.display = 'none';
        }

        function showSearchField() {
            const searchLabel = document.getElementById('searchLabel');
            const searchField = document.getElementById('keyword');
            searchLabel.style.display = 'block';
            searchField.style.display = 'block';
        }

        $("#noSeedCompany").on("change", function () {
            if (this.checked) {
                hideSearchField();
            } else {
                showSearchField();
            }
        });

        $("#independent").on("click", function () {
            hideDeactivationBtn()
        })

        // Hide seed producer deactivation button
        const hideDeactivationBtn = () => {
            document.getElementById('independent-seed-producer-status-btn').style.display = 'none';
        }


        $(".update-seed-producer-status-btn").click((event) => {
            const seedCompany = event.target;
            const userId = seedCompany.getAttribute("id-data");
            const seedProducerId = seedCompany.getAttribute("seed-producer-data");
            const currentStatus = seedCompany.getAttribute("current-status-data");

            var url = window.location.origin + `/admin/update-seed-producer-staus/${userId}/${seedProducerId}`;

            fetch(url, {
                method: "PATCH"
            })
                .then((res) => res.json())
                .then((res) => {
                    const data = res;

                    if (data.success == true) {
                        document.getElementById('msg').innerHTML = `
                        <div class='alert alert-success alert-dismissible fade show' role='alert'>
                            ${data.msg}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>`;
                        if (data.state === 2) {
                            seedCompany.textContent = 'Activate';
                        }
                        else {
                            seedCompany.textContent = 'Deactivate';
                        }
                        return;
                    } else {
                        document.getElementById('msg').innerHTML = `
                        <div class='alert alert-warning alert-dismissible fade show' role='alert'>
                            ${data.msg}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>`;
                    }

                })
                .catch((e) => console.log(e));

        });


        $("#keyword").on("keyup", function () {
            // Search for seed companys
            var value = $(this).val();
            var url = window.location.origin + `/admin/get-seed-companies/seed-producer-upload/${value}`;

            if (value !== "") {
                fetch(url, {
                    method: "GET"
                })
                    .then((res) => res.json())
                    .then((res) => {
                        const data = res;
                        if (typeof data == "object" && data.length > 0) {
                            console.log(data);
                            // Clear previous results
                            $("#searchResult").empty();

                            document.getElementById("searchResult").style.display = "block";
                            document.getElementById("searchResult").style.height = "200px";
                            document.getElementById("searchResult").style.overflowY = "scroll";
                            document.getElementById("searchResult").style.overflowX = "hidden";

                            data.forEach((data) => {
                                $("#searchResult").append(`
                            <div class="col form-group search-result-item">
                                <div class="row shadow p-2 mt-2 mb-3 bg-body rounded" style="margin-left: 10px !important; margin-right: 10px !important; font-size: 12px !important;">
                                    <div class="col-md-1">
                                        <i class="bi bi-building fa-2x text-success"></i>
                                    </div>
                                    <div class="col mt-3" style="margin-left: 20px;">
                                        <span class="seed_company_name">${data['name_of_company']}</span>
                                        <input type="hidden" name="seed_company_id" class="seed_company_id" value="${data['user_id']}">
                                    </div>
                                    <div class="col" style="margin-left: 50px; font-size: 12px !important;">
                                        <span class="btn btn-xs btn-light text-success btn-rounded selectBtn">
                                            <i class="fas fa-check-circle"></i> select
                                        </span>
                                    </div>
                                </div>
                            </div>
                        `);
                            });

                            $(".selectBtn").on("click", function () {
                                var selectedCompany = $(this).closest(".search-result-item").find(".seed_company_name").text();
                                var selectedCompanyId = $(this).closest(".search-result-item").find(".seed_company_id").val();

                                // Set values of selected company to input fields in form

                                $("#seed_company_id").val(selectedCompanyId);

                                $("#selectedResult").empty().append(`
                            <div class="col form-group">
                                <div class="row shadow p-2 mt-2 mb-3 bg-body rounded" style="margin-left: 10px !important; margin-right: 10px !important; font-size: 12px !important;">
                                    <div class="col-md-1">
                                        <i class="bi bi-building fa-2x text-success"></i>
                                    </div>
                                    <div class="col mt-3" style="margin-left: 20px;">
                                        <span class="seed_company_name">${selectedCompany}</span>
                                        <input type="hidden" name="selected_seed_company_id" id="selected_seed_company_id" value="${selectedCompanyId}">
                                    </div>
                                    <div class="col-md-1">
                                        <i class="bi bi-check-circle fa-2x text-success"></i>
                                    </div>
                                </div>
                            </div>
                        `);
                                document.getElementById("searchResult").style.height = "0px";
                                $("#keyword").val('');
                                $("#searchResult").empty();
                            });

                        } else {
                            document.getElementById("searchResult").style.height = "50px";
                            $("#searchResult").html(`<h5 class="text-center"><i class="bi bi-exclamation-circle text-danger"></i> No results found</h5>`);
                        }
                    }).catch((e) => console.log(e));
            } else {
                $("#searchResult").empty();
            }
        });

        $("#cancelUpload").on("click", function (e) {
            e.preventDefault();
            document.getElementById("searchResult").style.height = "0px";
            $("#keyword").val('');
            $("#searchResult").empty();
            $("#selectedResult").empty();
            $("#upload-msg").empty();
            $("#producerList").val(null);
        })

        $(document).ready(function () {
            // Event listener for form submission
            $('#uploadSeedProducerListForm').on("submit", async function (e) {
                e.preventDefault();

                // Show preloader
                $('#loader').css('visibility', 'visible');
                $("#uploadSeedProducerListBtn").val("Uploading...");


                let formData = new FormData();

                const files = $('#producerList')[0].files;
                const seed_company_id = $('#seed_company_id').val();
                const noSeedCompany = $('#noSeedCompany').is(':checked');

                if (!noSeedCompany) {
                    /* This will validate search field if no seed company is 
                    selected and without seed company is not checked
                    */
                    if (!seed_company_id) {
                        $('#upload-msg').html(`<div class='alert alert-warning alert-dismissible fade show' role='alert'>
                Please select a seed company
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>`);
                        hidePreloader();
                        return;
                    }
                }

                if (files.length === 0) {
                    $('#upload-msg').html(`<div class='alert alert-warning alert-dismissible fade show' role='alert'>
                Please select a file
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>`);
                    hidePreloader();
                    return;
                }

                formData.append('file', files[0]);
                formData.append('seed_company_id', seed_company_id);

                const url = window.location.origin + `/admin/upload-seed-producer-list`;

                try {
                    const response = await fetch(url, {
                        method: "POST",
                        body: formData
                    });

                    if (!response.ok) {
                        throw new Error('Network response was not ok.');
                    }

                    const data = await response.json();

                    if (data.success === true) {
                        $('#uploadSeedProducerListBtn').val("Upload");
                        $('#upload-msg').html(`<div class='alert alert-success alert-dismissible fade show' role='alert'>
                    ${data.msg}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>`);
                        $("#searchResult").empty();
                        $("#selectedResult").empty();
                        $("#producerList").val(null);
                    } else {
                        $('#upload-msg').html(`<div class='alert alert-warning alert-dismissible fade show' role='alert'>
                    ${data.msg}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>`);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    $('#upload-msg').html(`<div class='alert alert-danger alert-dismissible fade show' role='alert'>
                Error occurred while uploading.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>`);
                } finally {
                    hidePreloader();
                }
            });

            function hidePreloader() {
                // Hide preloader
                $('#loader').css('visibility', 'hidden');
            }
        });


        /*
            Binary EOL
        */






    });
</script>