						<div class="balance-grid">
							<div>
								<h5>Total Wallet Balance</h5>
								{{#balance}}
								<h3>&#8358; {{number this.amount}}</h3>

							</div>

							<div class="cleared-balance">
								<h6>Cleared Balance</h6>
								<h4>&#8358; 0</h4>
							</div>

							<div class="uncleared-balance">
								<h6>Uncleared Balance</h6>
								<h4>&#8358; {{number this.amount}}</h4>
							</div>
						</div>
						{{/balance}}
