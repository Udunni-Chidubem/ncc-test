											<th scope="row"><a href="#">{{this.TransactionLog.transaction_id}}</a></th>
											<td>{{this.TransactionLog.amount}}</td>
											<td><span class=" "> <span class="pending px-1"><i class="bi bi-dot"></i>
														{{this.TransactionLog.status}}</span> </td>

										</tr>
										{{/each}}
									</tbody>
								</table>
							</div>
						</div>

