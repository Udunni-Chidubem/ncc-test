										<div class="modal-content">
											<div class="modal-header">
												<button type="button" class="btn-close" data-bs-dismiss="modal"
													aria-label="Close"></button>
											</div>
											<div class="modal-body">
												<div class=" pt-2">
													<span
														class="{{#if (eq this.status 1)}} published_product {{else if (eq this.status 2)}} revoked {{else}} pending_product {{/if}} px-1 text-small">
														{{#if (eq this.status 1)}} Published {{else}} Pending {{/if}}
													</span>
												</div>
												<div class="card-body m-0 admin-user-product">
													<div class="">
														<div class="admin-user-name_varaint">
															<div>
																<h4>Product Name</h4>
																<h5>{{this.product_name}}</h5>
															</div>
															<div>
																<h4>Variety</h4>
																<h5>{{this.variant}}</h5>
															</div>
														</div>
														<hr class="admin-product-line">
														<div class="admin-view-prod-desc">
															<h4>Product Description</h4>
															<p>{{this.description}}</p>
														</div>
														<hr class="admin-product-line">

														<hr class="admin-product-line">
														<div>
															<div class="inp_cont" id="inp_cont">
																<div class="">
																	<div class="row admin-product-row">
																		<div class="col col_sma ">
																			<div class="   ">
																				<h4>Package Size <i>(kg)</i> </h4>
																			</div>
																		</div>
																		<div class="col col_sma">
																			<div class=" ">
																				<h4>Quantity </h4>
																			</div>
																		</div>
																		<div class="col col_sma">
																			<div class=" ">
																				<h4>Min Stock </h4>
																			</div>
																		</div>
																		<div class="col col_sma">
																			<div class=" ">
																				<h4>Unit Price </h4>
																			</div>
																		</div>
																	</div>
																	<div class="row  admin-product-row">
																		{{#json this.item}}
																		<div class="col col_sma">
																			{{#each pkg}}
																			<div class="py-1 ">
																				<h5>{{this}} </h5>
																			</div>
																			{{/each}}
																		</div>
																		<div class="col col_sma">
																			{{#each quantity}}
																			<div class="py-1 ">
																				<h5>{{this}} </h5>
																			</div>
																			{{/each}}
																		</div>
																		<div class="col col_sma">
																			{{#each min}}
																			<div class="py-1 ">
																				<h5>{{this}} </h5>
																			</div>
																			{{/each}}
																		</div>
																		<div class="col col_sma">
																			{{#each price}}
																			<div class="py-1 ">
																				<h5> &#8358; {{this}} </h5>
																			</div>
																			{{/each}}
																		</div>
																		{{/json}}
																		<div class="col col_sma">

																		</div>
																	</div>
																</div>
															</div>
															<hr class="admin-product-line">


														</div>
													</div>
													</div>
											</div>
										</div>
									</div>
						</div>
								
								{{/each}}
							</tbody>
						</table>

					</div>
