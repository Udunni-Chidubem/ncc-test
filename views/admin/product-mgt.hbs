 {{>breadcrumbs}}
  <div class="product-mgt-container">
        <div class="d-flex flex-row container mt-5">
            <div class="tab-btn active" data-id="all">ALL</div>
            <div class="tab-btn" data-id="approved">APPROVED</div>
            <div class="tab-btn" data-id="rejected">REJECTED</div>
        </div>
        <div>
    
            <!-- single item -->
            <div class="content active" id="all">
                <div class=" container table-responsives table_t_info">   
                    <table class="table con t_info  table-borderless" id="product-table-all">
                      <thead class="t_info_head ">
                        <tr class="row-height">
                            <th scope="col">UPLOAD DATE</th>
                            <th scope="col">PRODUCT NAME/VARIANT</th>
                            <th scope="col">COMPANY NAME</th>
                            <th scope="col">PRICE</th>
                            <th scope="col">STATUS</th>
                            <th scope="col">
                                <button class="btn  download-btn ">Download Report</button>
                            </th>
                        </tr>
                      </thead>
                      <tbody>
                        {{#each products}}
                          <tr class="row-one row-height">
                            <td scope="col">{{dateFormat this.created_at "dddd, MMMM Do YYYY"}}</td>
                            <td scope="col"><strong>{{this.product_name}}/{{this.variant}}</strong></td>
                            <td scope="col"> <strong>{{this.User.SeedCompany.name_of_company}}</strong></td>
                            <td scope="col"> <strong>1OOO</strong></td>
                            <td scope="col">
                              {{#equals this.status 1}}
                                <span class="published">Published</span>
                              {{/equals}}
                              {{#equals this.status 0}}
                                <span class="unpublished">Unpublished</span>
                              {{/equals}}
                            </td>
                            <td scope="col"><a href="/admin/view-product">Details</a></td>
                          </tr>
