{{>breadcrumbs}}

{{#if product}}
	<div class="card admin-product container ">
        <div class="card-body m-0 admin-view-product">
        	<div class="admin-product-img admin-product-img-min-hidden">
				<img src="../../product_images/{{product.file_name}}" alt="Product Image">
			</div>
			<div class="">
				<div class="admin-name_varaint">
					<div>
						<h4>Product Name</h4>
						<h5>{{product.product_name}}</h5>
					</div>
					<div>
						<h4>Variant</h4>
						<h5>{{product.variant}}</h5>
					</div>
				</div>
                <hr class="admin-product-line">
				<div class="admin-view-prod-desc">
					<h4>Product Description</h4>
					<p>{{product.description}}</p>
				</div>
				<hr class="admin-product-line">

				<div>
					<h4>Seller</h4>
					<h5>Musa Ibrahim</h5>
				</div>

				<hr class="admin-product-line">
				<div>
					<div class="inp_cont" id="inp_cont">
                    <div class="">
                        <div class="row admin-product-row">
                            <div class="col col_sma ">
                                <div class="   ">
                                    <h4 >Package Size <i>(kg)</i>  </h4>
                                </div>
                            </div>
                            <div class="col col_sma">
                                <div class=" ">
                                    <h4 >Quantity </h4>
                                </div>
                            </div>
                            <div class="col col_sma">
                                <div class=" ">
                                    <h4 >Min Stock </h4>
                                </div>
                            </div>
                            <div class="col col_sma">
                                <div class=" ">
                                    <h4 >Unit Price </h4>
                                </div>
                            </div>
                        </div>
                        <div class="row  admin-product-row"  >
                            <div class="col col_sma"> 
                            {{#json product.item}}
                                    {{#each this.pkg}} 
                                <div class="py-1 ">
                                       <h5>{{this}} </h5>
                                </div>
                                {{/each}}
                            </div>
                            <div class="col col_sma">   
                                    {{#each this.quantity}}
                                <div class="py-1 "> 
                                    <h5>{{this}} </h5>
                                </div>
                                {{/each}}
                            </div>
                            <div class="col col_sma">
                                    {{#each this.min}}
                                <div class="py-1 ">
                                    <h5>{{this}} </h5>
                                </div>
                                {{/each}}
                            </div>
                            <div class="col col_sma">
                                    {{#each this.price}}
                                <div class="py-1 ">
                                    <h5> &#8358; {{this}} </h5>
                                </div>
                                {{/each}}
                                    {{/json}}
                            </div>
                            <div class="col col_sma">    
                                <div class="p-0  sc-availbility-check">
                                    <span class="{{#if this.status}} approved {{else}} pending {{/if}} px-1 text-small"><i class="bi bi-dot"></i>
                                      {{#if this.status}} Published {{else}} Pending {{/if}}
                                    </span> 
                                </div>
                            </div>
                        </div>
                     </div>
                </div> 
                				<hr class="admin-product-line">

					
				</div>
			</div>
			<div class="admin-product-img admin-product-img-hidden">
				<img src="../../product_images/{{product.file_name}}" alt="Product Image">
			</div>
		</div>
			<div class="float-end">
            <div class="float-end m-2 mb-3">
                <button type="button" class="btn btn-theme float-right submitBtn" data-bs-toggle="modal" data-bs-target="#reject"><i class="fa fa-close"></i> Reject</button>                    
            </div>

            <div class="float-end m-2 mb-3">
                <button type="button" class="btn btn-theme float-right submitBtn" onclick="window.location.href='#'"><i class="fa fa-check"></i> Approve</button>                    
            </div>
	</div>

<div class="modal fade" id="reject" tabindex="-1" aria-labelledby="rejectLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
      	<form action="product_rejection_submit" method="get" accept-charset="utf-8">
      		<textarea name="rejectionReason" rows="4" placeholder="Reason for rejection" class="form-control"></textarea>
      		<br>
        	<button type="button" class="btn btn-theme float-end">Submit</button>
        </form>
      </div>

    </div>
  </div>
</div>
{{/if}}