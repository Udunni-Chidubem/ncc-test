{{#if (ne user_role "rra")}}
{{>user_mgt_sidebar}}
{{/if}}
{{>breadcrumbs}}

<div id="page-content-wrapper">
	<div class="card users_card">
		<div class="card-body">
			<ul class="nav nav-tabs" id="myTab" role="tablist">
				<li class="nav-item" role="presentation">
					<button class="nav-link active" id="farmers-tab" data-bs-toggle="tab" data-bs-target="#farmers"
						type="button" role="tab" aria-controls="farmers" aria-selected="true">FARMERS</button>
				</li>
				<li class="nav-item" role="presentation">
					<button class="nav-link" id="seed-company-tab" data-bs-toggle="tab" data-bs-target="#seed-company"
						type="button" role="tab" aria-controls="seed-company" aria-selected="false">SEED
						COMPANY</button>
				</li>
				<li class="nav-item" role="presentation">
					<button class="nav-link" id="seed-traders-tab" data-bs-toggle="tab" data-bs-target="#seed-traders"
						type="button" role="tab" aria-controls="seed-traders" aria-selected="false">SEED TRADER</button>
				</li>
				{{!-- <li class="nav-item" role="presentation">
					<button class="nav-link" id="nasc-tab" data-bs-toggle="tab" data-bs-target="#nasc" type="button"
						role="tab" aria-controls="nasc" aria-selected="false">NASC ADMIN</button>
				</li>
				<li class="nav-item" role="presentation">
					<button class="nav-link" id="others-tab" data-bs-toggle="tab" data-bs-target="#others" type="button"
						role="tab" aria-controls="others" aria-selected="false">RRA ADMIN</button>
				</li> --}}
			</ul>
			<div class="tab-content" id="myTabContent">
				<div class="tab-pane fade show active card p-2" id="farmers" role="tabpanel" aria-labelledby="farmers-tab">
					<table class="table table-theme  table-responsive table-hover " id="farmers-table">
						<thead>
							<tr>
								<th>S/N</th>
								<th>Reg. Date</th>
								<th>Name</th>
								<th>Location</th>
								<th></th>
							</tr>
						</thead>

						<tbody>
							{{#each farmers}}
								
									<tr class="table-theme-secondary">
										<th>{{increment @index}}</th>
										<td colspan="" rowspan="" headers="">{{dateFormat this.createdAt "dddd, MMMM Do YYYY"}}
										</td>
										<td colspan="" rowspan="" headers="">{{this.firstname}} {{this.lastname}}</td>
										<td colspan="" rowspan="" headers="" class="text-uppercase">{{this.LGA.name}} ,
											{{this.State.name}}</td>
										<td colspan="" rowspan="" headers="">
											<a class="" href="/admin/users/{{this.user_id}}?type=farmer">
												<i class="fa fa-eye"></i> View
											</a>
										</td>
									</tr>
							{{/each}}
						</tbody>

					</table>
				</div>
				<div class="tab-pane fade card p-2" id="seed-company" role="tabpanel" aria-labelledby="seed-company-tab">
					<table class="table table-theme  table-responsive table-hover" id="seed-company-table">
						<thead>
							<tr>
								<th>S/N</th>
								<th>Reg. Date</th>
								<th>Name</th>
								<th>Location</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							{{#each companies}}
								{{#if (ne this.User.status 2)}}
								<tr class="table-theme-secondary">
									<th>{{increment @index}}</th>
									<td colspan="" rowspan="" headers="">{{dateFormat this.created_at "dddd, MMMM Do YYYY"}}
									</td>
									<td colspan="" rowspan="" headers="">{{this.name_of_company}}</td>
									<td colspan="" rowspan="" headers="" class="text-uppercase">{{this.LGA.name}} ,
										{{this.State.name}}</td>
									<td colspan="" rowspan="" headers="">
										<a class="" href="/admin/users/{{this.user_id}}?type=company">
											<i class="fa fa-eye"></i> View
										</a>
									</td>
								</tr>
								{{/if}}
							{{/each}}
						</tbody>
					</table>
				</div>
				<div class="tab-pane fade card p-2" id="seed-traders" role="tabpanel" aria-labelledby="seed-traders-tab">
					<table class="table table-theme  table-responsive table-hover" id="seed-trader-table">
						<thead>
							<tr>
								<th>S/N</th>
								<th>Reg. Date</th>
								<th>Name</th>
								<th>Phone No.</th>
								<th>Location</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							{{#each traders}}
							<tr class="table-theme-secondary">
								<th>{{increment @index}}</th>
								<td colspan="" rowspan="" headers="">{{dateFormat this.createdAt "dddd, MMMM Do YYYY"}}
								</td>
								<td colspan="" rowspan="" headers="">{{this.firstname}} {{this.lastname}}</td>
								<td colspan="" rowspan="" headers="">{{this.phone_no}}</td>
								<td colspan="" rowspan="" headers="" class="text-uppercase">{{this.LGA.name}} ,
									{{this.State.name}}</td>
								<td colspan="" rowspan="" headers="">
									<a class="" href="/admin/users/{{this.user_id}}?type=trader">
										<i class="fa fa-eye"></i> View
									</a>
								</td>
							</tr>
							{{/each}}
						</tbody>
					</table>
