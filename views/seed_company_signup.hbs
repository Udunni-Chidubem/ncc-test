                                        value="{{ formData.phone }}"
                                        placeholder="Phone Number e.g 0*******" 
                                        pattern="^0[0-9]{10}$"
                                        title="Phone Number should start with 0 and contain 11digits"
                                        minlength="11"
                                        maxlength="11">
                                
                                </div>
                                
                            </div>
                             
                        </div>

