<div class="container">
    <div class="row _settings">
        <div class="col-3">
            <ul class="list-group">
                <li class="list-group-item active tab_info_" id="password" aria-current="true" onclick="tab(this)">
                     Password and Security <span class='bx bx-shield-quarter text-green icon-font-20'></span>
                </li>
                <li class="list-group-item  tab_info_" id="account" onclick="tab(this)">
                    Deactivate Account <span class='bx bx-block text-red icon-font-20'></span>
                </li>
            </ul>
        </div>


        <div class="col-9">

            {{#if password_change_status}}
            <div class="row d-flex justify-content-center">
                <div class="col-12 alert alert-success">
                    {{password_change_status}}
                </div>
            </div>
            {{/if}}
            {{#if messages.error}}
            <div class="row d-flex justify-content-center">
                <div class="col-12 alert alert-danger">
                    {{messages.error}}
                </div>
            </div>
            {{/if}}
            {{#if message_}}
            <div class="row d-flex justify-content-center">
                <div class="col-12 alert alert-danger">
                    {{message_}}
                </div>
            </div>
            {{/if}}
            {{#if errors.length}}
            <div class="row d-flex justify-content-center">
                <div class="col-12 alert alert-danger">
                    <ul>
                        {{#each errors}}
                        <li>{{this.message}}</li>
                        {{/each}}
                    </ul>
                </div>
            </div>
            {{/if}}

            {{#if extractedErrors}}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <ul style="padding: 5px;">
                    {{#each extractedErrors}}
                    <li>{{msg}}</li>
                    {{/each}}
                </ul>
            </div>
            {{/if}}

            <div class="card settings_  content account">
                <div class="card-body">
                    <h3 class="deactivate-intro">we hate to see you go</h3>
                    <h3 class="deactivate-intro">{{ fullname}}</h3>
                    <div class="m-5">
                    <p class="deactivate-texts mt-2">This is what will happen when you deactivate your account</p>
                    <p class="deactivate-texts mt-2">You will lose access to your dashboard</p>
                    <p class="deactivate-texts mt-2">You cannot search for seeds or purchase seeds on NIGSIMS</p>
                    </div>
                    
                    <div class="d-flex align-items-center justify-content-center m-5">
                        <img src="../../images/deactivate-pic.png">
                    </div>
                    <div class="text-center m-5">
                    <button type="button" onclick="window.location.href=window.location.origin+'/seed-trader/settings/deactivate/{{trader.user_id}}/2'" class="btn btn-danger deactivate-btn"> Click Here To Deactivate Account</button>
                    </div>
                    <div class="d-flex justify-content-end mb-2">
				<button class="btn btn-success" id="withdraw-btn" data-bs-toggle="modal" data-bs-target="#logoutModal"> Withdraw </button>
			</div>
                </div>
            </div>


            <div class="card settings_ active content password">
                <div class="card-body">
                    <div class="input-group mb-3">
                        <input type="password" required minlength="6" id="currentpassword" class="form-control"
                            name="currentpassword" placeholder="Current Password" aria-label="Current Password"
                            aria-describedby="basic-addon1">
                    </div>
                    <div class="input-group mb-3">
                        <input type="password" minlength="6" class="form-control" id="newpassword" name="newpassword"
                            placeholder="New Password" aria-label="New Password" aria-describedby="basic-addon1"
                            onkeyup='check();'>
                    </div>
                    <div class="input-group mb-3">
                        <input type="password" required minlength="6" class="form-control" id="confirmpassword"
                            name="confirmpassword" placeholder="Retype New Password" aria-label="Confirm Password"
                            aria-describedby="basic-addon1" onkeyup='check();'>
                    </div>
                    <div class="input-group mb-3">
                        <input type="hidden" class="form-control" id="userphoneno" value="{{farmerData.phone_no}}"
                            name="userphoneno" aria-label=" User Phoneno" aria-describedby="basic-addon1">
                    </div>
                    <span id='message'></span>
                    <div class="col-12  ">
                        <div class="columns mx-auto" style="width: 160px;">
                            <button class="btn btn_update_password mb-1" disabled id="btn_update_password">
                                Update</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Logout Modal-->
    <div class="modal fade " id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button class="close" type="button" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                	<form action="wallet_submit" method="get" >
                		<div class="mb-2">
	                		<input type="number"  class="form-control" name="amount" value="" placeholder="Enter Amount to Withdraw">       		
                		</div>
                		<div class="mb-2">
	                		<input type="password"  class="form-control" name="password" value="" placeholder="Password">     		
                		</div>
                	
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success" href="#!">Logout</button>
                </div>
            	</form>
            </div>
        </div>
    </div>
<script>
    //tab toggle
    const btns = document.querySelectorAll(".tab_info_");
    const card = document.querySelectorAll(".content");

    function tab(obj) {
        const id = obj.getAttribute('id');
        //console.log(id)
        if (id) {
            btns.forEach(function (btn) {
                btn.classList.remove("active");
            });
            obj.classList.add("active");
            card.forEach(function (table) {
                table.classList.remove("active");
            });
            const element = document.querySelector('.' + id);
            element.classList.add("active");
        }
    }

    //password retype
    var check = function () {
        if (document.getElementById('newpassword').value ==
            document.getElementById('confirmpassword').value) {
            document.getElementById('message').style.color = 'green';
            document.getElementById('message').innerHTML = 'Password matching';
            document.querySelector('#btn_update_password').removeAttribute('disabled');
            document.querySelector('#btn_update_password').setAttribute('enabled', true);
        } else {
            document.getElementById('message').style.color = 'red';
            document.getElementById('message').innerHTML = 'Password not matching';
            document.querySelector('#btn_update_password').removeAttribute('enabled');
            document.querySelector('#btn_update_password').setAttribute('disabled', true);
        }
    }

    $(document).ready(function(){
   
    $('#logoutModal').on('shown.bs.modal', function () {
  $('#logoutModal').trigger('focus')
})
});

</script>