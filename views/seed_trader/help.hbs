<div class="card chat_card">
    <div class="card-header msg_head text-light">Chat with Admin</div>
    <div class="card-body p-0">
        <div class="con_body_ messages" style="height: 300px; ">
            {{#each getmessages}}
            {{#if (eq this.from_user ../user_id)}}
            <div class="" style="text-align: right;">
                <p class="msg_view_r">
                    {{this.message}}
                </p>
                <br>
                <span class="msg_time_send_r">{{dateFormat this.created_at "HH:mm, dddd" timeStamp}}</span>

            </div>
            {{else}}
            <div class="" style="text-align: left;">
                <p class="msg_view_l">
                    {{this.message}}
                </p>
                <br>
                <span class="msg_time_send_l">{{dateFormat this.created_at "HH:mm, dddd" timeStamp}}</span>

            </div>
            {{/if}}
            {{/each}}
        </div>
    </div>

    <div class="modal-footer msg">
        <input type="hidden" value="{{trader.user_id}}" id="from_user">
        <textarea name="message" id="message" class="form-control" placeholder="How can we help you ? "
            style="height: 70px;"></textarea>
        <button id="send " class="btn send " style="height: 70%;"><i class="bx bx-send"></i></button>
    </div>
</div>
</div>

<script type="text/javascript"
    src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p"
    crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p"
    crossorigin="anonymous"></script>
<script src="../js/script.js"></script>
<script src="../js/payment_page_preview.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap4.min.js"></script>
<script src="../../js/script.js"></script>
<script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
<script>
    $(".con_body_").animate({ scrollTop: $(document).height() }, "fast");
    $(document).ready(function () {

        let base_url = window.location.origin

        function messages_() {
            fetch(base_url + '/seed-trader/messages',)
                .then(r => r.json())
                .then(response => {
                    let data = response.message
                    console.log(data)
                    let userid = response.user_id
                    let content = ''
                    let week_day = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']
                    data.forEach((value, index) => {
                        let raw_date = '"' + data[index].created_at + '"'
                        const date_ = new Date(data[index].created_at)
                        if (data[index].from_user == userid) {
                            content +=
                                ' <div class="" style="text-align: right;"> ' +
                                ' <p class="msg_view_r" >' +
                                data[index].message +
                                ' </p>' +
                                '<br>' +
                                ' <span class="msg_time_send_r"> ' +
                                date_.getHours() + ':' + date_.getMinutes() + ',' + week_day[date_.getDay() - 1] + '</span> ' +

                                ' </div>'
                        }
                        else {
                            content +=
                                ' <div class="" style="text-align: left;">' +
                                '<p class="msg_view_l">' +
                                data[index].message +
                                ' </p>' +
                                '<br>' +
                                ' <span class="msg_time_send_r"> ' +
                                date_.getHours() + ':' + date_.getMinutes() + ',' + week_day[date_.getDay() - 1] + '</span> ' +
                                ' </div>'
                        }
                    })
                    document.querySelector('.con_body_').innerHTML = content
                    console.log(data[0].created_at)
                })
        }

        setInterval(messages_, 1000) //fetch the db to update the cart items without refreshing the page
    })

</script>