 <div class="container ">
    <div class="row">
      <div class="col-12">
        <div class="card card_home pl-0 mb-2 ">
          <div class="card-body">
             <div class="row">
               <div class="col-12">
                 <h4 style="text-transform: capitalize;">Welcome, {{trader.firstname}} {{trader.lastname}}!</h4>
               </div>
               {{#if isVerified}}
               <div class="row">
                 <div class="col-6 profile_sub"><p>Kindly set up your profile to continue using NIGSIMS</p></div>
                 <div class="col-6">
                  <div class="  float-end">
                    <a href="/seed-trader/update-profile" class="btn button_update mb-1 shadow-lg">Update Profile</a>
                  </div>
                 </div>
               </div>
               {{/if}}
             </div>
            </div>
          </div>
      </div>
    </div>
    {{#unless isVerified}}
    <div class="row">
        <div class="col-12">
            <div class="card referal_card_dashboard">
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">Referral Summary</div>
                        <div class="col-6 id">
                            <div class="row">
                                <ul>
                                    <li class="trader_id">Trader ID</li>
                                    <li><span class="code_" id="code_">{{referal_code}}</span> 
                                    <span onclick="CopyToClipboard('code_')">
                                            <i class='bx bx-copy bx-tada'></i></span></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <hr>
                    <div class="row">
                        <div class="col-6">
                            <ul class="earnings">
                                <li class="total">Total Earnings</li>
                                <li class="total_num"> &#8358; 0</li>
                            </ul>
                        </div>
                        <div class="col-6">
                            <ul class="earnings">
                                <li class="total">Total Referrals</li>
                                <li class="total_num">{{traderRefres_len}}</li>
                            </ul>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 text-end refral_card_link">
                            <a href="/seed-trader/referral">View details</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
