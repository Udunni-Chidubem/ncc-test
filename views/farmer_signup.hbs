 <div class="container-fluid pt-3" id="contain">
    <div class="page-wrapper bg-gra-02 font-poppins">
        <div class="wrapper wrapper--w680">
            <div class="card card-4">
                <div class="card-body">
                    <h1 class="title p-b-15" >Create An Account</h1>
                    <div class="div-block-3"></div>
                    <form method="POST" class="p-t-15">
                        <div class="row">
                            <div class="col-md-7 col-sm-12">
                                <div class="form-group"> 
                                    <input class="form-control" type="text" name="first_name" placeholder="Enter your name">
                                </div>
                            </div>
                            <div class="col-md-5 col-sm-12">
                                <div class="form-group">
                                  <select class="form-control" name="gender" id="gender">
                                      <option value="m">Male</option>
                                      <option value="f">Female</option>
                                  </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-5 col-sm-12">
                                <div class="form-group">
                                    <input class="form-control" type="text" name="age" placeholder="Age">
                                    <div class="input-group-icon">
                                    </div>
                                </div> 
                            </div>
                            <div class="col-md-7 col-sm-12">
                                <div class="form-group">
                                    <select name="education" id="education" class="form-control">
                                        <option value="">select Level of Education</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-7 col-sm-12">
                                <div class="form-group">
                                    <input class="form-control" type="email" name="email" placeholder="Enter Your Location">
                                </div>
                            </div>
                            <div class="col-md-5 col-sm-12">
                                <div class="form-group">
                                    <input class="form-control" required type="text" id="phone" name="phone" placeholder="Phone Number">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-5 col-sm-12">
                                <div class="form-group">
                                    <input class="form-control" type="text" name="NIN" placeholder="NIN" style="width: 100%;">
                                </div>
                            </div>
                            <div class="col-md-7 col-sm-12">
                                <div class="form-group">
                                    <input class="form-control" type="text" name="BVN" placeholder="Enter your BVN" style="width: 100%;">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-7 col-sm-12">
                                <div class="form-group">
                                    <input class="form-control" type="tel" name="Accountnumber" placeholder="Enter Your Account Number">
                                </div>
                            </div>
                            <div class="col-md-5 col-sm-12">
                                <div class="form-group">
                                    <input class="form-control" type="text" name="Farm" placeholder="Enter your Farm Produce">
                                </div>
                            </div>
                        </div> 
                           <div class="p-t-15">
                            <center><button class="btn primary-button    w-button  btn--radius-2 btn--green" type="submit">Submit</button></center>
                        </div>

                         <div class="p-t-15">
                            <center><p style="color:#47ba5d;"> Already Have An Account? <a href="/login" class="links">SIgn In</a></p></center>
                             
                        </div>

                        {{!-- <div class="p-t-15">
                            <center><button class="btn btn--radius-2 btn--green" type="button">Submit</button></center>
                        </div> --}}
                        {{!-- <div class="row">
                            <div class="d-flex justify-content-end">
                                <center><p style="color:#47ba5d;"> Already Have An Account? <a href="" class="links">SIgn In</a></p></center>
                            </div>
                        </div> --}}
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

 
   