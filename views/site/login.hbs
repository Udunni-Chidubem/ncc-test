<div class="container-fluid pt-3" id="contain">
    <div class="page-wrapper bg-gra-02 font-poppins">
        <div class="wrapper wrapper--w680">
            <div class="card card-4">
                <div class="card-body">
                    <h5 class="title p-b-17">Login</h5>

                    <form method="POST" class="p-t-17">
                        <div class="row">
                            <div class=" col-lg-12 col-md-7 col-sm-12">
                                <div class="form-group">
                                    <input class="form-control" required type="tel" name="username"
                                        placeholder="Phone no">
                                </div>
                                <div class="form-group">
                                    <input class="form-control password_ " required type="password" name="password"
                                        minlength="6" placeholder="Password">
                                </div>
                                <div class="password_ck">
                                    <input type="checkbox" onclick="password_toggle()" class="ck_ " id="">
                                    Show Password
                                </div>
                            </div>

                        </div>



                        <div class="p-t-17">
                            <center><button class="btn primary-button w-button btn--radius-2 btn--green"
                                    type="submit">Proceed</button></center>
                        </div>

                        <div class="p-t-17">
                            <center><a href="forgot_password" class="links">Forgot password?</a></center>
                            <center>
                                <p style="color:#47ba5d;"> Do Not Have An Account? <a href="/presignup"
                                        class="links">SIgn up</a></p>
                            </center>
                        </div>

                        {{!-- <div class="row">
                            <div class="d-flex justify-content-end">
                                <center>
                                    <p style="color:#47ba5d;"> <a href="/presignup" class="links">Create An Account.</a>
                                    </p>
                                </center>
                            </div>
                        </div> --}}
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    input = document.querySelector('.ck_')
    password = document.querySelector('.password_')
    function password_toggle() {
        if (password.type === 'password') {
            password.type = 'text'
        }
        else {
            password.type = 'password'
        }
    }
</script>
