 <div class="container-fluid pt-3" id="contain">
    <div class="page-wrapper bg-gra-02 font-poppins">
        <div class="wrapper wrapper--w680">
            <div class="card card-4">
                <div class="card-body">
                    <h5 class="title p-b-17">Password Retrieval</h5>
                     
                    <form method="POST" class="p-t-17">
                        <div class="row">
                            <div class=" col-lg-12 col-md-7 col-sm-12">
                                 <input type="hidden" value="{{phone}}" name="phone" id="phone">
                                <div class="form-group"> 
                                    <input class="form-control" required type="password" name="otp" placeholder="OTP">

                                </div>
                            </div>
                            
                        </div>
                              
                         

                        <div class="p-t-17">
                            <center><button class="btn primary-button w-button btn--radius-2 btn--green" type="submit">Proceed</button></center><br>
                            <center><button onclick="window.location.href='/otp-resend/{{phone}}'" class="btn primary-button w-button btn--radius-2 btn--green" type="button">Resend OTP</button></center><br>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
