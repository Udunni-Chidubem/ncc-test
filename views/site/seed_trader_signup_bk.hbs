 <div class="container-fluid pt-3" id="contain">
    <div class="page-wrapper bg-gra-02 font-poppins">
        <div class="wrapper wrapper--w680">
            <div class="card card-4">
                <div class="card-body">
                    <h1 class="title p-b-15">Create An Account</h1>
                     
                    {{!-- <div class="form-col">  --}}
                    <form method="POST" class="p-t-15 col-12" >
                                <div class="form-group"> 
                                    <input class="form-control" type="text" name="firstname" placeholder="First name">
                                </div>
                                <div class="form-group"> 
                                    <input class="form-control" type="text" name="lastname" placeholder="Last name">
                                </div>

                            
                                <div class="form-group">
                                    <input 
                                        class="form-control" 
                                        required 
                                        type="tel" 
                                        id="phone"  
                                        name="phone"
                                        placeholder="Phone e.g 0*******" 
                                        pattern="^0[0-9]{10}$"
                                        title="Phone Number should start with 0 and contain 11digits"
                                        minlength="11"
                                        maxlength="11">
                                
                                </div>

                              <div class="form-group">
                                    <input 
                                        class="form-control" 
                                        required 
                                        type="text" 
                                        id="uniqueId"  
                                        name="Unique Identifier"
                                        placeholder="Unique Id" 
                                        title="Kindly input a unique identifier"
                                        >
                                
                                </div>

                              
                                <div class="form-group">
                                    <input class="form-control" type="password" name="password" placeholder="Enter Your Password">
                                </div>
                                

