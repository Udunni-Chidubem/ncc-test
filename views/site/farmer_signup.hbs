 <div class="container-fluid pt-3" id="contain">
    <div class="page-wrapper bg-gra-02 font-poppins">
        <div class="wrapper wrapper--w680">
            <div class="card card-4">
                <div class="card-body">
                    <h1 class="title p-b-15" >Create An Account</h1>
 
                    <form method="POST" class="p-t-15" id="register">
                        <div class="row">
                            <div class="col-md-10 col-sm-12">
                                <div class="form-group"> 
                                    <input class="form-control" type="text" name="firstname" placeholder="Firstname" value="{{ formData.firstname}}">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-10 col-sm-12">
                                <div class="form-group"> 
                                    <input class="form-control" required type="text" name="lastname" placeholder="Lastname" value="{{ formData.lastname}}">
                                </div>
                            </div>
                        </div>

                         <div class="row">
                            <div class="col-md-10 col-sm-12">
                                <div class="form-group"> 
                                    <div class="form-group"> 
                                    <input 
                                        class="form-control" 
                                        required 
                                        type="text" 
                                        id="phone" 
                                        name="phone_number"
                                        value="{{ formData.phone_number}}"
                                        placeholder="Phone Number e.g 0*******" 
                                        pattern="^0[0-9]{10}$"
                                        title="Phone Number should start with 0 and contain 11digits"
                                        minlength="11"
                                        maxlength="11">
                                </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-10 col-sm-12">
                                <div class="form-group"> 
                                    <input class="form-control" required type="password" minlength="6" name="password"  placeholder="Enter Your Password">
                                </div>
                            </div>    
                            <div class=" col-md-10 col-sm-12">
                                 <div class="form-group">
                                    <input class="form-control" type="password" minlength="6" name="confirm_password" placeholder="Confirm Password">
                                </div>
                                
                            </div>
                        </div>
                          
                        <div class="p-t-16">
                            <center><button class="btn primary-button w-button  btn--radius-2 btn--green" type="submit">Submit</button></center>
                        </div>

                         <div class="p-t-16">
                            <center><p style="color:#47ba5d;"> Already Have An Account? <a href="/login" class="links">Sign In</a></p></center>
                             
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


<script type="text/javascript" src="https://code.jquery.com/jquery-2.1.1.min.js"></script>
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

